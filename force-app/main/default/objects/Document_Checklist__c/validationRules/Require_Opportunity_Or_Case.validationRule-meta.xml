<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Opportunity_Or_Case</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK(Opportunity__c), ISBLANK(Case__c))</errorConditionFormula>
    <errorMessage>A Document Checklist item must be linked to either an Opportunity or a Case (or both).</errorMessage>
</ValidationRule>
