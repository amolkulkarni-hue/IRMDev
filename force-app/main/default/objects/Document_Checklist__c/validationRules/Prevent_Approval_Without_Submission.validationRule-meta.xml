<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Approval_Without_Submission</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;Final&quot;), ISBLANK(Submitted_Date__c), NOT(Bypass_Requirement__c))</errorConditionFormula>
    <errorMessage>Submitted Date must be populated before a document can be marked Final, unless Bypass Requirement is checked.</errorMessage>
</ValidationRule>
