    <fullName>Restrict_ALM_creation</fullName>
    <active>true</active>
    <description>#36823 - Restrict Deal Review ALM creation</description>
    <errorConditionFormula>AND(ISNEW(),Business_Unit__c=&apos;ALM&apos;, Deal_Type_Formula__c=&apos;Renewal&apos;)</errorConditionFormula>
