<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>If the Last Review Date is greater than 90 days, the record needs review.</description>
    <externalId>false</externalId>
    <formula>IF (Last_Review_Date__c  &lt; TODAY()-180, &quot;Needs Review&quot;, &quot;Up-to-date&quot;)</formula>
    <label>Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
