<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MainNavigationItemParentValidation</fullName>
    <active>true</active>
    <errorConditionFormula>RecordType.DeveloperName == &apos;Main_Navigation_Item&apos; &amp;&amp;
Parent_EEC__c != null &amp;&amp;
Parent_EEC__r.RecordType.DeveloperName != &apos;Main_Navigation&apos; &amp;&amp;
Parent_EEC__r.RecordType.DeveloperName != &apos;Main_Navigation_Item&apos;</errorConditionFormula>
    <errorDisplayField>Parent_EEC__c</errorDisplayField>
