<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Accepted_Deals_Cannot_be_Resubmitted</fullName>
    <active>true</active>
    <description>Resubmit button is available on the locked layout for accepted and rejected, resubmits should only be for denies, this enforces that</description>
    <errorConditionFormula>AND(
ISPICKVAL( PRIORVALUE(Appeal_Stage__c) , &quot;Accepted&quot;) ,
ISPICKVAL(Appeal_Stage__c, &quot;Resubmitted&quot;)
)</errorConditionFormula>
    <errorMessage>Accepted dealds cannot be resubmitted.</errorMessage>
</ValidationRule>
