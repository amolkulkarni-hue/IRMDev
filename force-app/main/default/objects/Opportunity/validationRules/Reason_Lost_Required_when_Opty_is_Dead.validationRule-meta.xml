<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reason_Lost_Required_when_Opty_is_Dead</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(StageName,&quot;Dead&quot;),ISPICKVAL( IM_Reason_Lost__c , &quot;&quot;),NOT($Permission.VR_Bypass_Permission))</errorConditionFormula>
    <errorDisplayField>IM_Reason_Lost__c</errorDisplayField>
    <errorMessage>Please fill in a Reason Lost</errorMessage>
</ValidationRule>
