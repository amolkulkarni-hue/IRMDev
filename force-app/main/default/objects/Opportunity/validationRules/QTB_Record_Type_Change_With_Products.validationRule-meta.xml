<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QTB_Record_Type_Change_With_Products</fullName>
    <active>false</active>
    <description>Throw Error message while changing the Record Type of an Opportunity which is having Products</description>
    <errorConditionFormula>AND(
AND(
OR(
$Setup.Metadata_Activation_Settings__c.SObject_API_Name__c = &apos;Opportunity&apos;,
$Setup.Metadata_Activation_Settings__c.SObject_API_Name__c = &apos;&apos;
),
NOT($Setup.Metadata_Activation_Settings__c.Disable_VR__c)),
AND(ISCHANGED(RecordTypeId),IM_Number_of_Opty_Products__c &gt; 0),
NOT($Permission.VR_Bypass_Permission)
)</errorConditionFormula>
    <errorMessage>Can not change the Record Type of an opportunity with Products</errorMessage>
</ValidationRule>
