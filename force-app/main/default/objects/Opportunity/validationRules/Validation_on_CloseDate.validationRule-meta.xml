<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_on_CloseDate</fullName>
    <active>false</active>
    <description
  >Deactivated as part of VR Cleanup project - DO NOT USE</description>
    <errorConditionFormula>AND(
  NOT($Permission.Bypass_Opportunity_Validation),
				 ISCHANGED(CloseDate), 
				CloseDate &lt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>CloseDate</errorDisplayField>
    <errorMessage>Close Date cannot be in the past.</errorMessage>
</ValidationRule>
