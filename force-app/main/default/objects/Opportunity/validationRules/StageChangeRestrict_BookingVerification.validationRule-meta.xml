<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>StageChangeRestrict_BookingVerification</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISCHANGED(StageName),
    ISPICKVAL(PRIORVALUE(StageName), &quot;Booking Verification&quot;),
    NOT($Permission.Booking_Verification_Access),
    NOT(Bypass_Validation__c)
)</errorConditionFormula>
    <errorMessage>You do not have permission to move an Opportunity out of Booking Verification.</errorMessage>
</ValidationRule>
