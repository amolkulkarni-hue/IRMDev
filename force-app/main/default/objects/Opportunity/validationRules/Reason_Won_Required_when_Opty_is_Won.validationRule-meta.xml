<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reason_Won_Required_when_Opty_is_Won</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(StageName,&quot;5 - Signed/PO in&quot;),ISPICKVAL(IME_Reason_Won__c , &quot;&quot;),OR(
$RecordType.DeveloperName = &apos;Standard_Opportunity&apos;,
$RecordType.DeveloperName = &apos;IMAP_Standard_Opportunity&apos;,
$RecordType.DeveloperName = &apos;IME_Standard_Opportunity&apos;,
$RecordType.DeveloperName = &apos;IMLA_Standard_Opportunity&apos;,
$RecordType.DeveloperName = &apos;CPQ_Sales_Opportunity&apos;
))</errorConditionFormula>
    <errorDisplayField>IME_Reason_Won__c</errorDisplayField>
    <errorMessage>Please fill in a Reason Won.</errorMessage>
</ValidationRule>
