<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Qual_ImpactConsequences_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(Bypass_Validation__c),  
ISCHANGED(StageName),
ISPICKVAL(PRIORVALUE(StageName), &apos;Qualification&apos;),
ISPICKVAL(StageName, &apos;Solutioning&apos;),  
ISPICKVAL(Impact_Consequences_Identified__c, &apos;&apos;)
)</errorConditionFormula>
    <errorDisplayField>Impact_Consequences_Identified__c</errorDisplayField>
    <errorMessage>Impact / Consequences Identified is required before advancing from Qualification. Please select a value.</errorMessage>
</ValidationRule>
