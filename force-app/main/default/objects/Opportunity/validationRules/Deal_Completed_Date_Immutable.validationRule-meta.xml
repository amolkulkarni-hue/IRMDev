<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Deal_Completed_Date_Immutable</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT(Bypass_Validation__c),    
NOT(ISNEW()),
    ISCHANGED(Deal_Completed_Date__c)
)</errorConditionFormula>
    <errorMessage>Deal Completed Date is system maintained and cannot be modified.</errorMessage>
</ValidationRule>
