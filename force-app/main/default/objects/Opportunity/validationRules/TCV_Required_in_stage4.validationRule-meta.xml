<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TCV_Required_in_stage4</fullName>
    <active>false</active>
    <description>Created this Validation rule to mandate TCV field if contract term is above 12 in stage 4
#13028 #13027</description>
    <errorConditionFormula>AND
(
NOT($Setup.Metadata_Activation_Settings__c.Disable_VR__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c),
CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Opportunity&apos;))),

Contract_Term_months__c&gt;12,
ISBLANK(Total_Contract_Value_TCV__c),
!IsVRByPassed__c,
ISPICKVAL(StageName, &apos;4 - Negotiate&apos;),
$Profile.Name &lt;&gt; &apos;IM_Sales_IMTN&apos;
)</errorConditionFormula>
    <errorDisplayField>Total_Contract_Value_TCV__c</errorDisplayField>
    <errorMessage>Total Contract Value is required in stage 4</errorMessage>
</ValidationRule>
