<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>My_Open_Opportunities_with_Score</fullName>
    <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
    <columns>OPPORTUNITY.NAME</columns>
    <columns>ACCOUNT.NAME</columns>
    <columns>OPPORTUNITY_SCORE</columns>
    <columns>OPPORTUNITY.AMOUNT</columns>
    <columns>IM_Booked_Date__c</columns>
    <columns>OPPORTUNITY.CLOSE_DATE</columns>
    <columns>OPPORTUNITY.STAGE_NAME</columns>
    <columns>CORE.USERS.ALIAS</columns>
    <columns>OPPORTUNITY.TYPE</columns>
    <columns>OPPORTUNITY.CREATED_DATE</columns>
    <columns>IM_Commit_to_Forecast__c</columns>
    <columns>OPPORTUNITY.LAST_ACTIVITY</columns>
    <filterScope>Mine</filterScope>
    <filters>
        <field>OPPORTUNITY.CLOSED</field>
        <operation>equals</operation>
        <value>0</value>
    </filters>
    <filters>
        <field>OPPORTUNITY.STAGE_NAME</field>
        <operation>notEqual</operation>
        <value>0 - Forecast,1 - Under Review,2 - Price Plan Set,3 - Manager Review</value>
    </filters>
    <filters>
        <field>OPPORTUNITY.STAGE_NAME</field>
        <operation>notEqual</operation>
        <value>4 - Revenue Management Review,5 - Closed - In Fulfillment</value>
    </filters>
    <filters>
        <field>OPPORTUNITY.STAGE_NAME</field>
        <operation>notEqual</operation>
        <value>5 - Closed - Rates Uploaded,Deferred,Excluded</value>
    </filters>
    <label>My Open Opportunities with Score</label>
    <language>en_US</language>
</ListView>
