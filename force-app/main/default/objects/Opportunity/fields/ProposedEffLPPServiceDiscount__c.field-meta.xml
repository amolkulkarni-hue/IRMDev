<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ProposedEffLPPServiceDiscount__c</fullName>
    <formula>IF 
( 
(ServiceStdandPremRevatListPrice__c - ProposedServicePremiumRevenue__c) = 0, 
0, 
1 - ( ( ProposedServiceStandardRevenue__c + ProposedServicePremiumRevenue__c ) / (ServiceStdandPremRevatListPrice__c - ProposedServicePremiumRevenue__c) ) 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Proposed Effective LPP Service Discount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
