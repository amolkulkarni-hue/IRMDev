<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CurrentEffLPPStorageDiscount__c</fullName>
    <formula>IF 
( 
(StorageStdandPremRevatListPrice__c - CurrentStoragePremiumRevenue__c) = 0, 
0, 
1 - ( (CurrentStoragePremiumRevenue__c + CurrentStorageStandardRevenue__c) / (StorageStdandPremRevatListPrice__c - CurrentStoragePremiumRevenue__c) ) 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Current Effective LPP Storage Discount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
