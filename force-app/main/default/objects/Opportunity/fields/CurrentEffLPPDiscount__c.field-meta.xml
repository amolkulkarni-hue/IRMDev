<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CurrentEffLPPDiscount__c</fullName>
    <formula>IF 
( 
(TotalStdandPremRevatListPrice__c - Current_Premium_Revenue__c) = 0, 
0, 
1 - ( CurrentTotalStdandPremRevenue__c / ( TotalStdandPremRevatListPrice__c - Current_Premium_Revenue__c ) ) 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Current Effective LPP Discount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
