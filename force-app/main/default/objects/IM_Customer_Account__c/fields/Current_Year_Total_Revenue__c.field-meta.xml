<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Current_Year_Total_Revenue__c</fullName>
    <description>Invoiced revenue from all business lines for the current calendar year.</description>
    <formula>Current_Year_DBR_Revenue__c + Current_Year_DMS_Revenue__c + Current_Year_Other_Revenue__c + Current_Year_RM_Revenue__c +  Current_Year_Shred_Revenue__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Invoiced revenue from all business lines for the current calendar year.</inlineHelpText>
    <label>Current Year Total Revenue</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
