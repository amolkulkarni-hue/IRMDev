<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>My_Open_NAS_Cases</fullName>
    <columns>CASES.CASE_NUMBER</columns>
    <columns>CASES.SUBJECT</columns>
    <columns>CASES.STATUS</columns>
    <columns>CASES.PRIORITY</columns>
    <columns>Customer_Name__c</columns>
    <columns>Customer_ID__c</columns>
    <columns>CASES.TYPE</columns>
    <columns>Days_Open_del__c</columns>
    <columns>CASES.LAST_UPDATE_DATE_ONLY</columns>
    <columns>Follow_up_Date__c</columns>
    <filterScope>Mine</filterScope>
    <filters>
        <field>CASES.STATUS</field>
        <operation>notEqual</operation>
        <value>Closed,Cancelled,Resolved,Customer Unresponsive</value>
    </filters>
    <filters>
        <field>CASES.RECORDTYPE</field>
        <operation>equals</operation>
        <value>Case.Global_Service_Case,Case.NAS_Community_Support_Case,Case.NAS_General_Support_Case,Case.NAS_Recurring_Support_Case</value>
    </filters>
    <label>*My Open NAS Cases</label>
    <sharedTo>
        <allInternalUsers></allInternalUsers>
    </sharedTo>
</ListView>
