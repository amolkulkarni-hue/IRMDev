<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Count_of_Case_Not_Closed__c</fullName>
    <description>This field is added for NCSP reports</description>
    <externalId>false</externalId>
    <formula>IF(NOT(ISNULL(Transition_Date__c)) &amp;&amp; NOT( ISPICKVAL(Status,&apos;Closed&apos; ) ||  ISPICKVAL(Status,&apos;Cancelled&apos; ) || ISPICKVAL(Status,&apos;Duplicate&apos; ) ), 1 , 0 )</formula>
    <label>Count of Case Not Closed</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
