<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SLA_Breach__c</fullName>
    <description>TRUE when the case has been open longer than its SLA threshold (default 7 days; tune per Case Type).</description>
    <formula>AND(ISBLANK(ClosedDate), (TODAY() - DATEVALUE(CreatedDate)) &gt; 7)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>SLA Breach</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
