<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>All_Start_Docs_Display__c</fullName>
    <description>Text formula showing Case-first ("required for case") document completion status. Add to the Related Cases list on Opportunity alongside All_Exit_Docs_Display__c.</description>
    <externalId>false</externalId>
    <formula>IF(All_Start_Docs_Final__c, &quot;✔ All Final&quot;, &quot;⏳ Docs Pending&quot;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Start Docs Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
