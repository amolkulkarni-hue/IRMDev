<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Supplies_Scheduled_Date_formatted__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Supplies_Scheduled_Date__c),
NULL,
CASE(MONTH(DATEVALUE(Supplies_Scheduled_Date__c)), 
1, &quot;January&quot;, 
2, &quot;February&quot;, 
3, &quot;March&quot;, 
4, &quot;April&quot;, 
5, &quot;May&quot;, 
6, &quot;June&quot;, 
7, &quot;July&quot;, 
8, &quot;August&quot;, 
9, &quot;September&quot;, 
10, &quot;October&quot;, 
11, &quot;November&quot;, 
12, &quot;December&quot;, 
NULL) 
+&quot; &quot;
+TEXT(DAY(DATEVALUE(Supplies_Scheduled_Date__c))) 
+&quot;, &quot;
+TEXT(YEAR(DATEVALUE(Supplies_Scheduled_Date__c))
)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Supplies Scheduled Date (formatted)</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
