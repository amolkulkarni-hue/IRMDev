<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NCSP_Renewal_Rejection_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
RecordType_Name__c = &quot;NCSP Renewal&quot;,
ISPICKVAL(Contract_Status__c,&quot;Rejected&quot;),
ISBLANK(TEXT(Primary_Contract_Rejection_Reason__c))
)</errorConditionFormula>
    <errorDisplayField>Primary_Contract_Rejection_Reason__c</errorDisplayField>
    <errorMessage>You must select a Rejection Reason</errorMessage>
</ValidationRule>
