<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IME_SC_ValidateCompensationAmout</fullName>
    <active>true</active>
    <description>Compensation amount cannot be negative.</description>
    <errorConditionFormula>AND ( $RecordType.Name = &quot;IME SC Case&quot; ,  IME_SC_Compensation_Amount__c  &lt; 0 )</errorConditionFormula>
    <errorDisplayField>IME_SC_Compensation_Amount__c</errorDisplayField>
    <errorMessage>Compensation Amount cannot be negative.</errorMessage>
</ValidationRule>
