<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CAC_SKP_RM_Closure_Reason</fullName>
    <active>true</active>
    <description>Closure Reason must exist when invoice is requested</description>
    <errorConditionFormula>$RecordType.Name = &apos;CAC - SKP RM&apos;  &amp;&amp; not(isblank(Invoice_Request_Date__c )) &amp;&amp; ispickval(Closure_Reason__c ,&apos;&apos; )</errorConditionFormula>
    <errorDisplayField>Closure_Reason__c</errorDisplayField>
    <errorMessage>Closure Reason must exist when invoice is requested</errorMessage>
</ValidationRule>
