<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLAS_Outboxes_Non_Negative</fullName>
    <active>true</active>
    <description>Does not allow Outboxes field to be non negative</description>
    <errorConditionFormula>Outboxes_Cu_Ft__c &lt;0</errorConditionFormula>
    <errorDisplayField>Outboxes_Cu_Ft__c</errorDisplayField>
    <errorMessage>Cannot be a negative number.</errorMessage>
</ValidationRule>
