<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Retention_RM_Case_Close_Required_Fields</fullName>
    <active>true</active>
    <description>Fields required to close a Retention RM case</description>
    <errorConditionFormula>RecordType.DeveloperName = &apos;Retention_RM&apos; &amp;&amp; (ISPICKVAL(Status, &apos;Complete&apos;) || ISPICKVAL(Status, &apos;Duplicate&apos;)) &amp;&amp; (ISPICKVAL(Closure_Reason__c,&apos;&apos;) || ISPICKVAL(Retained__c,&apos;&apos;))</errorConditionFormula>
    <errorMessage>Closure Reason and Retained are required to close the case</errorMessage>
</ValidationRule>
