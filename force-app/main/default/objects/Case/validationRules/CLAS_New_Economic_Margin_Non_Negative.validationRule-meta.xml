<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CLAS_New_Economic_Margin_Non_Negative</fullName>
    <active>true</active>
    <description>Does not allow New economic margin to be non negative.</description>
    <errorConditionFormula>New_Economic_Margin__c  &lt; 0</errorConditionFormula>
    <errorDisplayField>New_Economic_Margin__c</errorDisplayField>
    <errorMessage>Cannot be a negative number.</errorMessage>
</ValidationRule>
