<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CAC_Retention_Service_Order_Number</fullName>
    <active>true</active>
    <errorConditionFormula>$RecordType.Name = &apos;CLAS - Shred&apos;  &amp;&amp;  not (isblank(Date_Final_Order_Created_in_SKP__c )) &amp;&amp; ISBLank( Service_Order_Number__c )</errorConditionFormula>
