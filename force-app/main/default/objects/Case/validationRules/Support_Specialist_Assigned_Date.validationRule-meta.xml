<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Support_Specialist_Assigned_Date</fullName>
    <active>true</active>
    <description>Support Specialist Assigned Date cannot be in the Past or the Future. For reference, check user story #26355 on Gitlab.</description>
    <errorConditionFormula>(RecordType_Name__c = &quot;CLAS - RM&quot;) &amp;&amp;
NOT(ISCHANGED(Open_Tasks__c)) &amp;&amp;
ISCHANGED(Support_Specialist_Assigned_Date__c) &amp;&amp;
NOT(ISBLANK(Support_Specialist_Assigned_Date__c)) &amp;&amp;
Support_Specialist_Assigned_Date__c != TODAY() &amp;&amp;
(
  ISBLANK(PRIORVALUE(Support_Specialist_Assigned_Date__c)) ||
  Support_Specialist_Assigned_Date__c != PRIORVALUE(Support_Specialist_Assigned_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Support_Specialist_Assigned_Date__c</errorDisplayField>
    <errorMessage>Support Specialist Assigned Date cannot be in the Past or the Future.</errorMessage>
</ValidationRule>
