<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GO_Either_OppAcc_CustAcc</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Global_Orders&quot;,
    AND(
        NOT(ISBLANK(GSC_Operational_Account__c)),
        NOT(ISBLANK(Customer_ID__c))
    )
)</errorConditionFormula>
    <errorMessage>Only either of Operational/Customer Account should be updated.</errorMessage>
</ValidationRule>
