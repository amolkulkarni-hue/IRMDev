<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IME_SC_ValidateNumberOfLineItems</fullName>
    <active>true</active>
    <description>Number of line items cannot be negative.</description>
    <errorConditionFormula>AND ( $RecordType.Name = &quot;IME SC Case&quot; , IME_SC_Number_of_Line_Items__c &lt; 0 )</errorConditionFormula>
    <errorDisplayField>IME_SC_Number_of_Line_Items__c</errorDisplayField>
    <errorMessage>Number of line items cannot be a negative number.</errorMessage>
</ValidationRule>
