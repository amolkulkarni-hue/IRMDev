<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Change_Approver_2</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISCHANGED( Approver_2__c ) ,
ISPICKVAL(Approved_2__c, &quot;Yes&quot;)
)</errorConditionFormula>
    <errorDisplayField>Approver_2__c</errorDisplayField>
    <errorMessage>You cannot change the name of the Approver if they already approved this record.</errorMessage>
</ValidationRule>
