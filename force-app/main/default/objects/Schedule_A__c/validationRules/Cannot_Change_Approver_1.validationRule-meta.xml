<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Change_Approver_1</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISCHANGED(Approver_1__c) ,
ISPICKVAL(Approved_1__c, &quot;Yes&quot;)
)</errorConditionFormula>
    <errorDisplayField>Approver_1__c</errorDisplayField>
    <errorMessage>You cannot change the name of the Approver if they already approved this record.</errorMessage>
</ValidationRule>
