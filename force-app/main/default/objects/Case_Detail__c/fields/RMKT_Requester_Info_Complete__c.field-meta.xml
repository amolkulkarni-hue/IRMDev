<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RMKT_Requester_Info_Complete__c</fullName>
    <description>Field to check if all required Remarketing Case-Requester fields are populated.</description>
    <formula>AND(
			NOT(ISBLANK(RMKT_Asset_Type__c)),
			NOT(ISBLANK(TEXT(RMKT_Nature_Of_Request__c))),
			NOT(ISBLANK(TEXT(RMKT_Condition_Notes__c))),
			NOT(ISBLANK(TEXT(RMKT_Due_Date__c))),
			NOT(ISBLANK(RMKT_Request_Type__c)),
			NOT(ISBLANK(TEXT(RMKT_Take_Out_Time_Frame__c)))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Required Remarketing Case-Requester fields are populated.</inlineHelpText>
    <label>Requester Info Complete</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
