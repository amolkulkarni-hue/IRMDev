<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BM_Requester_Info_Complete__c</fullName>
    <description>Field to check if all BID Management Required Field are populated.</description>
    <formula>AND(
				NOT(ISBLANK(TEXT(BM_Request_Type__c))),
				NOT(ISBLANK(TEXT(BM_Due_Date__c))),
				NOT(ISBLANK(TEXT(BM_Portal_Login_Required__c))),
				NOT(ISBLANK(TEXT(BM_Submission_Method__c)))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>BID Management Required Field are populated</inlineHelpText>
    <label>Requester Info Complete</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
