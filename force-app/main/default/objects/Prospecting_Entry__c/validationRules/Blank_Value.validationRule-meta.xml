<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Blank_Value</fullName>
    <active>true</active>
    <description>Cannot create a prospecting entry with a blank Start Date field.</description>
    <errorConditionFormula>ISBLANK( Start_Date__c )</errorConditionFormula>
    <errorDisplayField>Start_Date__c</errorDisplayField>
    <errorMessage>Please enter a value</errorMessage>
</ValidationRule>
