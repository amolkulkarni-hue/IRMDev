<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Date_is_a_Friday</fullName>
    <active>true</active>
    <description>The End Date must be on a Friday</description>
    <errorConditionFormula>MOD( End_Date__c - DATE(1900, 1, 6), 7) != 6</errorConditionFormula>
    <errorMessage>The End Date must be on a Friday</errorMessage>
</ValidationRule>
