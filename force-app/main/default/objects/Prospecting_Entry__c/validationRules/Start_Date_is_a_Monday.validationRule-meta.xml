<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_Date_is_a_Monday</fullName>
    <active>true</active>
    <description>The Start Date must be on a Monday</description>
    <errorConditionFormula>MOD( Start_Date__c - DATE(1900, 1, 6), 7) != 2</errorConditionFormula>
    <errorMessage>The Start Date must be on a Monday</errorMessage>
</ValidationRule>
