<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_Status_Duration__c</fullName>
    <description>This field calculates the number of days since Lead Status was changed to &apos;New&apos;.</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(Status, &quot;New&quot;) &amp;&amp; NOT(ISBLANK(New_Status_Entered_Date__c)), TODAY() - New_Status_Entered_Date__c , 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>New Status Duration</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
