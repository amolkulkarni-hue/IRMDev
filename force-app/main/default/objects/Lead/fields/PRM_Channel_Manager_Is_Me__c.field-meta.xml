<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PRM_Channel_Manager_Is_Me__c</fullName>
    <description>Compares the logged in user ID to the ID of the user selected in the Channel Manager field.</description>
    <formula>IF( Channel_Manager__r.PRM_User_ID__c = $User.Id,TRUE,FALSE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Channel Manager Is Me</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
