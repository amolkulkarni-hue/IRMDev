<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IME_Prevent_conversion_unless_Stage_3</fullName>
    <active>false</active>
    <description>Ensures that IME leads can only be converted from Stage 3</description>
    <errorConditionFormula>AND(
IsConverted, 
RecordTypeId == &quot;01280000000UDKI&quot;,  
NOT(ISPICKVAL(PRIORVALUE(IM_Lead_Stage__c) , &quot;3-Sales Accepted&quot;))
)</errorConditionFormula>
    <errorMessage>You can only convert a lead at Stage 3-Sales Accepted</errorMessage>
</ValidationRule>
