<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Authority</fullName>
    <active>false</active>
    <description>Make sure an Authority value is entered</description>
    <errorConditionFormula>AND( Authority__c  = TRUE,ISBLANK(  Authority_Contact__c ))</errorConditionFormula>
    <errorDisplayField>Authority_Contact__c</errorDisplayField>
    <errorMessage>You must enter a name if the Authority box is checked</errorMessage>
</ValidationRule>
