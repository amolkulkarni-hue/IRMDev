<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Account_Or_Company_Name</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISBLANK( Account__c ),
    ISBLANK(  Company_Name__c  )
)</errorConditionFormula>
    <errorDisplayField>Account__c</errorDisplayField>
    <errorMessage>Please provide either an Account Name or a Company Name before saving the Lead.</errorMessage>
</ValidationRule>
