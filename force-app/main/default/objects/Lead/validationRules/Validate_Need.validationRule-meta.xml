<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Need</fullName>
    <active>false</active>
    <description>Make sure a need reason is entered</description>
    <errorConditionFormula>AND( Need__c   = TRUE,ISBLANK( Describe_Need__c  ))</errorConditionFormula>
    <errorDisplayField>Describe_Need__c</errorDisplayField>
    <errorMessage>You must enter a reason if the Need box is checked</errorMessage>
</ValidationRule>
