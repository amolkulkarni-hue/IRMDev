<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Country_on_Lead_Creation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT($Permission.Bypass_Lead_Validation),
    ISNEW(),
    ISBLANK(Country)
)</errorConditionFormula>
    <errorDisplayField>Country</errorDisplayField>
    <errorMessage>Country is required to create a Lead. Please select a country before saving.</errorMessage>
</ValidationRule>
