<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_TimeFrame</fullName>
    <active>false</active>
    <description>Make sure a date is entered</description>
    <errorConditionFormula>AND( Time_Frame__c  = TRUE,ISBLANK( Time_Frame_Date__c ))</errorConditionFormula>
    <errorDisplayField>Time_Frame_Date__c</errorDisplayField>
    <errorMessage>You must enter a date if the Time Frame box is checked</errorMessage>
</ValidationRule>
