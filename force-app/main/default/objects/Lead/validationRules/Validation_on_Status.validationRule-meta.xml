<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_on_Status</fullName>
    <active>true</active>
    <errorConditionFormula>ISNEW() &amp;&amp; NOT(ISPICKVAL(Status, &apos;New&apos;)) &amp;&amp; RecordType.Name = &quot;Primary Lead&quot;</errorConditionFormula>
    <errorMessage>New leads must enter with status New</errorMessage>
</ValidationRule>
