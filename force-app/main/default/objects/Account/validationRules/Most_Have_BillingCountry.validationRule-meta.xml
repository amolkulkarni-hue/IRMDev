<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Most_Have_BillingCountry</fullName>
    <active>false</active>
    <description>For User story #4596</description>
    <errorConditionFormula>AND(
OR(RecordType.DeveloperName =&apos;Standard_Account&apos;,RecordType.DeveloperName =&apos;QTB_Billing_Account&apos;),
NOT(BEGINS( Name , &quot;BILLP&quot;)), 
ISBLANK(BillingCountry)

)</errorConditionFormula>
    <errorMessage>Please include the Country to save this record</errorMessage>
</ValidationRule>
