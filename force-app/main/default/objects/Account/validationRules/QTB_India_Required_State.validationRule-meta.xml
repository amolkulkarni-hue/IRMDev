<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QTB_India_Required_State</fullName>
    <active>true</active>
    <description>QTB-44a -when billing country is India state is required</description>
    <errorConditionFormula>AND(NOT($Setup.Metadata_Activation_Settings__c.Disable_VR__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Account&apos;))), RecordType.DeveloperName = $Label.QTB_AccountRecordType_Billing , NOT (ISBLANK( ParentId )), LOWER(BillingCountry)=&apos;india&apos;,ISBLANK(BillingState) )</errorConditionFormula>
    <errorDisplayField>BillingState</errorDisplayField>
    <errorMessage>India require a state</errorMessage>
</ValidationRule>
