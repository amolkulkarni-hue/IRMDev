<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QTB_Special_Tax_Condition_cannot_be_Null</fullName>
    <active>true</active>
    <description>QTB-SFCPQBLG-481-----need some value in Special Tax condition</description>
    <errorConditionFormula>AND(NOT($Setup.Metadata_Activation_Settings__c.Disable_VR__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Account&apos;))), RecordType.DeveloperName = $Label.QTB_AccountRecordType_Billing , NOT (ISBLANK( ParentId )),ISBLANK(TEXT(QTB_Special_Tax_Condition__c )),ISCHANGED(QTB_Special_Tax_Condition__c ) )</errorConditionFormula>
    <errorDisplayField>QTB_Special_Tax_Condition__c</errorDisplayField>
    <errorMessage>Enter some value.</errorMessage>
</ValidationRule>
