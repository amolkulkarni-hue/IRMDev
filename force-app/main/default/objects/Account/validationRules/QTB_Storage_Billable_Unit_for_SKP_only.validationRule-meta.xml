<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QTB_Storage_Billable_Unit_for_SKP_only</fullName>
    <active>false</active>
    <description>#33521 InActivating this Rule because from now onwards SKP Countries also will enter Storage Billing Unit</description>
    <errorConditionFormula>AND(NOT($Setup.Metadata_Activation_Settings__c.Disable_VR__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c),
CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Account&apos;))),
AND(NOT(ISBLANK((TEXT(QTB_Storage_Billing_Unit__c)))) ,
NOT(CONTAINS($Label.QTB_SKP_Countries,TEXT(QTB_Legal_Entity_Country__c)))))</errorConditionFormula>
    <errorMessage>Storage Billable Unit should be selected only when operational system is SKP</errorMessage>
</ValidationRule>
