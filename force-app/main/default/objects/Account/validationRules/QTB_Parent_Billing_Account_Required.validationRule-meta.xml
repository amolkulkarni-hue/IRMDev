<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QTB_Parent_Billing_Account_Required</fullName>
    <active>true</active>
    <description>Parent Billing Account field needs to be populated if Create Parent Billing Account Field is unchecked</description>
    <errorConditionFormula>AND(NOT($Setup.Metadata_Activation_Settings__c.Disable_VR__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Account&apos;))),QTB_Create_Parent_Billing_Account__c = false,  ISBLANK(ParentId), RecordType.DeveloperName = $Label.QTB_AccountRecordType_Billing)</errorConditionFormula>
    <errorMessage>Parent Billing Account needs to be populated if Create Parent Billing Account is unchecked</errorMessage>
</ValidationRule>
