<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QTB_Contract_Entity_Required</fullName>
    <active>true</active>
    <description>QTB-44a- contract entity is required for  child billing country</description>
    <errorConditionFormula>AND(NOT($Setup.Metadata_Activation_Settings__c.Disable_VR__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Account&apos;))), RecordType.DeveloperName = $Label.QTB_AccountRecordType_Billing , NOT (ISBLANK( ParentId )), ISBLANK(  QTB_Contract_Entity__c  ) )</errorConditionFormula>
    <errorDisplayField>QTB_Contract_Entity__c</errorDisplayField>
    <errorMessage>Contract Legal Entity required on Billing Account or Value Missing on Sales Quote</errorMessage>
</ValidationRule>
