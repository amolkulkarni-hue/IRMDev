<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Lead_Conversion_To_NonSalesSite</fullName>
    <active>false</active>
    <description>24950 -Lead can only converted to sales site account</description>
    <errorConditionFormula>AND(
NOT(ISNEW()),
NOT(ISPICKVAL(IM_Hierarchy_Level__c ,&apos;Sales (Site)&apos;)),
Converted_From_Lead__c =&apos;Converted&apos;
)</errorConditionFormula>
    <errorMessage>Leads can only be converted to Sales Site accounts.</errorMessage>
</ValidationRule>
