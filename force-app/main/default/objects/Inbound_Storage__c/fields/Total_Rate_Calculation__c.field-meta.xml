<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Rate_Calculation__c</fullName>
    <description>Calculates a Rate value based on the total Revenue and Volume values. This ensures that what ever rate is being used for calculation is captured.</description>
    <externalId>false</externalId>
    <formula>( Total_Revenue__c /  Total_Volume__c )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Rate Calculation</label>
    <precision>18</precision>
    <required>false</required>
    <scale>3</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
