<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pipeline_Target_CY__c</fullName>
    <description>This is an automated field that calculates the target owner&apos;s current year pipeline target amount based on the values
entered in the individual month target fields.</description>
    <formula>Pipeline_Target_Jan__c+Pipeline_Target_Feb__c+Pipeline_Target_Mar__c+Pipeline_Target_Apr__c+Pipeline_Target_May__c+Pipeline_Target_Jun__c
+Pipeline_Target_Jul__c+Pipeline_Target_Aug__c+Pipeline_Target_Sep__c+Pipeline_Target_Oct__c+Pipeline_Target_Nov__c+Pipeline_Target_Dec__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Pipeline Target (CY)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
