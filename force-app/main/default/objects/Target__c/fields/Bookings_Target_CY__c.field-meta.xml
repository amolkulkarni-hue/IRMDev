<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Bookings_Target_CY__c</fullName>
    <description>This is an automated field that calculates the target owner&apos;s current year bookings target amount based on the values
entered in the individual month target fields.</description>
    <formula>Bookings_Target_Jan__c+Bookings_Target_Feb__c+Bookings_Target_Mar__c+Bookings_Target_Apr__c+Bookings_Target_May__c+Bookings_Target_Jun__c
+Bookings_Target_Jul__c+Bookings_Target_Aug__c+Bookings_Target_Sep__c+Bookings_Target_Oct__c+Bookings_Target_Nov__c+Bookings_Target_Dec__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Bookings Target (CY)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
