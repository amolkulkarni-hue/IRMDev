<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Num_of_Target_Periods__c</fullName>
    <description>This is an automated field that counts the target owner&apos;s total number of target periods (months).</description>
    <externalId>false</externalId>
    <formula>IF(

YTD_Target_End_Period__c  &gt;= YTD_Target_Start_Period__c, YTD_Target_End_Period__c - YTD_Target_Start_Period__c + 1, 0

)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label># of Target Periods</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
