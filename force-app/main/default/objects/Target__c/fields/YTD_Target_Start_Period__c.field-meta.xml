<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>YTD_Target_Start_Period__c</fullName>
    <description>This field displays the numeric month (1-12) that corresponds with the owner&apos;s &apos;Effective Start Period&apos;.</description>
    <externalId>false</externalId>
    <formula>IF (

