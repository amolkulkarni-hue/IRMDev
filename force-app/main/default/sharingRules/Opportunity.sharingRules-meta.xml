    <sharingCriteriaRules>
        <fullName>CloudSolutionsProduct_Opp_Sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <description>When there is at least one &apos;Cloud Solutions&apos; Product on the opportunity giving read and write access to &apos;CloudSolutionsProductAccess&apos; public group.</description>
        <label>CloudSolutionsProduct_Opp_Sharing</label>
        <sharedTo>
            <group>CloudSolutionsProductAccess</group>
        </sharedTo>
        <criteriaItems>
            <field>IsCloudSolutionProductCreated__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
