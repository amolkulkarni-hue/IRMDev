    <decisions>
        <description>This decision is used for scheduled task for the &apos;Closure RM&apos; record type. This will create the task &apos;Follow up 2 - Term Quote&apos; if the CLAS-RM Case &amp; When Date Term Quote Attempt 1 field is filled out, it will fire the task after 1 day if the Customer Approval Term Quote has not filled out yet.</description>
        <name>Check_if_Customer_Approval_Term_Quote_is_null</name>
        <label>Check if Customer Approval Term Quote is null</label>
        <locationX>4142</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Task_Follow_up_2_Term_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_approved_Cost_Summary__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Follow_up_2_Term_Quote_Task</targetReference>
            </connector>
            <label>Task - Follow up 2 - Term Quote</label>
        </rules>
    </decisions>
