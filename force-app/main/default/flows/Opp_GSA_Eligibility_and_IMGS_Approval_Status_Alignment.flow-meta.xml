<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Update GSA Eligibility to GSA Eligible when IMGS Approval Status is GSA Pricing Approved</description>
        <name>Update_GSA_Eligibility</name>
        <label>Update GSA Eligibility</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.GSA_Eligibility__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>GSA Eligible</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Update GSA Eligibility to Standard Pricing Applies when IMGS Approval Status is Blank or No Approval Necessary or Std Pricing Applies</description>
        <name>Update_GSA_Eligibility_to_Std_Pricing</name>
        <label>Update GSA Eligibility to Std Pricing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.GSA_Eligibility__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Standard Pricing Applies</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Update GSA Eligibility to Undetermined when IMGS Approval Status is Under Review</description>
        <name>Update_GSA_Eligibility_to_Undetermined</name>
        <label>Update GSA Eligibility to Undetermined</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.GSA_Eligibility__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Undetermined</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checks Field Value of IMGS Approval Status and accordingly updates GSA Eligibility</description>
        <name>Checking_Approval_Status</name>
        <label>Checking Approval Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Under_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IMGS_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Under Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_GSA_Eligibility_to_Undetermined</targetReference>
            </connector>
            <label>Under Review</label>
        </rules>
        <rules>
            <name>Standard_Pricing_No_Approval</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IMGS_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard Pricing Applies</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IMGS_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No Approval Necessary</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IMGS_Approval_Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_GSA_Eligibility_to_Std_Pricing</targetReference>
            </connector>
            <label>Standard Pricing/ No Approval</label>
        </rules>
        <rules>
            <name>GSA_Pricing_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IMGS_Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GSA Pricing Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_GSA_Eligibility</targetReference>
            </connector>
            <label>GSA Pricing Approved</label>
        </rules>
    </decisions>
    <description>#32775 - The GSA/SLED/Public Sector Eligibility field under Opp Information should align with the IMGS Approval Status to keep data consistent.</description>
    <environments>Default</environments>
    <interviewLabel>Opp GSA Eligibility and IMGS Approval Status Alignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp GSA Eligibility and IMGS Approval Status Alignment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Checking_Approval_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IMGS_Approval_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
