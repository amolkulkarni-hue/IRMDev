    <description>Migrated from the Update Pricebook On Opportunity process using Check For Opportunity Account Division criteria.
This is PB is used to update NA, LA, AP and Eur on to the opportunity pricebook id based on the Account division and Product Group IM Account Division.</description>
    <environments>Default</environments>
    <formulas>
        <name>Metadata_Activation_Setting</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT($Setup.Metadata_Activation_Settings__c.Disable_PB__c &amp;&amp;
OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c,&apos;Opportunity&apos;))),
OR(ISNEW(),ISCHANGED({!$Record.Account_Division_Display__c}
),ISCHANGED({!$Record.CurrencyIsoCode} ),ISCHANGED({!$Record.RecordTypeId} )),
NOT(ISBLANK({!$Record.Account_Division_Display__c})),
{!$Record.RecordType.DeveloperName&lt;&gt;$Label.QTB_OpportunityRecordType_Sales} 
)</expression>
    </formulas>
    <interviewLabel>Update Pricebook On Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Pricebook On Opportunity</label>
