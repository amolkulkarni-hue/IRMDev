<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Update Sales Price and Unit price based on the  IM_Revenue_Type__c value</description>
        <name>Update_Sales</name>
        <label>Update Sales and Unit Price</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.UnitPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IME_UpdateSalesPriceFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Unit_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Update_Unit_PriceFormula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Migrated from the: IME_Recalculate Sales Price workflow rule
Workflow rule description: This Rule is modified to execute for Standard Record Type  for NA users (Lighting Pilot - Case# 09154470)&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>IME_UpdateSalesPriceFormula</name>
        <dataType>Currency</dataType>
        <expression>IF( ISPICKVAL( $Record.PricebookEntry.Product2.IM_Revenue_Type__c , &quot;Recurring&quot;) , $Record.UnitPrice * 12, $Record.UnitPrice )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Update_Unit_PriceFormula</name>
        <dataType>Currency</dataType>
        <expression>IF( ISPICKVAL( $Record.PricebookEntry.Product2.IM_Revenue_Type__c , &quot;Recurring&quot;) , $Record.UnitPrice / 12, $Record.UnitPrice )</expression>
        <scale>2</scale>
    </formulas>
    <label>IME_Recalculate Sales Price</label>
    <migratedFromWorkflowRuleName>IME_Recalculate Sales Price</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Sales</targetReference>
        </connector>
        <filterFormula>OR( {!$Record.Opportunity.RecordType.DeveloperName} =&apos;IME_Standard_Opportunity&apos;, {!$Record.Opportunity.RecordType.DeveloperName} = &apos;IMLA_Standard_Opportunity&apos;, {!$Record.Opportunity.RecordType.DeveloperName} = &apos;IMAP_Standard_Opportunity&apos;, AND({!$Record.Opportunity.RecordType.DeveloperName} =&apos;Standard_Opportunity&apos;, {!$User.UITheme} &lt;&gt; &apos;Theme2&apos;, {!$User.UITheme} &lt;&gt; &apos;Theme3&apos;))</filterFormula>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
