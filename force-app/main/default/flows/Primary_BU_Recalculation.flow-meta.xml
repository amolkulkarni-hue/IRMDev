<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Update_Collection</name>
        <label>Add To Update Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>colLinesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Set_Primary_Flags</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Primary_Flags</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_Active_Count</name>
        <label>Increment Active Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varActiveLineCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Is_New_Winner</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Mark_As_Not_Primary</name>
        <label>Mark As Not Primary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Set_Primary_Flags.Is_Primary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Update_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Mark_As_Primary</name>
        <label>Mark As Primary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Set_Primary_Flags.Is_Primary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Update_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_New_Winner</name>
        <label>Set New Winner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varWinningRecordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Find_Highest_EAA_Line.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWinningEAA</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Find_Highest_EAA_Line.EAA__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWinningBusinessUnit</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Find_Highest_EAA_Line.Business_Unit__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWinningProductFamily</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Find_Highest_EAA_Line.Product_Family__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varWinningLastModified</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Find_Highest_EAA_Line.LastModifiedDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Find_Highest_EAA_Line</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Is_New_Winner</name>
        <label>Is This the New Highest-EAA Line?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Find_Highest_EAA_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_New_Winner</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>Find_Highest_EAA_Line.EAA__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varWinningEAA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Find_Highest_EAA_Line.EAA__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varWinningEAA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Find_Highest_EAA_Line.LastModifiedDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varWinningLastModified</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_New_Winner</targetReference>
            </connector>
            <label>Yes — New Winner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Is_Winning_Record</name>
        <label>Is This the Winning Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_As_Not_Primary</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Winning_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Set_Primary_Flags.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varWinningRecordId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_As_Primary</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Opportunity_Closed</name>
        <label>Is Opportunity Closed or Booked?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Active_Lines_For_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Closed</defaultConnectorLabel>
        <rules>
            <name>Closed_Or_Booked</name>
            <conditionLogic>1 OR 2 OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Booked</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <label>Closed or Booked — Stop</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Formula_Multi_BU_Flag</name>
        <dataType>Boolean</dataType>
        <expression>{!varActiveLineCount} &gt; 1</expression>
    </formulas>
    <formulas>
        <name>Formula_Primary_Product_Interest</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!varWinningProductFamily})), {!varWinningProductFamily}, TEXT({!$Record.Opportunity__r.Primary_Product_Line__c}))</expression>
    </formulas>
    <interviewLabel>Primary BU Recalculation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Primary BU Recalculation</label>
    <loops>
        <name>Find_Highest_EAA_Line</name>
        <label>Find Highest-EAA Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Active_Lines_For_Opportunity</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Active_Count</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Primary_Flags</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Set_Primary_Flags</name>
        <label>Set Primary Flags</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Active_Lines_For_Opportunity</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Is_Winning_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Product_Lines</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Active_Lines_For_Opportunity</name>
        <label>Get Active Lines For Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Find_Highest_EAA_Line</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity_Product_Line__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_Rollups</name>
        <label>Update Opportunity Rollups</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Business_Unit__c</field>
            <value>
                <elementReference>varWinningBusinessUnit</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Multi_BU_Flag__c</field>
            <value>
                <elementReference>Formula_Multi_BU_Flag</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Primary_Product_Line__c</field>
            <value>
                <elementReference>Formula_Primary_Product_Interest</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Product_Lines</name>
        <label>Update Product Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Opportunity_Rollups</targetReference>
        </connector>
        <inputReference>colLinesToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Opportunity_Closed</targetReference>
        </connector>
        <filterFormula>OR(
    ISNEW(),
    ISCHANGED({!$Record.Business_Unit__c}),
    ISCHANGED({!$Record.EAA__c}),
    ISCHANGED({!$Record.Is_Active__c})
)</filterFormula>
        <object>Opportunity_Product_Line__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>colLinesToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity_Product_Line__c</objectType>
    </variables>
    <variables>
        <name>varActiveLineCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varWinningBusinessUnit</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varWinningEAA</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>-1.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varWinningLastModified</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varWinningProductFamily</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varWinningRecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
