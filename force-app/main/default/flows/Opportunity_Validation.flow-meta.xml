    <decisions>
        <description>Checks if Primary Product Line field is changed by user or not and the User is bypassed if  &quot;Edit Primary Product Line in Late Stage Opp&quot; permission is assigned</description>
        <name>Check_Changed_Values</name>
        <label>Check Changed Values</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Check_GSA_Field_Edit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Primary_Product_Line_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Primary_Product_Line__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.Edit_Primary_Product_Line_in_Late_Stage_Opp</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error</targetReference>
            </connector>
            <label>Is Primary Product Line Changed?</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if GSA field is changed by user or not and the User is bypassed if  &quot;Edit  GSA Eligibility in Late Stage Opp&quot; permission is assigned</description>
        <name>Check_GSA_Field_Edit</name>
        <label>Check GSA Field Edit</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <defaultConnector>
