        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_GSA_SLED_Public_Sector_Eligibility_field_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GSA_Eligibility__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.Edit_GSA_Eligibility_in_Late_Stage_Opp</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GSA_SLED_Public_Sector_Error</targetReference>
            </connector>
            <label>Is GSA/SLED/Public Sector Eligibility field Changed?</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if Account field is changed by user or not and the User is bypassed if  &quot;Edit Account in Late Stage Opp&quot; permission is assigned</description>
        <name>Check_if</name>
        <label>Check Account Name Field Edit</label>
        <locationX>182</locationX>
        <locationY>887</locationY>
        <defaultConnector>
            <targetReference>Errors_occurred</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Account_Name_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.Edit_Account_in_Late_Stage_Opp</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Id_Can_not_be_edited</targetReference>
            </connector>
            <label>Is Account Name Changed?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Errors_occurred</name>
        <label>Errors occurred?</label>
        <locationX>182</locationX>
        <locationY>1187</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Error</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GSA_SLED_Public_Sector_Error</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Account_Id_Can_not_be_edited</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_the_error</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>#21307: We are in the process of updating the opportunity record in order to lock certain fields and functionality from seller edit/add in Stage 5, 6 and 7. There are additional fields/functionality that need to be locked down from editing/adding: Primary Product Line ,GSA,  Account Name fields
#24480:  Excluding flow to run for CPQ  Sales and Billing Opportunities</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Validation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Changed_Values</targetReference>
        </connector>
        <filterFormula>AND(
AND(
    OR(ISPICKVAL({!$Record.StageName},&apos;5 - Signed/PO in&apos;),
        ISPICKVAL({!$Record.StageName},&apos;6 - Setup&apos;),
        ISPICKVAL({!$Record.StageName},&apos;7 - Closed&apos;) 
        ) ,
    NOT(ISPICKVAL({!$Record__Prior.StageName},&apos;4 - Negotiate&apos;))
),
OR(
    ISCHANGED({!$Record.Primary_Product_Line__c}) ,
    ISCHANGED({!$Record.GSA_Eligibility__c}),
    ISCHANGED({!$Record.AccountId})
    ),
OR(
{!$Record.RecordType.DeveloperName}=&apos;Standard_Opportunity&apos;,
{!$Record.RecordType.DeveloperName}=&apos;IMLA_Standard_Opportunity&apos;,
{!$Record.RecordType.DeveloperName}=&apos;IME_Standard_Opportunity&apos;,
{!$Record.RecordType.DeveloperName}=&apos;IMAP_Standard_Opportunity&apos;
)
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
