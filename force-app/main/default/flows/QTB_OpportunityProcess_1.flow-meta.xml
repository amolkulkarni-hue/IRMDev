    <description>Migrated from the QTB_OpportunityProcess process using multiple criteria.
#CPQ-9,#SFCPQBLG-648  This is used for stamping Price book on opportunity based on Opportunity Billing Country, GitLab # 777 - Updating to fire only for CPQ Sales Opportunity RT</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	NOT($Setup.Metadata_Activation_Settings__c.Disable_PB__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c,&apos;Opportunity&apos;))),
	OR(
		ISNEW(),
		ISCHANGED({!$Record.Billing_Country__c} ),
		ISCHANGED({!$Record.CurrencyIsoCode} )
	),
	NOT(ISBLANK({!$Record.Billing_Country__c} )),
	{!$Record.RecordType.DeveloperName=$Label.QTB_OpportunityRecordType_Sales} 
)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	NOT($Setup.Metadata_Activation_Settings__c.Disable_PB__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c,&apos;Opportunity&apos;))),
	NOT(ISNEW()),
	{!$Record.RecordType.Name} = &apos;CPQ Sales Opportunity&apos;,
	ISPICKVAL(PRIORVALUE({!$Record.StageName} ),&apos;5 - Signed/PO in&apos;),
	ISPICKVAL({!$Record.StageName} ,&apos;6 - Setup&apos;),
	NOT(ISBLANK({!$Record.SBQQ__PrimaryQuote__c}))
)</expression>
    </formulas>
