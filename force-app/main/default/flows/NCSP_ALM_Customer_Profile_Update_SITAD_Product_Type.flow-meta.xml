                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Program - SITAD Program</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ALM_OTO_Product_Count</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <label>OTO + Program</label>
        </rules>
