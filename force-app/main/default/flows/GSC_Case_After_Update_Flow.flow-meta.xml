    <formulas>
        <name>ChatterNotification</name>
        <dataType>String</dataType>
        <expression>&apos;#&apos;+{!$Record.Parent.CaseNumber} +&apos;- #&apos;+ {!$Record.CaseNumber} +&apos; has been resolved.&apos;</expression>
    </formulas>
    <formulas>
        <name>Email_Template_Name</name>
        <dataType>String</dataType>
        <expression>&apos;GSC Closure Order &apos;+ TEXT({!$Record.IME_SC_Country__c})+&apos; Email Template&apos;</expression>
    </formulas>
    <formulas>
        <description>Calculate the Reopened Counter when the Case is getting Reopened</description>
        <name>Reopened_Count</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!$Record.GSC_Reopened_Counter__c}), NULLVALUE({!$Record.GSC_Reopened_Counter__c}, 1) , ({!$Record.GSC_Reopened_Counter__c}+1))</expression>
        <scale>0</scale>
    </formulas>
