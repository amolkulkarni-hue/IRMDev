    <formulas>
        <name>Duplicate_Check_Formula</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!Find_Matching_Records.Id})),
  AND(
    {!$Record.QTB_Start_Date__c} == {!Find_Matching_Records.QTB_Start_Date__c},
    {!$Record.QTB_End_Date__c} == {!Find_Matching_Records.QTB_End_Date__c},
    TEXT({!$Record.QTB_Currency_To__c}) == TEXT({!Find_Matching_Records.QTB_Currency_To__c}),
    TEXT({!$Record.QTB_Currency_From__c}) == TEXT({!Find_Matching_Records.QTB_Currency_From__c}),
    TEXT({!$Record.QTB_Tax_Rate_Type__c}) == TEXT({!Find_Matching_Records.QTB_Tax_Rate_Type__c})
  )
)</expression>
    </formulas>
