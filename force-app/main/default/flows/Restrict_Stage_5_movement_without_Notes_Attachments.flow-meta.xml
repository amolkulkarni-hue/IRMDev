    <description>#24445 Make Notes &amp; Attachments mandatory when moving to Stage 5.
#33297 Add bypass to Opp VRs to support manual, bulk ecomm Opp creation - PRJTASK0017641</description>
    <environments>Default</environments>
    <interviewLabel>Restrict {!$Flow.CurrentDateTime}</interviewLabel>
