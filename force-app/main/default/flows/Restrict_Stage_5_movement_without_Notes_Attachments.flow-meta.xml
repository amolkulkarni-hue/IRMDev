    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Attachments</targetReference>
        </connector>
        <filterFormula>AND(
ISCHANGED({!$Record.StageName}),
ISPICKVAL({!$Record.StageName}, &apos;5 - Signed/PO in&apos;),
ISCHANGED({!$Record.IsClosed}),
CASESAFEID({!$Label.IMExpress_Opp_Owner})!={!$Record.OwnerId}

)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
