    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>IsIMLAOppRecordType</name>
        <label>IsNotNAOppRecordType</label>
        <locationX>188</locationX>
        <locationY>28</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>NoIMLAOppRecordType</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Var_OppRecordTypeName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>IMLA Standard Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_OppRecordTypeName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>IMAP Standard Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Var_OppRecordTypeName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>IME Standard Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>opportunityPost</targetReference>
            </connector>
            <label>NoInternationalOppRecordType</label>
        </rules>
    </decisions>
    <interviewLabel>Send Notification to new Opportunity Team Members {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Notification to new Opportunity Team Members</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>MemberNameLookup</name>
        <label>MemberNameLookup</label>
        <locationX>26</locationX>
        <locationY>24</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsIMLAOppRecordType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
