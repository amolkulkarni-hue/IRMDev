    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Instead of formula field using Flow to update the Unit price, getting an below error by using a formula field 
&quot;You have reached the maximum number of 20 unique object references on Credit Note Line&quot; Gitlab #34543</description>
    <environments>Default</environments>
    <formulas>
        <name>InvoiceLineIsBlankFalse</name>
        <dataType>Currency</dataType>
        <expression>    IF(
        ISBLANK({!RelatedInvoiceLineQTBUnitPriceValue}),
        NULL, 
        {!RelatedInvoiceLineQTBUnitPriceValue}
    )</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>InvoiceLineIsBlankTrue</name>
        <dataType>Currency</dataType>
        <expression>IF(
        OR(
            ISBLANK({!$Record.blng__Subtotal__c}), 
            ISBLANK({!$Record.QTB_Credit_Quantity__c}), 
            {!$Record.blng__Subtotal__c} = 0, 
            {!$Record.QTB_Credit_Quantity__c} = 0
        ),
        NULL,
        {!$Record.blng__Subtotal__c} / {!$Record.QTB_Credit_Quantity__c}
    )</expression>
        <scale>6</scale>
    </formulas>
