        <description>Added Decision for story : https://gitlab.com/iron-mountain1/gto/enterprise-platforms/customer-relationship-platform/crm/-/issues/19815</description>
        <name>Bill_Rate_Adjustment_value_Has_Value_or_Zero_or_Null</name>
        <label>Bill Rate Adjustment value Has Value or (Zero or Null)</label>
        <locationX>886</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Set_Using_Contract_Rate_to_True</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Zero Or Null</defaultConnectorLabel>
        <rules>
            <name>Positive_Value_Or_Negative_Value</name>
            <conditionLogic>(1 AND 2) OR (1 AND 3) OR 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Adjustment__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Adjustment__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Adjustment__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Existing_Get_Related_Bill_Codes_Of_the_project</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Using_Contract_Rate_to_False1</targetReference>
            </connector>
            <label>Positive Or Negative Value</label>
        </rules>
    </decisions>
