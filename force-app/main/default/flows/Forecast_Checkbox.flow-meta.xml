<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Forecast_Unchecked_Checked</name>
        <label>Forecast Unchecked/Checked</label>
        <locationX>314</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Forecast_field_Checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IM_Commit_to_Forecast__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Forecast_field_other_than_comit</targetReference>
            </connector>
            <label>Forecast field Checked</label>
        </rules>
        <rules>
            <name>Forecast_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IM_Commit_to_Forecast__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Forecast_checkbox_not_checked</targetReference>
            </connector>
            <label>Forecast Field Unchecked</label>
        </rules>
    </decisions>
    <description>This is to make the forecast field true/false depending on the &apos;Forecast Category&apos;. If the Forecast Category field is &apos;Commit&apos; - The forecast checkbox should be checked.</description>
    <interviewLabel>Forecast Checkbox {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Forecast Checkbox Functionality</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Forecast_checkbox_not_checked</name>
        <label>Forecast checkbox not checked</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ForecastCategoryName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Commit</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>IM_Commit_to_Forecast__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Forecast_field_other_than_comit</name>
        <label>Forecast field other than comit</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ForecastCategoryName</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Commit</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>IM_Commit_to_Forecast__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Forecast_Unchecked_Checked</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Originating_Org__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core</stringValue>
            </value>
        </filters>
        <filters>
            <field>Originating_Org__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Recordtype</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
</Flow>
