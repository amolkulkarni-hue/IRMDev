    <description>Fix to ignore parent case having cases, Process builder invokes flow to set the qualtrics enabled flag for case create and every time its updated. Add Account ID. Removed Billing Country and made changes to ignore the communicator cases</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND((
[Case].RecordType_Name__c = &apos;NAS General Support Case&apos;),
NOT(ISPICKVAL([Case].Origin ,&apos;Communicator&apos;)),
ISNEW() ,
[Case].ParentId = null,
   OR(
      [Case].ContactEmail &lt;&gt; null , 
      [Case].Customer_ID__c &lt;&gt; null
      )
)</stringValue>
