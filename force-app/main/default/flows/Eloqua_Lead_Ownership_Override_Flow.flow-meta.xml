    <decisions>
        <name>Owned_by_Queue_Decision</name>
        <label>Owned by Queue Decision</label>
        <locationX>578</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Owned_by_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Proposed_Owner_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Proposed_User_Details.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Owner</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Owned by Queue</label>
        </rules>
        <rules>
            <name>Owned_by_Active_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OwnedbyActiveUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alert_Owner_of_Proposed_Owner</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Owned by Active User</label>
        </rules>
        <rules>
            <name>Owner_IDInactive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Proposed_Owner_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Proposed_User_Details.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead_Owner_Details.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Owner1</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Owner ID = Inactive</label>
        </rules>
        <rules>
            <name>Proposed_Owner_Lead_Owner_Or_Is_Inactive</name>
            <conditionLogic>(1 AND 2) OR (1 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Proposed_Owner_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Proposed_Owner_ID__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Proposed_User_Details.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Blank_Out_Proposed_Owner_ID4</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Proposed Owner = Lead Owner Or Is Inactive</label>
        </rules>
    </decisions>
    <description>Eloqua will override queue ownership to proposed owner</description>
    <environments>Default</environments>
    <formulas>
        <description>Owned by Active User Formula</description>
        <name>OwnedbyActiveUser</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(BEGINS(PRIORVALUE({!$Record.OwnerId}), &quot;00G&quot;)),NOT(ISBLANK({!$Record.Proposed_Owner_ID__c})),{!$Record.Proposed_Owner_ID__c}&lt;&gt;{!$Record.OwnerId}, {!Get_Proposed_User_Details.IsActive} = TRUE,{!Get_Lead_Owner_Details.IsActive} = TRUE)</expression>
    </formulas>
    <interviewLabel>Eloqua Lead Ownership Override {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Eloqua Lead Ownership Override</label>
