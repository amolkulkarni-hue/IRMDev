        <name>Update_Territory_Country_with_D_B_Country</name>
        <label>Update Territory Country with D&amp;B Country</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>TerritoryCountry_Var</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.DnB_Country__c</elementReference>
            </value>
        </assignmentItems>
