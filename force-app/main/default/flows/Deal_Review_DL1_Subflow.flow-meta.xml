        </rules>
        <rules>
            <name>Equals_to_Account_Segment_GISV</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>input_Deal_Review.Account_Segment_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_Account_Segment</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Approval_Matrix_Record_with_Sub_segment</targetReference>
            </connector>
            <label>Equals to Account Segment GISV</label>
        </rules>
        <rules>
            <name>Region_equals_to_Europe</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>input_Deal_Review.Sales_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_Europe_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>input_Deal_Review.Sales_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_Latin_America_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>input_Deal_Review.Sales_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_Asia_Pacific_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>input_Deal_Review.Sales_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_MENAT_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>input_Deal_Review.Sales_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_India_Region</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Approval_Matrix_Record_with_Billing_Country</targetReference>
            </connector>
            <label>Region equals to Europe or Latin America or Asia or MENAT or India</label>
        </rules>
