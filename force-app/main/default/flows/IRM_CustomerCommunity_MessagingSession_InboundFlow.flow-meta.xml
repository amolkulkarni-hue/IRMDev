    <description>Removed case creation from the inbound flow - #33714
This inbound omni flow is used to create cases, contacts, and messaging users for messaging sessions created when users initiate a messaging request from the community sites and route to the respective bots based on language selection.
+ Latam Portal Condition + UKI Portal Condition + India Condition + Ironmountain.com conditions
#24473 - Updated the Case origin Formula and Chat Queues for APAC region.
#33941 - Updated the Formulas for Iron Mountain Website Chat.</description>
    <environments>Default</environments>
    <formulas>
        <description>Used for updating the name of the messaging user object that is linked to the messaging session object.</description>
        <name>MessagingUserNameFormula</name>
        <dataType>String</dataType>
        <expression>{!FirstName} + &apos; &apos; + {!LastName}</expression>
    </formulas>
    <formulas>
        <description>Utilized for updating the fallback queue when routing is not connected to the enhanced bot.</description>
        <name>QueueFormula</name>
        <dataType>String</dataType>
        <expression>
IF(
    AND(
        {!Get_Messaging_Session_Records.ChannelName} = &quot;IronMountainWebsite Messaging Channel&quot;,
        OR(
            {!SelectLanguage} = &quot;English&quot;,
            {!SelectLanguage} = &quot;English (US)&quot;
        )
    ),
    &quot;Chat_Agents_Service_Team_Queue&quot;,
    IF(
        AND(
            {!Get_Messaging_Session_Records.ChannelName} = &quot;IronMountainWebsite Messaging Channel&quot;,
            {!SelectLanguage} = &quot;French&quot;
        ),
        &quot;NAS_Quebec_Chat&quot;,
        CASE(
            {!SelectLanguage},
            &quot;English&quot;,
            CASE(
                {!CustomerType},
                &quot;Guest&quot;, &quot;IRM_Customer_Community_Chat_Queue&quot;,
                &quot;Authenticated&quot;, &quot;NAS_IMCSS_chat&quot;,
                &quot;IRM_Customer_Community_Chat_Queue&quot;
            ),
            &quot;French&quot;, 
            CASE(
                {!CustomerType},
                &quot;Guest&quot;, &quot;NAS_Quebec_Chat&quot;,
                &quot;Authenticated&quot;, &quot;NAS_Quebec_Chat&quot;,
                &quot;NAS_Quebec_Chat&quot;
            ),
            &quot;Colombia&quot;,&quot;IMLA_COL_Service_Chat&quot;,
            &quot;Argentina&quot;,&quot;IMLA_ARG_Service_Chat&quot;,
            &quot;Brazil&quot;,&quot;IMLA_BRA_Service_Chat&quot;,
            &quot;Mexico&quot;,&quot;IMLA_MEX_Service_Chat&quot;,
            &quot;Peru&quot;,&quot;IMLA_PER_Service_Chat&quot;,
            &quot;Chile&quot;,&quot;IMLA_CHL_Service_Chat&quot;,
            &quot;English (UK)&quot;, &quot;UKI_IMConnect&quot;,
            &quot;English (IN)&quot;, &quot;India_Chat_queue&quot;,
			&quot;English (PH)&quot;, &quot;PHL_Chat&quot;,
			&quot;English (SG)&quot;, &quot;SGP_Chat&quot;,
