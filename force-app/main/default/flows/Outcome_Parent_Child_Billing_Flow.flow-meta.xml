        <filterFormula>AND( NOT({!$Permission.PSA_Restricted_User}),
ISPICKVAL({!$Record.pse__Project__r.pse__Billing_Type__c}, &apos;Outcome&apos;),
NOT({!$Record.Bundle_Bill_Code__c}),
