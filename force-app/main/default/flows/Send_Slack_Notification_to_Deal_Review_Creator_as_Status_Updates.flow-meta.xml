    <decisions>
        <description>Allows different notifications for Approved and Rejected Deal Reviews</description>
        <name>Deal_Review_Status</name>
        <label>Deal Review Status?</label>
        <locationX>440</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Send_Email_Alert_to_Created_By_With_Status_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_SF_Notification_to_Creator_Approved</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
        <rules>
            <name>Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Send_SF_Notification_to_Creator_Rejected</targetReference>
            </connector>
            <label>Rejected</label>
        </rules>
    </decisions>
