<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assignChecklistToCollection</name>
        <label>Build Checklist Record and Append</label>
        <locationX>308</locationX>
        <locationY>648</locationY>
        <assignmentItems>
            <assignToReference>varNewChecklist.Case__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewChecklist.DocumentType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loopExitDocRequirements.Document_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewChecklist.Document_Category__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loopExitDocRequirements.Document_Category__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewChecklist.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewChecklist.IsRequired__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChecklistsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varNewChecklist</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopExitDocRequirements</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>checkRequirementsExist</name>
        <label>Exit Doc Requirements Found?</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <defaultConnectorLabel>No Requirements — End</defaultConnectorLabel>
        <rules>
            <name>requirementsFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExitDocRequirements</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loopExitDocRequirements</targetReference>
            </connector>
            <label>Requirements Found — Loop</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow on Case (After Insert). When a Case is created with a Case_Type__c, looks up active Case_Exit_Doc_Requirement__c config records matching the Case RecordType and Case Type, then bulk-creates Draft Document_Checklist__c records linked to the Case for each matching requirement. These Draft records must reach Final status before the Case can be closed (enforced by Case_Exit_Document_Validation_Flow).</description>
    <label>Case Exit Doc Checklist Creation Flow</label>
    <loops>
        <name>loopExitDocRequirements</name>
        <label>Loop: Exit Doc Requirements</label>
        <locationX>176</locationX>
        <locationY>528</locationY>
        <collectionReference>varExitDocRequirements</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>assignChecklistToCollection</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>createExitDocChecklists</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>createExitDocChecklists</name>
        <label>Create Exit Document Checklists</label>
        <locationX>176</locationX>
        <locationY>648</locationY>
        <inputReference>varChecklistsToCreate</inputReference>
    </recordCreates>
    <recordLookups>
        <name>getExitDocRequirements</name>
        <label>Get Exit Doc Requirements for Case Type</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkRequirementsExist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Record_Type_Dev_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRecordTypeDevName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Case_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case_Type__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case_Exit_Doc_Requirement__c</object>
        <outputReference>varExitDocRequirements</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Document_Type__c</queriedFields>
        <queriedFields>Document_Category__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>getRecordTypeDevName</name>
        <label>Get Case RecordType DeveloperName</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getExitDocRequirements</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RecordTypeId</elementReference>
            </value>
        </filters>
        <filters>
            <field>SObjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Case</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>varRecordTypeDevName</assignToReference>
            <field>DeveloperName</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>getRecordTypeDevName</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Type__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varChecklistsToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Document_Checklist__c</objectType>
    </variables>
    <variables>
        <name>varExitDocRequirements</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case_Exit_Doc_Requirement__c</objectType>
    </variables>
    <variables>
        <name>varNewChecklist</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Document_Checklist__c</objectType>
    </variables>
    <variables>
        <name>varRecordTypeDevName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
