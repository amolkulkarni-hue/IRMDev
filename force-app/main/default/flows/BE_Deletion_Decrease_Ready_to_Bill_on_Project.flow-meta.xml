<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Ready_to_Bill_on_Project</name>
        <label>Check Ready to Bill on Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Ready_to_Bill_is_not_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Project__r.Ready_to_Bill__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Ready_to_bill_on_Project</targetReference>
            </connector>
            <label>Ready to Bill is not 0</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CalculateReadyToBill</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.pse__Project__r.Ready_to_Bill__c} - {!$Record.pse__Summary_Amount__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>BE Deletion - Decrease Ready to Bill on Project {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BE Deletion - Decrease Ready to Bill on Project</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Ready_to_bill_on_Project</name>
        <label>Update Ready to bill on Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Ready_to_Bill__c</field>
            <value>
                <elementReference>CalculateReadyToBill</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.pse__Project__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Ready_to_Bill_on_Project</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>pse__Summary_Amount__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>pse__Billing_Event__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
