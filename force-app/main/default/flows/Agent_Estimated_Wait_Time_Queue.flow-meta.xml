    <decisions>
        <name>Agents_Available_For_Chat</name>
        <label>Agents Available For Chat</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Set_Agent_Availability_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Agents Not Avaialble</defaultConnectorLabel>
        <rules>
            <name>Agents_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numberOfAgentsOnline</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Agent_Availability</targetReference>
            </connector>
            <label>Agents Available</label>
        </rules>
    </decisions>
