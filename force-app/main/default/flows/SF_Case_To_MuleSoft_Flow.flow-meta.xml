                <stringValue>New Deal</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>Billing_Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>USA</stringValue>
            </value>
        </filters>
        <filters>
            <field>Billing_Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Canada</stringValue>
            </value>
        </filters>
        <filters>
            <field>Billing_Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Billing_Contact_Email__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NCSP_Service_line__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>RM</stringValue>
            </value>
        </filters>
        <filters>
            <field>NCSP_Service_line__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Shred</stringValue>
            </value>
        </filters>
        <filters>
            <field>NCSP_Service_line__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>One Time Shred</stringValue>
            </value>
        </filters>
        <filters>
            <field>Customer_ID__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Contract Review</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1180</triggerOrder>
</Flow>
