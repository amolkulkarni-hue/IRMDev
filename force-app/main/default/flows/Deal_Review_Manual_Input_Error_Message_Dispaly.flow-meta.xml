    <decisions>
        <description>Replacing Product Type Logic with Business Unit Logic as per Gitlab-#36824</description>
        <name>Check_Business_Unit</name>
        <label>Check Business Unit</label>
        <locationX>446</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Equals_to_RIM_W_L</name>
            <conditionLogic>(1 OR 4) AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RIM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Dedicated_Capital__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Floor_Revenue_Realization_Percent__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>W&amp;L</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Error_Message_for_Recurring_RM_DM_or_Shred_Deals</targetReference>
            </connector>
            <label>Equals to RIM,W&amp;L</label>
        </rules>
        <rules>
            <name>Equals_to_Other</name>
            <conditionLogic>(1 OR 4 OR 5) AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Digital</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Dedicated_Capital__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Total_Cashview_Margin_Percent__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ALM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MAS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Error_Message_for_Other_type_of_Deals</targetReference>
            </connector>
            <label>Equals to Other</label>
        </rules>
        <rules>
            <name>Having_Inconsistent_values</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Total_Cashview_Margin_Percent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Floor_Revenue_Realization_Percent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Error_Message_for_Deal_Review_with_Inconsistent_Values</targetReference>
            </connector>
            <label>Having  Inconsistent values</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Deal_Type</name>
        <label>Check Deal Type</label>
        <locationX>908</locationX>
        <locationY>623</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Equals_to_New_Deal_or_Up_sell_Lift_or_Framework</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Deal_Type_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-Renewal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Business_Unit</targetReference>
            </connector>
            <label>Equals to New Deal or Up-sell/Lift or Framework</label>
        </rules>
        <rules>
            <name>Equals_to_Renewal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Deal_Type_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Revenue_Dilution_dollar__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Error_Message_for_Renewal_type_of_Deals</targetReference>
            </connector>
            <label>Equals to Renewal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Min_ACV_as_per_Region</name>
        <label>Check Min ACV as per Region</label>
        <locationX>908</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Equals_to_MENAT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_MENAT_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>USDAmount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Set_1_Min_ACV_Value_from_Custom_Label</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Deal_Type</targetReference>
            </connector>
            <label>Equals to MENAT</label>
        </rules>
        <rules>
            <name>Equals_to_INDIA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_India_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>USDAmount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Set_2_Min_ACV_Value_from_Custom_Label</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Deal_Type</targetReference>
            </connector>
            <label>Equals to INDIA</label>
        </rules>
        <rules>
            <name>Equals_to_Asia_Pacific_or_Latin_America</name>
            <conditionLogic>(1 OR 2)  AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_Asia_Pacific_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_Latin_America_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>USDAmount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Set_3_Min_ACV_Value_from_Custom_Label</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Deal_Type</targetReference>
            </connector>
            <label>Equals to Asia Pacific or Latin America</label>
        </rules>
        <rules>
            <name>Equals_to_NA_or_Europe_Region</name>
            <conditionLogic>(1 OR 2)  AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_North_America_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Deal_Review_Europe_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>USDAmount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Set_4_Min_ACV_Value_from_Custom_Label</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Deal_Type</targetReference>
            </connector>
            <label>Equals to NA or Europe Region</label>
        </rules>
    </decisions>
