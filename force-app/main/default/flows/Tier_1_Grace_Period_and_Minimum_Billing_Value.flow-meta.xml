    <description>Merged Tier 2 Grace Period and Minimum % Billing Value 
Merged Update Manager Approval Needed Hidden with Manager Approval Needed? flows functionality into this flow as part of optimization US #35880</description>
    <environments>Default</environments>
    <formulas>
        <name>ManagerApprovalNeeded</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS(TEXT({!$Record.Contract_Type__c}), &apos;Value&apos;),
    IF( ISNUMBER(SUBSTITUTE(TEXT({!$Record.Services_Discount__c} ),&apos;%&apos;,&apos;&apos;)),
        IF( VALUE(SUBSTITUTE(TEXT( {!$Record.Services_Discount__c} ),&apos;%&apos;,&apos;&apos;)) &gt; 31,
            &apos;Yes&apos;,
            &apos;No&apos;
        ),
        &apos;No&apos;
    ),
    IF( ISNUMBER(SUBSTITUTE(TEXT({!$Record.Storage_Discount__c}),&apos;%&apos;,&apos;&apos;)),
        IF( VALUE(SUBSTITUTE(TEXT({!$Record.Storage_Discount__c}),&apos;%&apos;,&apos;&apos;)) &gt; 56,
            &apos;Yes&apos;,
            IF( ISNUMBER(SUBSTITUTE(TEXT( {!$Record.Services_Discount__c} ),&apos;%&apos;,&apos;&apos;)),
                IF( VALUE(SUBSTITUTE(TEXT( {!$Record.Services_Discount__c} ),&apos;%&apos;,&apos;&apos;)) &gt; 56,
                    &apos;Yes&apos;,
                    &apos;No&apos;
                ),
                &apos;No&apos;
            )
        ),
        IF( ISNUMBER(SUBSTITUTE(TEXT( {!$Record.Services_Discount__c} ),&apos;%&apos;,&apos;&apos;)),
			IF( VALUE(SUBSTITUTE(TEXT( {!$Record.Services_Discount__c} ),&apos;%&apos;,&apos;&apos;)) &gt; 56,
				&apos;Yes&apos;,
				&apos;No&apos;
			),
			&apos;No&apos;
		)
    )
)</expression>
    </formulas>
    <formulas>
        <name>TierFormula</name>
        <dataType>String</dataType>
        <expression>IF( {!TotalNewStorageVolumeFormula} &gt; 500, &apos;Tier 2&apos;, &apos;Tier 1&apos;)</expression>
    </formulas>
    <formulas>
