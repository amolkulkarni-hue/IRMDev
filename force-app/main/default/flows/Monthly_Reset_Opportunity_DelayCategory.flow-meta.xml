        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Month_End_Record_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Delay_Category__c</field>
            <operator>IsNull</operator>
