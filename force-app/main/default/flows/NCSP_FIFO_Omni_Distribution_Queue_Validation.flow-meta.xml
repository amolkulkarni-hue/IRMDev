<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Validation_Error</name>
        <label>Validation Error</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <customErrorMessages>
            <errorMessage>Cases can not be pushed to this queue manually , Please add NCSP service line and push cases to NCSP FIFO First in First Out queue to route case through Omni.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description>Gitlab - #22165,26419 Validation to restrict users from adding cases to NCSP FIFO Omni Distribution Queue</description>
    <environments>Default</environments>
    <interviewLabel>NCSP FIFO {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NCSP FIFO Omni Distribution Queue Validation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Validation_Error</targetReference>
        </connector>
        <filterFormula>AND ({!$Record.OwnerId} ={!$Label.NCSP_FIFO_Omni_Distribution_Queue_18Id},OR ({!$Record__Prior.OwnerId} &lt;&gt; {!$Label.NCSP_FIFO_First_in_First_out_18Id} ,ISBLANK(TEXT({!$Record.NCSP_Team__c}))))</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
