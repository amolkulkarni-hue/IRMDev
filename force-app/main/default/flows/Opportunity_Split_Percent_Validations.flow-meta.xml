<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This block totals the Split percentage assigned to the user</description>
        <name>Total_Split_Percent</name>
        <label>Total Split Percent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SplitTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Iterate_through_Split_records_of_User.SplitPercentage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_through_Split_records_of_User</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <description>Filter the Split records owned by the user present on the triggered Split record</description>
        <name>Get_all_the_split_records_related_to_user</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Get all the split records related to user</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Get_all_the_split_records_related_to_user</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Remaining_Split_Records</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Get_all_the_split_records_related_to_user.SplitOwnerId</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>$Record.SplitOwnerId</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Iterate_through_Split_records_of_User</targetReference>
        </connector>
    </collectionProcessors>
    <customErrors>
        <description>A single user cannot have Split percent above 100</description>
        <name>Split_Percent_can_t_be_above_100</name>
        <label>Split Percent can&apos;t be above 100</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>A single user cannot have Split percent above 100</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <description>A single user cannot have Split percent above 100 when Opportunity ownership is changed</description>
        <name>Split_Percent_can_t_be_above_100_on_Owner_change</name>
        <label>Split Percent can&apos;t be above 100 on Owner change</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>To change the Owner of this Opportunity, please update the Split records first. A single user cannot exceed 100% Split.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Checks if  this flow is triggered due to Ownership change , if yes, executes Owner change path else runs default outcome</description>
        <name>Is_ownership_changed</name>
        <label>Is ownership changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Split_Percent_can_t_be_above_100</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Owner_change</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OwnershipChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Split_Percent_can_t_be_above_100_on_Owner_change</targetReference>
            </connector>
            <label>Owner change</label>
        </rules>
    </decisions>
    <decisions>
        <description>CHeck if the total Split percent assigned to the user is above 100 or not. If yes, runs Yes path else flow ends</description>
        <name>Is_Split_Total_above_100</name>
        <label>Is Split Total above 100?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SplitTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>100.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_ownership_changed</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>#30405: Opportunity Split Users can only have 100% Split value between the Revenue &amp; Overlay Split Types - RITM1011487
A single user cannot have more than 100 Split share including Overlay and Revenue</description>
    <environments>Default</environments>
    <formulas>
        <description>Checks if owner is changed on Opportunity</description>
        <name>OwnershipChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Opportunity.OwnerId})</expression>
    </formulas>
    <interviewLabel>Opportunity Split Percent Validations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Split Percent Validations</label>
    <loops>
        <description>Iterates through the split records owned by the user of the Triggering split record</description>
        <name>Iterate_through_Split_records_of_User</name>
        <label>Iterate through Split records of User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_all_the_split_records_related_to_user</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Total_Split_Percent</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Is_Split_Total_above_100</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>This block fetches the remaining split records of the Opportunity</description>
        <name>Get_Remaining_Split_Records</name>
        <label>Get Remaining Split Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_all_the_split_records_related_to_user</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunitySplit</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Remaining_Split_Records</targetReference>
        </connector>
        <filterFormula>OR(
ISNEW(),
ISCHANGED({!$Record.SplitPercentage}))</filterFormula>
        <object>OpportunitySplit</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Get_all_the_split_records_related_to_user</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunitySplit</objectType>
    </variables>
    <variables>
        <name>currentItem_Revenue_Split_Records</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunitySplit</objectType>
    </variables>
    <variables>
        <name>SplitTotal</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>TotalRevenuePercent</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
