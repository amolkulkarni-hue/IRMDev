<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Completed_Project_Cannot_be_Edited_only_L3</name>
        <label>Completed Project Cannot be Edited, only L3</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <customErrorMessages>
            <errorMessage>Project is in &apos;Completed&apos; Stage so that fields are not editable.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description>We can&apos;t create a validation rule to prevent updating the Completed project because of the PSA Managed package Project Trigger. SO created this flow.</description>
    <environments>Default</environments>
    <formulas>
        <name>for_ProfileID</name>
        <dataType>String</dataType>
        <expression>LEFT({!profileID}, LEN({!profileID}) - 3)</expression>
    </formulas>
    <interviewLabel>PM can&apos;t blank &amp; Completed project not editable {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Completed project not editable</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Completed_Project_Cannot_be_Edited_only_L3</targetReference>
        </connector>
        <filterFormula>AND(ISPICKVAL({!$Record.pse__Stage__c}, &apos;Completed&apos;),{!$Permission.PSA_Admin_User} = False)</filterFormula>
        <object>pse__Proj__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>600</triggerOrder>
    <variables>
        <name>profileID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
