    <recordLookups>
        <description>Getting all the Deal Review records associated to the opportunity</description>
        <name>Get_total_Deal_review_Records_of_Opportunity</name>
        <label>Get total  Deal review Records of Opportunity</label>
        <locationX>1150</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_DR_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>Deal_Review__c</object>
        <outputReference>DRcollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
        <queriedFields>Deal_Review_Expired__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <description>Update the Deal Review Accepted field on opportunity</description>
        <name>Update_Opportunity_Record</name>
        <label>Update Opportunity Record</label>
        <locationX>50</locationX>
        <locationY>1103</locationY>
        <inputAssignments>
            <field>Deal_Review_Accepted__c</field>
            <value>
                <elementReference>ApprovedDRRecord.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>1024</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_total_Deal_review_Records_of_Opportunity</targetReference>
        </connector>
        <filterFormula>AND(
NOT({!$Setup.Metadata_Activation_Settings__c.Disable_VR__c} &amp;&amp; OR(ISBLANK({!$Setup.Metadata_Activation_Settings__c.SObject_API_Name__c}),
CONTAINS({!$Setup.Metadata_Activation_Settings__c.SObject_API_Name__c}, &apos;Opportunity&apos;))),
{!$Record.OwnerId} !={!$Label.IMExpress_Opp_Owner},
OR(
	ISPICKVAL({!$Record.StageName}, &apos;5 - Signed/PO in&apos;),
       AND
       ( 
         ISPICKVAL({!$Record.StageName}, &apos;4 - Negotiate&apos;),
         DATEVALUE({!$Record.CreatedDate}) &gt;= DATEVALUE({!$Label.Opty_Createddate_Stage_4_or_5_Validation})
         )       
),
OR
(
ISPICKVAL({!$Record.Type}, &apos;Up-Sell/Lift&apos;),
ISPICKVAL({!$Record.Type}, &apos;New Deal&apos;),
ISPICKVAL({!$Record.Type}, &apos;Renewal&apos;),
ISPICKVAL({!$Record.Type}, &apos;Framework&apos;)
),
ISBLANK({!$Record.Deal_Review_Accepted__c}),
OR
(
ISPICKVAL({!$Record.Billing_Country__r.Region__c},&apos;North America&apos;),
AND
(
ISPICKVAL({!$Record.Billing_Country__r.Region__c},&apos;Europe&apos;),
DATEVALUE({!$Record.CreatedDate}) &gt;= DATEVALUE({!$Label.Opp_Created_Date_Europe})
),
AND
(
NOT(ISPICKVAL({!$Record.Billing_Country__r.Region__c},&apos;North America&apos;)),
NOT(ISPICKVAL({!$Record.Billing_Country__r.Region__c},&apos;Europe&apos;)),
DATEVALUE({!$Record.CreatedDate}) &gt;= DATEVALUE({!$Label.Opportunity_Created_Date})
)
),
CONTAINS({!$Record.RecordType.DeveloperName},&quot;Standard_Opportunity&quot;)
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
