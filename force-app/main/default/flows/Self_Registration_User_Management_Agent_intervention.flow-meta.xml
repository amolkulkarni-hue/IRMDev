    <formulas>
        <description>This formula combines the last name of a contact and the current date. It then extracts the leftmost 8 characters from the resulting text. The final output of the formula is a text string containing the first 8 characters of the combined text.</description>
        <name>Alias</name>
        <dataType>String</dataType>
        <expression>LEFT({!GetContactDetails.LastName} + TEXT({!$Flow.CurrentDate}), 8)</expression>
    </formulas>
    <formulas>
        <name>fUserNameWithDomain</name>
        <dataType>String</dataType>
        <expression>LEFT({!GetContactDetails.Email}, FIND(&apos;@&apos;, {!GetContactDetails.Email}) - 1) + &apos;.&apos; + MID({!GetContactDetails.Email}, FIND(&apos;@&apos;, {!GetContactDetails.Email}) + 1, FIND(&apos;.&apos;, MID({!GetContactDetails.Email}, FIND(&apos;@&apos;, {!GetContactDetails.Email}) + 1, LEN({!GetContactDetails.Email}))) - 1) + &apos;@ironmountain.exp&apos;</expression>
    </formulas>
    <formulas>
        <name>Username</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!GetContactDetails.Email}, RIGHT({!GetContactDetails.Email}, LEN({!GetContactDetails.Email}) - FIND(&apos;@&apos;, {!GetContactDetails.Email})), &apos;ironmountain.exp&apos;)</expression>
    </formulas>
