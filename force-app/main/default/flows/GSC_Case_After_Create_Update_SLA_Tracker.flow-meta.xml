    <formulas>
        <description>Convert the Total Duration into Days Hours Minutes Seconds for Status = Assigned</description>
        <name>Total_Assigned_Duration</name>
        <dataType>String</dataType>
        <expression>TEXT(FLOOR( {!$Record.GSC_Assigned_Duration__c} / (24 * 3600))) &amp;&apos; Days &apos;
&amp; TEXT(FLOOR(MOD({!$Record.GSC_Assigned_Duration__c},(2.4 * 3600) )  / 3600)) &amp;&apos; Hours &apos;
&amp; TEXT(FLOOR((MOD((MOD({!$Record.GSC_Assigned_Duration__c},(24 * 3600) )), 3600 ))/60))&amp;&apos; Minutes &apos; 
&amp; TEXT(FLOOR((MOD((MOD((MOD({!$Record.GSC_Assigned_Duration__c},(24 * 3600))),3600)),60))))&amp;&apos; Seconds &apos;</expression>
    </formulas>
