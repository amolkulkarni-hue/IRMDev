    <description>Sends outbound email message with ability for user to add additional notes. Message sent to each email address in a semi-colon delimeted list.</description>
    <label>Send Outbound Email</label>
    <processType>Flow</processType>
    <screens>
        <name>Enter_Notes</name>
        <label>Enter Notes</label>
        <locationX>664</locationX>
        <locationY>163</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>InitializeNotes</targetReference>
        </connector>
        <fields>
            <name>dtViewTemplate</name>
            <fieldText>&lt;b&gt;To: &lt;/b&gt;&lt;em&gt;{!vInputEmail}&lt;/em&gt;
&lt;b&gt;Subject: &lt;/b&gt;&lt;em&gt;{!vSubject}&lt;/em&gt;
{!vBody}</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>fldNotes</name>
            <fieldText>Add Additional Notes:</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <helpText>Notes appear italicized and will be located at the end of the above email template.</helpText>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <helpText>Clicking next will send outbound email to: &lt;b&gt;{!vInputEmail}&lt;/b&gt;.&lt;br /&gt;This action cannot be undone once &lt;b&gt;Next&lt;/b&gt; is clicked.</helpText>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
