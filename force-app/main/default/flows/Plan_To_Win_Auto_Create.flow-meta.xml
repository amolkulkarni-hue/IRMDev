<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Are_there_any_existing_plan_to_win_records</name>
        <label>Are there any existing plan to win records?</label>
        <locationX>314</locationX>
        <locationY>839</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Records_Does_not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ListOfPlantoWinRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AmountinUSD</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>750000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Plan_To_Win_Record</targetReference>
            </connector>
            <label>Records Does not exist</label>
        </rules>
        <rules>
            <name>Records_exist</name>
            <conditionLogic>1 AND (2 OR 3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Plan_to_Win_records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Description</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IM_Technical_Summary__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IM_Sales_Event__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Brief_Account_History__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_existing_Plan_to_Win_records</targetReference>
            </connector>
            <label>Records exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_for_IMGA_Account</name>
        <label>Check for IMGA Account</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>GetPlanToWinRecordTypeId</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>IMGA Account Does Not Exist</defaultConnectorLabel>
        <rules>
            <name>IMGA_Account_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.IMGA_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IMGA_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_IMGA_Account</targetReference>
            </connector>
            <label>IMGA Account Exists</label>
        </rules>
    </decisions>
    <description>To automate Plan to Win record creation when Opportunity Amount is greater than 1 million USD. Record will not be created if there exists a record already. 
Gitlab story: 13552

#13881:Plan to Win: Create Sales Play field and Brief Account History

#18809 Updating the amount cutoff from 1M USD to 750K USD

#22895 Updating the IMGA Account field on Opportunity to populate it on Deal Review</description>
    <environments>Default</environments>
    <formulas>
        <description>Convert the opportunity amount to USD</description>
        <name>AmountinUSD</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Amount}/CURRENCYRATE(TEXT({!$Record.CurrencyIsoCode}))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Plan To Win Auto Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Plan To Win Auto Create</label>
