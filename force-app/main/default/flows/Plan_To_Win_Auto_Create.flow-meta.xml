    <recordLookups>
        <description>Fetch the existing Plan to Win records tied to the triggered opportunity</description>
        <name>Get_Existing_Plan_to_Win_records</name>
        <label>Get Existing Plan to Win records</label>
        <locationX>314</locationX>
        <locationY>731</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Are_there_any_existing_plan_to_win_records</targetReference>
