                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>Opportunity_Plan__c</object>
        <outputReference>ListOfPlantoWinRecords</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
