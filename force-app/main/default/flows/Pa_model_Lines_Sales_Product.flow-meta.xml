<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if there exists a Billcode map related to the Product on Schedule A Quote item</description>
        <name>Is_Billcode_Map_present</name>
        <label>Is Billcode Map present?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_SFDC_Product</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sales_Product</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>To populate Sales Product and Sales product code on Schedule A Quote Items using the Billcode map table
#18338</description>
    <environments>Default</environments>
    <interviewLabel>PA Model Lines {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PA model Lines Sales Product</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Fetch the Sales product from Bill code map table using the Product id on Schedule A Quote item</description>
        <name>Get_SFDC_Product</name>
        <label>Get SFDC Product</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Billcode_Map_present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Follower_Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Product__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Leader_Follower_Mapping__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Stamp Sales Product and Sales product code onto Schedule A Quote Item</description>
        <name>Update_Sales_Product</name>
        <label>Update Sales Product</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>Sales_Product_Code__c</field>
            <value>
                <elementReference>Get_SFDC_Product.Leader_Product__r.ProductCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sales_Product__c</field>
            <value>
                <elementReference>Get_SFDC_Product.Leader_Product__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_SFDC_Product</targetReference>
        </connector>
        <object>Schedule_A_Quote_Item__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
