    <description>GitLab #30581 - added logic to check if related account owner is Government user for Manual and Automated AM Surveys</description>
    <environments>Default</environments>
    <formulas>
        <name>CaseSurveyInvitationName</name>
        <dataType>String</dataType>
        <expression>{!SurveyName} + &apos; &apos; + {!CaseSubject.CaseNumber} + &apos; &apos; + &quot;Invitation&quot;</expression>
    </formulas>
    <formulas>
        <name>EmailDomain</name>
        <dataType>String</dataType>
        <expression>LEFT(RIGHT({!Email}, LEN({!Email}) - FIND(&apos;@&apos;, {!Email})), LEN(RIGHT({!Email}, LEN({!Email}) - FIND(&apos;@&apos;, {!Email}))) - 4)</expression>
    </formulas>
    <formulas>
        <name>EventSubject</name>
        <dataType>String</dataType>
        <expression>&apos;Subject: &apos; + {!EventObj.Subject} + &apos; Date: &apos; + TEXT({!EventObj.StartDateTime})</expression>
    </formulas>
    <formulas>
        <name>EventSurveyInvitationName</name>
        <dataType>String</dataType>
        <expression>{!SurveyName}</expression>
    </formulas>
    <formulas>
        <name>eventURLvar</name>
        <dataType>String</dataType>
        <expression>{!$Label.BaseURLstartingPart} + {!EventObj.Id} + {!$Label.BaseURLendingPart}</expression>
    </formulas>
    <formulas>
        <name>ExpirationDate</name>
        <dataType>Date</dataType>
        <expression>NOW() + 7</expression>
    </formulas>
    <formulas>
        <description>GitLab #30581 - check if account owner is Government user for Manual and Automated AM Surveys</description>
        <name>IsGovernmentAccount</name>
        <dataType>Boolean</dataType>
        <expression>IF({!get_Account_record_for_Manual_AM_Survey.Owner.Id} == {!$Label.US_Government_Member_User_Id} || {!get_Account_record_for_Automated_AM_Survey.Owner.Id} == {!$Label.US_Government_Member_User_Id}, true, false)</expression>
    </formulas>
    <formulas>
        <name>ManagerFullName</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} + &apos; &apos; + {!$User.LastName}</expression>
    </formulas>
    <formulas>
        <name>MeetingClosureSurveyInvitationName</name>
        <dataType>String</dataType>
        <expression>{!SurveyName}</expression>
    </formulas>
    <formulas>
        <name>SendSurveySurveyInvitationName</name>
        <dataType>String</dataType>
        <expression>{!SurveyName} + &apos; &apos; + {!SendSurveySubject.Order_Number__c} + &apos; &apos; + &quot;Invitation&quot;</expression>
    </formulas>
    <formulas>
        <name>todayMinusThirtyDays</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 30</expression>
    </formulas>
