    <description>This flow is used for updating the Call_Experience_Validation__c field which then prevents the creation/linking of call experience records consisting of the same DTMF_Option__c value to the same Language_Setup record.</description>
    <environments>Default</environments>
    <formulas>
        <name>FirstValueFor_Call_Experience_Validation</name>
        <dataType>String</dataType>
        <expression>{!$Record.Language_Setup__r.Id} + TEXT({!$Record.DTMF_Option__c})</expression>
    </formulas>
    <formulas>
        <name>SecondValueFor_Call_Experience_Validation</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Language_Setup__r.Id}, 15) + TEXT({!$Record.DTMF_Option__c})</expression>
    </formulas>
    <interviewLabel>Call Experience Validation Flow {!$Flow.CurrentDateTime}</interviewLabel>
