<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>51.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>ListofList</name>
        <label>ListofList</label>
        <locationX>649</locationX>
        <locationY>703</locationY>
        <assignmentItems>
            <assignToReference>Output</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>KBOutput_Record</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>sucess</name>
        <label>sucess</label>
        <locationX>558</locationX>
        <locationY>319</locationY>
        <assignmentItems>
            <assignToReference>KBOutput_Record</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_All_records</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Varcount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>KBOutput_Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>KBRecordLimit</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check the KnowledgeBase articles</description>
        <name>Check_KnowledgeBase</name>
        <label>Check KnowledgeBase</label>
        <locationX>1160</locationX>
        <locationY>248</locationY>
        <defaultConnector>
            <targetReference>Loop_All_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Articles_Found</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Title_LwrCase</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>InputValue_Lwrcase</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Answer_LwrCase</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>InputValue_Lwrcase</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Question_Lwrcase</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>InputValue_Lwrcase</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>sucess</targetReference>
            </connector>
            <label>Articles Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Records to fetch up to 3</description>
        <name>KBRecordLimit</name>
        <label>KBRecordLimit</label>
        <locationX>18</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Loop_All_records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Exist_loop_for_3_records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Varcount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ListofList</targetReference>
            </connector>
            <label>Exist loop for 3 records</label>
        </rules>
    </decisions>
    <description>Knowledge Articles Language base.</description>
    <formulas>
        <name>Answer_LwrCase</name>
        <dataType>String</dataType>
        <expression>Lower({!Loop_All_records.Answer__c})</expression>
    </formulas>
    <formulas>
        <name>InputValue_Lwrcase</name>
        <dataType>String</dataType>
        <expression>Lower({!InputText})</expression>
    </formulas>
    <formulas>
        <name>Question_Lwrcase</name>
        <dataType>String</dataType>
        <expression>Lower({!Loop_All_records.Question__c})</expression>
    </formulas>
    <formulas>
        <name>Title_LwrCase</name>
        <dataType>String</dataType>
        <expression>Lower({!Loop_All_records.Title})</expression>
    </formulas>
    <interviewLabel>KnowledgeBase {!$Flow.CurrentDateTime}</interviewLabel>
    <label>KnowledgeBase_Bot</label>
    <loops>
        <name>Loop_All_records</name>
        <label>Loop All records</label>
        <locationX>656</locationX>
        <locationY>93</locationY>
        <collectionReference>Get_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_KnowledgeBase</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>ListofList</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Records</name>
        <label>Get Records</label>
        <locationX>458</locationX>
        <locationY>54</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_All_records</targetReference>
        </connector>
        <filterLogic>(1 OR 2)  AND 3 AND 4</filterLogic>
        <filters>
            <field>IsVisibleInPkb</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsVisibleInCsp</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Language</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>SelectedLanguage</elementReference>
            </value>
        </filters>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Knowledge__kav</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Records</targetReference>
        </connector>
    </start>
