        <scale>0</scale>
    </formulas>
    <formulas>
        <description>record Substitute Variable</description>
        <name>recordSubstituteVariable</name>
        <dataType>String</dataType>
        <expression>RIGHT({!Loop_1.QTB_Legal_Entity_Number__c}, LEN({!Loop_1.QTB_Legal_Entity_Number__c}) - FIND(&apos;,&apos;, {!Loop_1.QTB_Legal_Entity_Number__c}))</expression>
    </formulas>
    <formulas>
        <description>Split Variable</description>
        <name>SplitVariable</name>
        <dataType>String</dataType>
        <expression>LEFT({!Loop_1.QTB_Legal_Entity_Number__c}, FIND(&apos;,&apos;, {!Loop_1.QTB_Legal_Entity_Number__c})-1)</expression>
    </formulas>
