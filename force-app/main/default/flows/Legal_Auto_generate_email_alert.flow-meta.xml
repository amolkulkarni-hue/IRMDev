    <textTemplates>
        <name>CorporateRequestAssigned</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Hello {!$Record.Owner:User.FirstName},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Your Legal Corporate Request #: {!$Record.Request_Number__c} has been assigned and you can find more details via this link:&amp;nbsp;{!$Record.Id}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);&quot;&gt;Please note our SLAs for the following agreement types:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);&quot;&gt;* First Draft for an IM-5000 -- 5 Business Days.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);&quot;&gt;* First Draft for an MSA on Iron Mountain’s paper -- 8 Business Days.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);&quot;&gt;* For all other requests, the lawyer or paralegal&amp;nbsp;assigned will provide you the expected first response time.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Subject: {!$Record.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Assigned to: {!$Record.Owner:User.FirstName}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Estimated Complete Date: &lt;/span&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: transparent;&quot;&gt;see above SLA’s&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Request Description: {!$Record.Request_Description__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Opportunity: {!$Record.Related_Opportunity__r.Id}{!$Record.Related_Opportunity__r.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Customer, Vendor, Party or Target Name: {!$Record.Vendor_Name__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Thank you,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri, sans-serif; color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;Commercial Legal Department – IMNA&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Emailbodyline</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello {!$Record.Requestor_s_Name__c},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you for submitting your Legal Corporate Request. Your request is currently in the Legal Department Queue awaiting assignment. &lt;/p&gt;&lt;p&gt;Please note that IM-5000s/IMCC-5000s, and MSAs on Iron Mountain’s paper will be assigned within 5 business days. All other request types will be assigned as soon as possible.&lt;/p&gt;&lt;p&gt;Please note that the SLA clock begins when all information and approvals required for Legal review are attached to the Corporate Request&lt;/p&gt;&lt;p&gt;* This includes a signed copy of the customer’s existing agreement, including all previously-signed amendments to that agreement. &lt;/p&gt;&lt;p&gt;* This includes all business approvals for the requested business changes to the agreement. The Global Commercial Contracts Support teams (ContractsUSRIM@ironmountain.com or ContractsProgramsOffice@ironmountain.com can assist you in obtaining this information.  For future reference, you can start your request with those teams and they can submit it into Salesforce for you.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Once your request is assigned, a subsequent email will be sent, advising you of the estimated completion date.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Request #: {!$Record.Request_Number__c}&lt;/p&gt;&lt;p&gt;Request Subject: {!$Record.Name}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you,&lt;/p&gt;&lt;p&gt;Commercial Legal Department – IMNA&lt;/p&gt;</text>
    </textTemplates>
