    <formulas>
        <name>EmailSignature</name>
        <dataType>String</dataType>
        <expression>{!EmailSignature1}+{!InvitationLinkWithLanguageCode}+{!EmailSignature5}+{!$Label.Support_Experience_Survey_Link}+{!EmailSignature3}  +&apos;&lt;br&gt;&apos;+

{!EmailSignature1}+{!InvitationLinkWithLanguageCode}+{!EmailSignature2}+{!Get_Records_Type_Metadata.Additional_Configs__c}+{!EmailSignature4}</expression>
