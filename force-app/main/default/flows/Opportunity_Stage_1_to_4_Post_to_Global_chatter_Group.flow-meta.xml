    <description>Case# 06830598- The Chatter post should be posted only when the Opportunity is created and it should not trigger when someone edits the Opportunity later</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
	NOT($Setup.Metadata_Activation_Settings__c.Disable_PB__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Opportunity&apos;))), 
	NOT(ISBLANK([Opportunity].AccountId ) ),
	NOT(ISBLANK([Opportunity].Account.IM_IMGA_Indexed__c ) ),
	OR(
		ISPICKVAL([Opportunity].Type , &apos;New Deal&apos;),
		ISPICKVAL([Opportunity].Type , &apos;Up-Sell/Lift&apos;) 
	) 
	,OR(
		ISPICKVAL([Opportunity].StageName , &apos;1 -Qualification&apos;),
		ISPICKVAL([Opportunity].StageName , &apos;2 - Solution Developed&apos;), 
		ISPICKVAL([Opportunity].StageName , &apos;3 - SolutionAgreed&apos;),
		ISPICKVAL([Opportunity].StageName , &apos;4 - Negotiate&apos;)
	), 
	[Opportunity].Amount&gt;=30000, 
	[Opportunity].Global_Chatter__c =True
)</stringValue>
            </value>
        </processMetadataValues>
