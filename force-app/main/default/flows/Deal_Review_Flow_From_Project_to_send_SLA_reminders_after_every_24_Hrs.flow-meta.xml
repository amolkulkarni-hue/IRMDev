    <formulas>
        <name>RecordLink</name>
        <dataType>String</dataType>
        <expression>LEFT($Api.Partner_Server_URL_260, FIND(&quot;/services&quot;, $Api.Partner_Server_URL_260)) &amp; &quot;/&quot; &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>ReminderTime</name>
        <dataType>Boolean</dataType>
        <expression>NOW()-{!$Record.CreatedDate}&gt;=1</expression>
    </formulas>
