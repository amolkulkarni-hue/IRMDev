    <decisions>
        <description>Changed from China to Straits GitLab# 32719</description>
        <name>New_Accont_Transfer_to_System_ID</name>
        <label>New Accont Transfer  to System ID</label>
        <locationX>710</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_transfer_to_Straits_Member</name>
            <conditionLogic>(1 AND (2 OR 3 OR 4)) OR (5  AND (6 OR 7 OR 8 OR 10 OR 11 OR 12)) OR  (9  AND (6 OR 7 OR 8 OR 10 OR 11 OR 12))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BillingCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hong Kong</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BillingCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>China</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BillingCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Macau</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>QTB_Billing_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QTB_Legal_Entity_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hong Kong</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QTB_Legal_Entity_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>China</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QTB_Legal_Entity_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Macau</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Operational_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_country_from_contract_legal_entity.Legal_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hong Kong</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_country_from_contract_legal_entity.Legal_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>China</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_country_from_contract_legal_entity.Legal_Country__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Macau</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Straits_Member_ID</targetReference>
            </connector>
            <label>Account transfer to Straits Member</label>
        </rules>
        <rules>
            <name>New_Accounts_Transfer_IMAP_Ownership_to_System_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>IMAP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IMAP_Migration_ID</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>New Accounts Transfer IMAP Ownership to System ID</label>
        </rules>
        <rules>
            <name>New_Accounts_Transfer_IMLA_Ownership_to_System_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>IMLA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IMLA_Migration_ID</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>New Accounts Transfer IMLA Ownership to System ID</label>
        </rules>
        <rules>
            <name>New_Accounts_Transfer_Ownership_to_System_ID</name>
            <conditionLogic>NOT (1 OR 2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>IMLTD</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IMAP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IMLA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ISNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Iron_Mountain_Migration_ID</targetReference>
            </connector>
            <label>New Accounts Transfer Ownership to System ID</label>
        </rules>
        <rules>
            <name>Account_Segment_is_USGS_and_SubSegment_is_Federal_US_or_SLED</name>
            <conditionLogic>1 AND (2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>USGS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Sub_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Federal-US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Sub_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SLED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>005Hr00000HI0vkIAD</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>US_Government_Member_Id</targetReference>
            </connector>
            <label>Account Segment is USGS and SubSegment is Federal-US or SLED</label>
        </rules>
    </decisions>
    <description>This is single flow for 3 workflows whose Account transfer ownership to System ID, #22938
New Accounts Transfer Ownership to System ID	
New Accounts Transfer IMAP Ownership to System ID	
New Accounts Transfer IMLA Ownership to System ID

#32719, added the conditions for all the Straits Member (earlier it was only China)</description>
