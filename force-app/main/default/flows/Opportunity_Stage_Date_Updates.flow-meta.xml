    <formulas>
        <description>To decide the ALM band based on ALM BU</description>
        <name>ALM_Band</name>
        <dataType>String</dataType>
        <expression>IF({!Total_ALM_Converted}==0,&quot;Band 0&quot;,
IF(AND({!Total_ALM_Converted}&gt; 0 ,{!Total_ALM_Converted}&lt;5000), &quot;Band 1&quot;,
     IF(AND({!Total_ALM_Converted}&gt;=5000 ,{!Total_ALM_Converted}&lt;25000),  &quot;Band 2&quot;,
          IF(AND({!Total_ALM_Converted}&gt;=25000 ,{!Total_ALM_Converted}&lt;100000), &quot;Band 3&quot;,
              IF(AND({!Total_ALM_Converted}&gt;=100000, {!Total_ALM_Converted}&lt;250000), &quot;Band 4&quot;,
                   IF(AND({!Total_ALM_Converted}&gt;=250000,{!Total_ALM_Converted}&lt;500000), &quot;Band 5&quot;,
                       IF(AND({!Total_ALM_Converted}&gt;=500000 , {!Total_ALM_Converted}&lt;1000000),&quot;Band 6&quot;,
                                 &quot;Band 7&quot;
)))))))</expression>
    </formulas>
