    <description>Updates the Last Touch Sequence and the Attributed Finished Sequence fields when Opportunity is created w a Contact Role</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
NOT($Setup.OutreachProcessBuilderUserBypass__c.ByPass_the_Integration_User__c),
[OpportunityContactRole].IsPrimary = False,
ISBLANK([OpportunityContactRole].Opportunity.Outreach_Attributed_Finished_Sequences__c ) 
) </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT({!$Setup.OutreachProcessBuilderUserBypass__c.ByPass_the_Integration_User__c}),
{!myVariable_current.IsPrimary} = False,
ISBLANK({!myVariable_current.Opportunity.Outreach_Attributed_Finished_Sequences__c} ) 
)</expression>
    </formulas>
    <formulas>
