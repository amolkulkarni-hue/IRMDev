    <formulas>
        <name>CheckLOBAndRegion</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    AND(
        {!$Record.pse__Practice__r.Name} = &apos;Media &amp; Archive Services&apos;,
        OR(
            ISPICKVAL({!$Record.Billing_Country__c}, &apos;Canada&apos;),
            ISPICKVAL({!$Record.Billing_Country__c}, &apos;United States&apos;)
        )
    ),
    TRUE,
    FALSE
)</expression>
    </formulas>
    <formulas>
        <name>LOBDigital</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    AND(
        {!$Record.pse__Practice__r.Name} = &apos;Digital Solutions&apos;,
        OR(
           ISPICKVAL({!$Record.Billing_Country__c}, &apos;Jordan&apos;),
            ISPICKVAL({!$Record.Billing_Country__c}, &apos;United Arab Emirates&apos;)
        )
    ),
    True,
    False
)</expression>
    </formulas>
