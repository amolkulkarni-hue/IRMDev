<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if Case or Booking Verification</description>
        <name>Check_if_Case_or_Booking_Verification</name>
        <label>Check if Case or Booking Verification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getNonFinalDocsForCase</targetReference>
            </connector>
            <label>Case</label>
        </rules>
        <rules>
            <name>BV</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Booking_Verification_Checklist__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final</stringValue>
                </rightValue>
            </conditions>
            <label>BV</label>
        </rules>
    </decisions>
    <decisions>
        <name>Sync_BV_Item_Check</name>
        <label>BV Item Needs System Validated Sync?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference
      >Check_if_Case_or_Booking_Verification</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Sync Needed</defaultConnectorLabel>
        <rules>
            <name>Linked_And_Relevant_Change</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Booking_Verification_Checklist_Item__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>itemSyncNeeded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateBVItemSystemValidated</targetReference>
            </connector>
            <label>Linked And Relevant Change</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkNonFinalDocs</name>
        <label>Any Non-Final Docs for Case?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>updateParentCaseFalse</targetReference>
        </defaultConnector>
        <defaultConnectorLabel
    >Non-Final Docs Exist — Set False</defaultConnectorLabel>
        <rules>
            <name>noNonFinalDocs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNonFinalDocs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateParentCaseTrue</targetReference>
            </connector>
            <label>No Non-Final Docs — Set True</label>
        </rules>
    </decisions>
    <description
  >Record-Triggered After Save flow on Document_Checklist__c (Create and Update). Fires when Status__c changes and Case__c is not null. Queries for any non-Final exit docs on the parent Case (Case_Creation_Rule__c is null — excludes the Case-first &quot;start&quot;/&quot;required for case&quot; checklists CaseCreationRuleEvaluatorAction links via Case__c, which have their own All_Start_Docs_Final__c indicator maintained by Case_Creation_Trigger_Flow). If none exist, sets All_Exit_Docs_Final__c = true on the Case; otherwise sets it to false. This triggers Case_Completion_Update_Flow to recalculate the completion percentage. BV item sync: when the row is linked to a Booking_Verification_Checklist_Item__c, sets that item&apos;s System_Validated__c to TRUE if the row was created through Ironclad (Ironclad_Contract__c is set) or is Final and not bypassed, otherwise FALSE. Runs on create and when Status__c, Bypass_Requirement__c, Ironclad_Contract__c or the item link changes. A failed item update does not block the Document Checklist save.</description>
    <environments>Default</environments>
    <formulas>
        <description
    >TRUE when the row came from Ironclad, or is Final and not bypassed (a real document was accepted).</description>
        <name>isItemValidated</name>
        <dataType>Boolean</dataType>
        <expression
    >OR(NOT(ISBLANK({!$Record.Ironclad_Contract__c})), AND(ISPICKVAL({!$Record.Status__c}, &quot;Final&quot;), NOT({!$Record.Bypass_Requirement__c})))</expression>
    </formulas>
    <formulas>
        <description
    >Only re-sync the BV item when something that drives System Validated actually changed.</description>
        <name>itemSyncNeeded</name>
        <dataType>Boolean</dataType>
        <expression
    >OR(ISNEW(), ISCHANGED({!$Record.Status__c}), ISCHANGED({!$Record.Bypass_Requirement__c}), ISCHANGED({!$Record.Ironclad_Contract__c}), ISCHANGED({!$Record.Booking_Verification_Checklist_Item__c}))</expression>
    </formulas>
    <label>Doc Checklist Completion Sync Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getNonFinalDocsForCase</name>
        <label>Get Non-Final Docs for Parent Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkNonFinalDocs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Case_Creation_Rule__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Final</stringValue>
            </value>
        </filters>
        <object>Document_Checklist__c</object>
        <outputReference>varNonFinalDocs</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>updateBVItemSystemValidated</name>
        <label>Set BV Item System Validated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference
      >Check_if_Case_or_Booking_Verification</targetReference>
        </connector>
        <faultConnector>
            <targetReference
      >Check_if_Case_or_Booking_Verification</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference
        >$Record.Booking_Verification_Checklist_Item__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>System_Validated__c</field>
            <value>
                <elementReference>isItemValidated</elementReference>
            </value>
        </inputAssignments>
        <object>Booking_Verification_Checklist_Item__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>updateParentCaseFalse</name>
        <label>Set All Exit Docs Final = false</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>All_Exit_Docs_Final__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>updateParentCaseTrue</name>
        <label>Set All Exit Docs Final = true</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>All_Exit_Docs_Final__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Sync_BV_Item_Check</targetReference>
        </connector>
        <object>Document_Checklist__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varNonFinalDocs</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Document_Checklist__c</objectType>
    </variables>
</Flow>
