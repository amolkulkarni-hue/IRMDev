<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>checkNonFinalDocs</name>
        <label>Any Non-Final Docs for Case?</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <defaultConnector>
            <targetReference>updateParentCaseFalse</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non-Final Docs Exist — Set False</defaultConnectorLabel>
        <rules>
            <name>noNonFinalDocs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNonFinalDocs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateParentCaseTrue</targetReference>
            </connector>
            <label>No Non-Final Docs — Set True</label>
        </rules>
    </decisions>
    <description>Record-Triggered After Save flow on Document_Checklist__c (Create and Update). Fires when Status__c changes and Case__c is not null. Queries for any non-Final exit docs on the parent Case. If none exist, sets All_Exit_Docs_Final__c = true on the Case; otherwise sets it to false. This triggers Case_Completion_Update_Flow to recalculate the completion percentage.</description>
    <label>Doc Checklist Completion Sync Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getNonFinalDocsForCase</name>
        <label>Get Non-Final Docs for Parent Case</label>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkNonFinalDocs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Final</stringValue>
            </value>
        </filters>
        <object>Document_Checklist__c</object>
        <outputReference>varNonFinalDocs</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>updateParentCaseFalse</name>
        <label>Set All Exit Docs Final = false</label>
        <locationX>308</locationX>
        <locationY>288</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>All_Exit_Docs_Final__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>updateParentCaseTrue</name>
        <label>Set All Exit Docs Final = true</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>All_Exit_Docs_Final__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <connector>
            <targetReference>getNonFinalDocsForCase</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Document_Checklist__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varNonFinalDocs</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Document_Checklist__c</objectType>
    </variables>
</Flow>
