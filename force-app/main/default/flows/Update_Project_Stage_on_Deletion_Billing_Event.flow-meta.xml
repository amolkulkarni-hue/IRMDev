            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Check_List_Of_BE.pse__Status__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>Check_List_Of_BE.pse__Status__c</leftValueReference>
