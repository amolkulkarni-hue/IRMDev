    <formulas>
        <name>calculateDate</name>
        <dataType>Date</dataType>
        <expression>IF( DAY( TODAY()) &gt;  VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c}) || DAY( TODAY()) =  
  VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c}),  DATE( YEAR( TODAY()),MONTH(TODAY()) , 
  VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c}))  , 
  DATE(YEAR( TODAY()),MONTH(TODAY())-1,VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c})) -1 )</expression>
    </formulas>
    <formulas>
        <name>calculateStartDate</name>
        <dataType>Date</dataType>
        <expression>IF( DAY( {!QTB_EndDate}) &gt;  VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c}) || DAY( {!QTB_EndDate}) =  
  VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c}),  DATE( YEAR( {!QTB_EndDate}),MONTH({!QTB_EndDate}) , 
  VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c}))  , 
  DATE(YEAR( {!QTB_EndDate}),MONTH({!QTB_EndDate})-1,VALUE({!Get_Metadata_Type.QTB_Bill_Cycle_Day__c})))</expression>
    </formulas>
    <formulas>
        <name>ProrateMultiplier</name>
        <dataType>Number</dataType>
        <expression>(((YEAR({!QTB_EndDate}) - YEAR({!QTB_StartDate}))*12) + (MONTH({!QTB_EndDate}) - MONTH({!QTB_StartDate})))/{!To_create_order_products.Product2.SBQQ__SubscriptionTerm__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UnitPriceOrderProduct</name>
        <dataType>Number</dataType>
        <expression>{!To_create_order_products.PricebookEntry.UnitPrice}* {!ProrateMultiplier}</expression>
        <scale>2</scale>
    </formulas>
