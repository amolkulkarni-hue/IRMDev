<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Role_Missing</name>
        <label>Role Missing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_MissingRoles</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>missing_role</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_Metadata_Requirements</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Compare_Existing_Roles_to_Required_Roles</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Compare Existing Roles to Required Roles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Compare_Existing_Roles_to_Required_Roles</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Opportunity_Contact_Role</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Compare_Existing_Roles_to_Required_Roles.Role</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Iterate_Metadata_Requirements.Contact_Role__c</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Check_If_Role_Missing</targetReference>
        </connector>
    </collectionProcessors>
    <customErrors>
        <name>Show_Error_Message</name>
        <label>Show Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Cannot advance Opportunity to {!$Record.StageName}. Stage requirements are not met. Missing required Contact Roles: {!fx_CleanedMissingRoles}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_if_Metadata_Records_Exists</name>
        <label>Check if Metadata Records Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact_Role_Requirement_metadata_records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Contact_Role</targetReference>
            </connector>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Role_Missing</name>
        <label>Check_If_Role_Missing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Iterate_Metadata_Requirements</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Compare_Existing_Roles_to_Required_Roles</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Role_Missing</targetReference>
            </connector>
            <label>Missing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_the_text_is_not_blank</name>
        <label>Check if the text is not blank</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Blank</defaultConnectorLabel>
        <rules>
            <name>Not_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>missing_role</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Error_Message</targetReference>
            </connector>
            <label>Not Blank</label>
        </rules>
    </decisions>
    <description>This flow will be used for Opportunities to have required stakeholder roles identified before advancing through key sales stages, so that deals progress only when the appropriate customer contacts have been identified and engaged.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_CleanedMissingRoles</name>
        <dataType>String</dataType>
        <expression>IF(RIGHT({!missing_role}, 2) = &quot;, &quot;, 
   LEFT({!missing_role}, LEN({!missing_role}) - 2), 
   {!missing_role})</expression>
    </formulas>
    <formulas>
        <name>missing_role</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!var_MissingRoles}), 
   {!Iterate_Metadata_Requirements.Contact_Role__c}, 
   {!var_MissingRoles} + &quot;, &quot; + {!Iterate_Metadata_Requirements.Contact_Role__c})</expression>
    </formulas>
    <interviewLabel>NF Enforce Required Stakeholder Roles by Opportunity Stage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NF Enforce Required Stakeholder Roles by Opportunity Stage</label>
    <loops>
        <name>Iterate_Metadata_Requirements</name>
        <label>Iterate Metadata Requirements</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Contact_Role_Requirement_metadata_records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Compare_Existing_Roles_to_Required_Roles</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_if_the_text_is_not_blank</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contact_Role_Requirement_metadata_records</name>
        <label>Get Contact Role Requirement metadata records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Metadata_Records_Exists</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3) AND 4</filterLogic>
        <filters>
            <field>StageName__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.StageName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Type</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>All</stringValue>
            </value>
        </filters>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact_Role_Requirement__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opportunity_Contact_Role</name>
        <label>Get Opportunity Contact Role</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_Metadata_Requirements</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityContactRole</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contact_Role_Requirement_metadata_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Compare_Existing_Roles_to_Required_Roles</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityContactRole</objectType>
    </variables>
    <variables>
        <name>var_MissingRoles</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
