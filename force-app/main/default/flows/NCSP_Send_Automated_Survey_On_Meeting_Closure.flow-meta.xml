    <decisions>
        <description>If the event assignee has survey options as &apos;Automated Survey&apos; or &apos;Auto and Man Survey&apos; on the user record for the field &apos;Account Management Survey Option&apos;</description>
        <name>Validating_Manager</name>
        <label>Validating Manager</label>
        <locationX>3086</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Access</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.AMCSAT_Survey_Option__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Automated Survey</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.AMCSAT_Survey_Option__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Auto and Man Survey</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_If_Attendees_Present</targetReference>
            </connector>
            <label>Has Access</label>
        </rules>
    </decisions>
