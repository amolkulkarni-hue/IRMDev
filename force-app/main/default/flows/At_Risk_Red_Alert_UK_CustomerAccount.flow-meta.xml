    <decisions>
        <description>Not Null With Status At Risk : If decision return records then I am showing error on another screen.
No Records Found with status At RIsk : If decision  retuns no records then I am creating Red Alert record.
Not Null Other Than Status At Risk : If decision returns records other than status At Risk, Allowing to create Red Alert Record.</description>
        <name>IF_Records_Found_for_CA</name>
        <label>IF Records Found for CA</label>
        <locationX>470</locationX>
        <locationY>45</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Not_Null_With_Status_At_Risk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>At_Risk_Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>At Risk</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SOCAtRisk</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CustomerAccountWithAtRisk</targetReference>
            </connector>
            <label>Not Null With Status At Risk</label>
        </rules>
        <rules>
            <name>No_Records_Found_with_status_At_RIsk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SOCAtRisk</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RecordCreateCustomerAccount</targetReference>
            </connector>
            <label>No Records Found with status At RIsk</label>
        </rules>
        <rules>
            <name>Not_Null_Other_Than_Status_At_Risk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>At_Risk_Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>cAtRisk</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SOCAtRisk</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RecordCreateCustomerAccount</targetReference>
            </connector>
            <label>Not Null Other Than Status At Risk</label>
        </rules>
    </decisions>
