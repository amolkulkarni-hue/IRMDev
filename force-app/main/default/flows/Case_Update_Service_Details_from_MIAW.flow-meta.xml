    <description>This is for Messaging for web for updating the case details from enhanced bots as part of
+ Latam Condition + UKI Condition + India + Ironmountain.com Condition .
23563 - added Email alert for order detail path
#24463 - removed case owner update based on region, and it will now update to the &apos;GSC_IMAP_SC_IND_Indexing_queue&apos;.
#24473 - Updated the CaseOwner formula to indexing queue- added Singapore, Malaysia, Philippines queues.</description>
    <environments>Default</environments>
    <formulas>
        <description>This will retrieve the developer&apos;s name of the queue based on the language selection
#24473 Updated condition for APAC Portal Expansion (PHL/SGP/MYS/)</description>
        <name>CaseOwnerFormula</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!varChannelName} = &quot;IronMountainWebsite Messaging Channel&quot;,
        OR(
           {!varLanguageSelector}= &quot;English&quot;,
            {!varLanguageSelector}= &quot;English (US)&quot;
        )
    ),
    &quot;NAS_CNX_Hand_off&quot;,
    IF(
        AND(
            {!varChannelName} = &quot;IronMountainWebsite Messaging Channel&quot;,
           {!varLanguageSelector}= &quot;French&quot;
        ),
        &quot;NAS_Quebec&quot;,
        CASE(
         {!varLanguageSelector},
            &quot;English&quot;, &quot;NAS_Tier_3&quot;,
            &quot;French&quot;, &quot;NAS_Quebec&quot;,
            &quot;Colombia&quot;, &quot;IMLA_SC_COL_Indexing_Queue&quot;,
            &quot;Argentina&quot;, &quot;IMLA_SC_ARG_Indexing_Queue&quot;,
            &quot;Brazil&quot;, &quot;IMLA_SC_BRA_SML_Queue&quot;,
            &quot;Mexico&quot;, &quot;IMLA_SC_MEX_Indexing_Queue&quot;,
            &quot;Peru&quot;, &quot;IMLA_SC_PER_Indexing_Queue&quot;,
            &quot;Chile&quot;, &quot;IMLA_SC_CHL_Indexing_Queue&quot;,
            &quot;English (UK)&quot;, &quot;IME_SC_GBR_Indexing_Queue&quot;,
            &quot;English (IN)&quot;, &quot;GSC_IMAP_SC_IND_Indexing_queue&quot;,
			&quot;English (PH)&quot;, &quot;IMAP_SC_PHL_Indexing_Queue&quot;,
			&quot;English (SG)&quot;, &quot;IMAP_SC_SGP_Indexing_Queue&quot;,
			&quot;English (MY)&quot;, &quot;IMAP_SC_MYS_Indexing_Queue&quot;,			
            &quot;&quot;
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>CustomerIDWithDesc</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISNULL({!StrPreferredcontact})), {!StrPreferredcontact} &lt;&gt; &apos;&apos;),BR() + &apos;Preferred Contact :&apos;+ {!StrPreferredcontact} +&apos;.&apos;,&apos;&apos;)+
IF(AND(NOT(ISNULL({!strphonenumber})), {!strphonenumber} &lt;&gt; &apos;&apos;),BR() + &apos; Phone Number : &apos;+ {!strphonenumber} +&apos;.&apos;,&apos;&apos;)+
IF(AND(NOT(ISNULL({!strCustomerId})), {!strCustomerId} &lt;&gt; &apos;&apos;),BR() + &apos; Customer Id : &apos;+ {!strCustomerId} +&apos;.&apos;,&apos;&apos;)+
IF(AND(NOT(ISNULL({!strcompanyname})), {!strcompanyname} &lt;&gt; &apos;&apos;),BR() + &apos;Company Name : &apos;+ {!strcompanyname} +&apos;.&apos;,&apos;&apos;)+
IF(AND(NOT(ISNULL({!strdescription})), {!strdescription} &lt;&gt; &apos;&apos;),BR() + &apos; Description : &apos;+  {!strdescription} +&apos;.&apos;,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <description>To store order inquiry details</description>
        <name>varOrderDetailsDesc</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISNULL({!StrPreferredcontact})), {!StrPreferredcontact} &lt;&gt; &apos;&apos;),BR() + &apos;Preferred Contact :&apos;+ {!StrPreferredcontact} +&apos;.&apos;,&apos;&apos;)+
IF(AND(NOT(ISNULL({!strphonenumber})), {!strphonenumber} &lt;&gt; &apos;&apos;),BR() + &apos; Phone Number :&apos;+ {!strphonenumber}+&apos;.&apos;,&apos;&apos;)+
IF(AND(NOT(ISNULL({!strCustomerId})), {!strCustomerId} &lt;&gt; &apos;&apos;),BR() + &apos; Customer Id :&apos;+ {!strCustomerId}+&apos;.&apos;,&apos;&apos;)+
IF(AND(NOT(ISNULL({!varSKPOrderIdFromBot})), {!varSKPOrderIdFromBot} &lt;&gt; &apos;&apos;),BR() + &apos; Order ID:&apos;+ {!varSKPOrderIdFromBot}+&apos;.&apos;,&apos;&apos;)</expression>
    </formulas>
