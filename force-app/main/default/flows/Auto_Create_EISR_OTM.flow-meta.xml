<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Enterprise ISR value is stored in a variable</description>
        <name>Enterprise_ISR_Value</name>
        <label>Enterprise ISR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Enterprise_ISR</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.Enterprise_ISR__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_New_or_Account_change_on_Opportnity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>New EISR is set -up for creation</description>
        <name>New_EISR</name>
        <label>New EISR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NewEISR.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewEISR.TeamMemberRole</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Enterprise ISR</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewEISR.OpportunityAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewEISR.UserId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Enterprise_ISR</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OTMsToCreateORUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NewEISR</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Are_there_records_to_Create_or_Update</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Change the Role to blank and access to read only on old EISR OTM</description>
        <name>Update_old_EISR_Role_and_Access</name>
        <label>Update old EISR Role and Access</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_OTM_records.TeamMemberRole</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_OTM_records.OpportunityAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Read</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OTMsToCreateORUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_OTM_records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_EISR_present</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <description>Failed to create or update OTM record</description>
        <name>Failed_to_create_Update</name>
        <label>Failed to create/Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The system has failed to create, delete or update the EISR on the Opportunity. Please reach out to your System Administrator to resolve.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <description>Error is thrown when flow fails to delete OTM</description>
        <name>Failed_to_Delete</name>
        <label>Failed to Delete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The system has failed to create, delete or update the EISR on the Opportunity. Please reach out to your System Administrator to resolve.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Checks if there are any records to be Created/Updated</description>
        <name>Are_there_records_to_Create_or_Update</name>
        <label>Are there records to Create or Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OTMsToCreateORUpdate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Update_OTMs</targetReference>
            </connector>
            <label>Yes_present</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if EISR OTM is already present on Opportunity</description>
        <name>EISR_already_present_as_OTM</name>
        <label>EISR already present as OTM</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_EISR_present</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OTM_records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Splits_of_Old_EISR</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if Account has EISR value or not</description>
        <name>Is_EISR_present</name>
        <label>Is EISR present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Are_there_records_to_Create_or_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Enterprise_ISR</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Enterprise_ISR</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_EISR</targetReference>
            </connector>
            <label>Available</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks how the floe is triggered. Due to New Opportunity / change of Account</description>
        <name>Is_New_or_Account_change_on_Opportnity</name>
        <label>Is New or Account change on Opportunity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_EISR_present</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_change</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_OTM_records</targetReference>
            </connector>
            <label>Account change</label>
        </rules>
    </decisions>
    <decisions>
        <description>If split share exist, we cannot delete the OTM. Instead we will change the role to blank and access to Read only</description>
        <name>Is_Old_EISR_part_of_Splits</name>
        <label>Is Old EISR part of Splits?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Delete_old_EISR</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Split_share_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Splits_of_Old_EISR</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_old_EISR_Role_and_Access</targetReference>
            </connector>
            <label>Yes Split share Exist</label>
        </rules>
    </decisions>
    <description>#Gitlab Story: 31858
When a new Opportunity is created/ Account is changed on Open opportunity, based on the EISR value on Account OTM record is created</description>
    <environments>Default</environments>
    <interviewLabel>Auto Create EISR OTM {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Create EISR OTM</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Creates or Updates OTM records</description>
        <name>Create_Update_OTMs</name>
        <label>Create/Update OTMs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesUpsert>true</doesUpsert>
        <faultConnector>
            <targetReference>Failed_to_create_Update</targetReference>
        </faultConnector>
        <inputReference>OTMsToCreateORUpdate</inputReference>
    </recordCreates>
    <recordDeletes>
        <description>Deletes old EISR OTM</description>
        <name>Delete_old_EISR</name>
        <label>Delete old EISR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_EISR_present</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Failed_to_Delete</targetReference>
        </faultConnector>
        <inputReference>Get_OTM_records</inputReference>
    </recordDeletes>
    <recordLookups>
        <description>Fetches the OTM records of the Opportunity</description>
        <name>Get_OTM_records</name>
        <label>Get OTM records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>EISR_already_present_as_OTM</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>TeamMemberRole</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Enterprise ISR</stringValue>
            </value>
        </filters>
        <filters>
            <field>UserId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.Account.Enterprise_ISR__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityTeamMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Fetches the split records of OLD EISR</description>
        <name>Splits_of_Old_EISR</name>
        <label>Splits of Old EISR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Old_EISR_part_of_Splits</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SplitOwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.Account.Enterprise_ISR__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunitySplit</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Enterprise_ISR_Value</targetReference>
        </connector>
        <filterFormula>AND(
OR(
ISNEW(),
AND(
ISCHANGED({!$Record.AccountId})
)
),
NOT({!$Record.IsClosed})
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Enterprise_ISR</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>NewEISR</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityTeamMember</objectType>
    </variables>
    <variables>
        <name>OTMsToCreateORUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityTeamMember</objectType>
    </variables>
</Flow>
