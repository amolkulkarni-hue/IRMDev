    <description>Sends an Email Alert to Commission Appeal owner for Acknowledge receipt, Request more information, Already Being Processed, Accepted and Denied stage.
(Gitlab story #21002 for reference)</description>
    <environments>Default</environments>
    <formulas>
        <name>New</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Fetches the current time</description>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>SubmissionCounter</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Appeal_Submission_Attempts__c} + 1</expression>
