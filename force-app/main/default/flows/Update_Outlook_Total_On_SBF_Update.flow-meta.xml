<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow will call the sub flow to update Outlook Total on opportunity whenever an Actual Billing or Updated Billing Outlook is updated.</description>
    <environments>Default</environments>
    <interviewLabel>Update Outlook Total On SBF Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Outlook Total On SBF Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>To call Sub flow, need to get triggered SBF record</description>
        <name>Get_SBF_Record</name>
        <label>Get SBF Record</label>
        <locationX>793</locationX>
        <locationY>155</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Calling_Update_Outlook_Total_on_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Sales_Revenue_Forecast__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>334</locationX>
        <locationY>47</locationY>
        <connector>
            <targetReference>Get_SBF_Record</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Actual_Billings__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Updated_Billing_Outlook__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Delay_Reasons_B2B_Billing_Outlook__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Sales_Revenue_Forecast__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Sub flow has the logic to update Outlook Total on Opportunity.  Passing SBF record to sub flow.</description>
        <name>Calling_Update_Outlook_Total_on_Opportunity</name>
        <label>Calling Update Outlook Total on Opportunity</label>
        <locationX>1028</locationX>
        <locationY>156</locationY>
        <flowName>Outlook_Total_Update_On_Opportunity_From_Sales_Billing_Forecast</flowName>
        <inputAssignments>
            <name>Var_Received_SBFs_Collection</name>
            <value>
                <elementReference>Get_SBF_Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
