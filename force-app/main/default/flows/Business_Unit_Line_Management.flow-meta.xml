    <decisions>
        <name>Decision_Has_Lines</name>
        <label>Does the Opportunity Have Any Active Lines?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_Editable_Empty</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Lines Yet</defaultConnectorLabel>
        <rules>
            <name>Has_Lines</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colActiveLines</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Build_Grid</targetReference>
            </connector>
            <label>Has Lines</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Editable_Empty</name>
        <label>Is Opportunity Editable? (No Lines Yet)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Nothing_To_Show</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Editable</defaultConnectorLabel>
        <rules>
            <name>Empty_Is_Qualification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Add_Line</targetReference>
            </connector>
            <label>Editable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Editable_Grid</name>
        <label>Is Opportunity Editable? (Has Lines)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_View_Grid_ReadOnly</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Editable</defaultConnectorLabel>
        <rules>
            <name>Grid_Is_Qualification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Manage_Grid</targetReference>
            </connector>
            <label>Editable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Route_Action</name>
        <label>Edit or Add?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Selected_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Edit Existing</defaultConnectorLabel>
        <rules>
            <name>Route_Add</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Add_Line</targetReference>
            </connector>
            <label>Add New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_BU_Already_Active</name>
        <label>Is This Business Unit Already Active?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_New_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Yet Active</defaultConnectorLabel>
        <rules>
            <name>BU_Already_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Line_For_BU.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_BU_Already_Exists_Error</targetReference>
            </connector>
            <label>Already Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Check_Deactivate</name>
        <label>Deactivate This Line?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Opportunity_Recheck</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stay Active</defaultConnectorLabel>
        <rules>
            <name>Should_Deactivate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Input_Edit_Set_Inactive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Deactivate_Line</targetReference>
            </connector>
            <label>Deactivate</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Stage_Still_Qualification</name>
        <label>Is Opportunity Still in Qualification?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_Route_Dml</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Still Qualification</defaultConnectorLabel>
        <rules>
            <name>Stage_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Recheck.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Qualification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Stage_Changed_Error</targetReference>
            </connector>
            <label>Stage Changed — Stop</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Route_Dml</name>
        <label>Create or Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Update</defaultConnectorLabel>
        <rules>
            <name>Route_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPendingDml</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Create</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Line</targetReference>
            </connector>
            <label>Create</label>
        </rules>
    </decisions>
    <choices>
        <name>Choice_Edit_Line</name>
        <choiceText>Edit an existing Business Unit line</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Edit</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Add_Line</name>
        <choiceText>Add a new Business Unit line</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Add</stringValue>
        </value>
    </choices>
    <dynamicChoiceSets>
        <name>ChoiceSet_Select_Line</name>
        <dataType>String</dataType>
        <displayField>Business_Unit__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity_Product_Line__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ChoiceSet_BU</name>
        <dataType>Picklist</dataType>
        <picklistField>Business_Unit__c</picklistField>
        <picklistObject>Opportunity_Product_Line__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ChoiceSet_Product_Family</name>
        <dataType>Picklist</dataType>
        <picklistField>Product_Family__c</picklistField>
        <picklistObject>Opportunity_Product_Line__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ChoiceSet_Product_Line</name>
        <dataType>Picklist</dataType>
        <picklistField>Product_Line__c</picklistField>
        <picklistObject>Opportunity_Product_Line__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Formula_Row_BU</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Build_Grid.Business_Unit__c})</expression>
    </formulas>
    <formulas>
        <name>Formula_Row_Product_Family</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Build_Grid.Product_Family__c})</expression>
    </formulas>
    <formulas>
        <name>Formula_Row_Product_Line</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Build_Grid.Product_Line__c})</expression>
    </formulas>
    <formulas>
        <name>Formula_Row_EAA</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Build_Grid.EAA__c})</expression>
    </formulas>
    <formulas>
        <name>Formula_Row_Primary</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_Build_Grid.Is_Primary__c}, "Yes", "No")</expression>
    </formulas>
    <formulas>
        <name>Formula_Row_Active</name>
        <dataType>String</dataType>
        <expression>IF({!Loop_Build_Grid.Is_Active__c}, "Yes", "No")</expression>
    </formulas>
    <formulas>
        <name>Formula_Grid_Row</name>
        <dataType>String</dataType>
        <expression>"&lt;tr&gt;&lt;td&gt;" &amp; {!Formula_Row_BU} &amp; "&lt;/td&gt;&lt;td&gt;" &amp; {!Formula_Row_Product_Family} &amp; "&lt;/td&gt;&lt;td&gt;" &amp; {!Formula_Row_Product_Line} &amp; "&lt;/td&gt;&lt;td&gt;" &amp; {!Formula_Row_EAA} &amp; "&lt;/td&gt;&lt;td&gt;" &amp; {!Formula_Row_Primary} &amp; "&lt;/td&gt;&lt;td&gt;" &amp; {!Formula_Row_Active} &amp; "&lt;/td&gt;&lt;/tr&gt;"</expression>
    </formulas>
