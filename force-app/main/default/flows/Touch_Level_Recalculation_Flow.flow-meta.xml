<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>callTouchLevelEvaluator</name>
        <label>Evaluate Touch Level</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <actionName>TouchLevelEvaluatorAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>checkNoDowngrade</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>opportunityId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>TouchLevelEvaluatorAction</nameSegment>
        <outputParameters>
            <assignToReference>varCalculatedTouchLevel</assignToReference>
            <name>touchLevel</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varMatchedCriteriaName</assignToReference>
            <name>matchedCriteriaName</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>checkNoDowngrade</name>
        <label>Apply No-Downgrade Rule</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnector>
            <targetReference>updateOpportunityTouchLevel</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Update Touch Level</defaultConnectorLabel>
        <rules>
            <name>keepCurrentHighTouch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Touch_Level__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High Touch</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCalculatedTouchLevel</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>High Touch</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Touch_Level_Override__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Current is High Touch and new is lower — keep current</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow on Opportunity (After Save). Fires when StageName or Amount changes. Calls TouchLevelEvaluatorAction to calculate the new Touch Level, applies the no-downgrade rule (High Touch is never downgraded automatically), then updates Touch_Level_Calculated__c and Touch_Level__c.</description>
    <label>Touch Level Recalculation Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>updateOpportunityTouchLevel</name>
        <label>Update Opportunity Touch Level</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Touch_Level_Calculated__c</field>
            <value>
                <elementReference>varCalculatedTouchLevel</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Touch_Level_Criteria_Matched__c</field>
            <value>
                <elementReference>varMatchedCriteriaName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Touch_Level__c</field>
            <value>
                <elementReference>varCalculatedTouchLevel</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>callTouchLevelEvaluator</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Amount</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Touch_Level_Override__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>varCalculatedTouchLevel</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varMatchedCriteriaName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
