    <decisions>
        <description>This flow is to update NCSP fields &apos;Invoice Mailing Date&apos; when Service Completion date is filled/removed and throw custom validation error when there are no Billing Cut Off Schedule dates. Check for Case field &quot;NCSP Service Line&quot;
1) For &apos;DB&amp;R&apos;
2) For not &apos;DB&amp;R&apos;</description>
        <name>Check_Case_field_NCSP_Service_Line</name>
        <label>Check Case field &quot;NCSP Service Line&quot;</label>
        <locationX>1304</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NCSP_Service_Line_is_DB_R</name>
            <conditionLogic>1 AND 2 AND 3 AND (NOT(4 AND (5 OR 6)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DB&amp;R</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Invoice_Review_date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Service_Completion_Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Service_Completion_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>One Time Shred</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_ID__r.IM_Customer_Account_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>A5000</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_ID__r.IM_Customer_Account_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>A7000</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Records_Billing_Cut_Off_Schedule</targetReference>
            </connector>
            <label>1- &quot;NCSP Service Line&quot; is &quot;DB&amp;R&quot;</label>
        </rules>
        <rules>
            <name>NCSP_Service_Line_is_other_than_DB_R</name>
            <conditionLogic>1 AND 2 AND 3 AND (NOT(4 AND (5 OR 6)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>DB&amp;R</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Invoice_Review_date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Service_Completion_Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Service_Completion_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>One Time Shred</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_ID__r.IM_Customer_Account_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>A5000</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_ID__r.IM_Customer_Account_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>A7000</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Records_Billing_Cut_Off_Schedule_for_Service_Line_other_than_DB_R</targetReference>
            </connector>
            <label>2- &quot;NCSP Service Line&quot; is other than &quot;DB&amp;R&quot;</label>
        </rules>
    </decisions>
    <decisions>
        <description>Update Case Field &quot;Invoice Mailing Date&quot;
1) Update field &quot;Invoice Mailing Date&quot; as Invoice Mailing Date
2) Update field &quot;Invoice Mailing Date&quot; as Null
