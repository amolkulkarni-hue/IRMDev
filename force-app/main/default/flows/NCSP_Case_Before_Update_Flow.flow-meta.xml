                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Field</targetReference>
            </connector>
            <label>1- Update field &quot;Invoice Mailing Date&quot; as Invoice Mailing Date</label>
        </rules>
        <rules>
            <name>Update_field_Invoice_Mailing_Date_as_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Records_Billing_Cut_Off_Schedule</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Service_Completion_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Fields_as_Null</targetReference>
            </connector>
            <label>2- Update field &quot;Invoice Mailing Date&quot; as Null</label>
        </rules>
        <rules>
            <name>Throw_Custom_Validation_Error</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Records_Billing_Cut_Off_Schedule</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_error</targetReference>
            </connector>
            <label>3- Throw Custom Validation Error</label>
        </rules>
    </decisions>
