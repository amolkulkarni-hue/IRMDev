    <formulas>
        <name>AccountPurchasedDigital</name>
        <dataType>Boolean</dataType>
        <expression>IF(CONTAINS({!ProductLineVariableString}, &quot;Digital Pathology&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Digital Record Center&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Digital Record Center for Images&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Digital Referral&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Digital Registration / Resale&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Digital Storage&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Digital Studios&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Digitization &amp; Digital Media Services&quot;), TRUE, FALSE))))))))</expression>
    </formulas>
    <formulas>
        <name>AccountPurchasedShredding</name>
        <dataType>Boolean</dataType>
        <expression>IF(CONTAINS({!ProductLineVariableString}, &quot;Other Shredding Revenue&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Secure Shred&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Secure Shredding&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Secure Shredding Off Site&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Secure Shredding On Site&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Secure Shredding Services&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Shredding Paper Revenue&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Shred - Plastic Media Revenue&quot;), TRUE, 
IF(CONTAINS({!ProductLineVariableString}, &quot;Shred - Recycling Revenue&quot;), TRUE, FALSE)))))))))</expression>
    </formulas>
