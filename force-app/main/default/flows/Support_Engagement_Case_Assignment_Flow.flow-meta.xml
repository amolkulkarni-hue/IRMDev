<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>checkMappingFound</name>
        <label>Mapping Found?</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnector>
            <targetReference>getQueueByDevName</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes — Resolve Queue</defaultConnectorLabel>
        <rules>
            <name>noMappingFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMappedQueueDevName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No Mapping Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkQueueFound</name>
        <label>Queue Found?</label>
        <locationX>176</locationX>
        <locationY>528</locationY>
        <defaultConnector>
            <targetReference>assignCaseToQueue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes — Assign</defaultConnectorLabel>
        <rules>
            <name>queueNotFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varQueueId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Queue Not Found</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow on Case (After Insert). Fires when a new Case is created with a Type value. Looks up Touch_Level_Case_Mapping__c by Case Type, resolves the matching Queue, and assigns Case OwnerId. (Migrated from the Touch_Level_Case_Mapping__mdt Custom Metadata Type so mapping changes carry field history tracking.)</description>
    <label>Support Engagement Case Assignment Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getCaseMappingCMT</name>
        <label>Get Case Mapping CMT</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkMappingFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Type</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Touch_Level_Case_Mapping__c</object>
        <outputAssignments>
            <assignToReference>varMappedQueueDevName</assignToReference>
            <field>Queue_Developer_Name__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>getQueueByDevName</name>
        <label>Get Queue by Developer Name</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkQueueFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varMappedQueueDevName</elementReference>
            </value>
        </filters>
        <object>Group</object>
        <outputAssignments>
            <assignToReference>varQueueId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>assignCaseToQueue</name>
        <label>Assign Case to Queue</label>
        <locationX>176</locationX>
        <locationY>648</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>varQueueId</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>getCaseMappingCMT</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varMappedQueueDevName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varQueueId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
