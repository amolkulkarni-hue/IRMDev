<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>#35339 - Partner Alliance: Create Flow to populate Co-Sell Cloud ID or Offer ID fields when triggered from the Tackle widget</description>
    <environments>Default</environments>
    <interviewLabel>Tackle GCP Opportunity : {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Tackle GCP Opportunity : Populate GCP Cloud ID to Related Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updating GCP Cloud Id to related Opportunity</description>
        <name>Update_GCP_Cloud_ID_to_Opportunity</name>
        <label>Update GCP Cloud ID to Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.tackleio__Opportunity__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>GCP_Co_Sell_ID__c</field>
            <value>
                <elementReference>$Record.tackleio__GcpOpportunityExternalId__c</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_GCP_Cloud_ID_to_Opportunity</targetReference>
        </connector>
        <filterFormula>AND(
OR(
ISNEW() &amp;&amp; NOT(ISBLANK({!$Record.tackleio__GcpOpportunityExternalId__c})),
ISCHANGED({!$Record.tackleio__GcpOpportunityExternalId__c})),
OR(
{!$Record.tackleio__Opportunity__r.RecordType.DeveloperName}=&apos;Standard_Opportunity&apos;,
{!$Record.tackleio__Opportunity__r.RecordType.DeveloperName}=&apos;IME_Standard_Opportunity&apos;,
{!$Record.tackleio__Opportunity__r.RecordType.DeveloperName}=&apos;IMLA_Standard_Opportunity&apos;,
{!$Record.tackleio__Opportunity__r.RecordType.DeveloperName}=&apos;IMAP_Standard_Opportunity&apos;)
)</filterFormula>
        <object>tackleio__TackleGcpOpportunity__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
