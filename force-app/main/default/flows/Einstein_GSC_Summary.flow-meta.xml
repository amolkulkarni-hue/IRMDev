    <description>Einstein Work Summaries in one screen - 24504 
This flow provides a summary of wrapup fields for all the associated objects, such as Messaging Sessions, Live Chat Transcripts, Voice Calls, and Emails.</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailCaseWrapUpFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Email Summary :&apos;+{!CaseRecord.EWS_Email_Summary__c}</expression>
    </formulas>
    <formulas>
        <name>LiveChatCaseWrapUpFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Issue: &apos; +{!CaseRecord.Subject}+ BR() + 
&apos;Resolution: &apos; +{!CaseRecord.Description}+ BR() + 
&apos;Summary: &apos; +{!CaseRecord.GSC_Case_Summary__c}+ BR()+ BR()</expression>
    </formulas>
    <formulas>
        <name>MessagingSessionCaseWrapUPformula</name>
        <dataType>String</dataType>
        <expression>{!loop_on_get_Messaging_Session.Name} + &apos; : &apos; + BR()+
&apos;Issue: &apos; + {!loop_on_get_Messaging_Session.EWS_Issue__c} + BR() + 
&apos;Resolution: &apos; + {!loop_on_get_Messaging_Session.EWS_Resolution__c} + BR() + 
&apos;Summary: &apos; + {!loop_on_get_Messaging_Session.EWS_Summary__c} + BR()+ BR()</expression>
    </formulas>
    <formulas>
        <name>VoiceCallCaseWrapUpFormula</name>
        <dataType>String</dataType>
        <expression>{!loop_on_get_VoiceCall.Name} + &apos; : &apos; + BR()+
&apos;Issue: &apos; + {!loop_on_get_VoiceCall.test_EWSIssue__c}+ BR() + 
&apos;Resolution: &apos; + {!loop_on_get_VoiceCall.test_EWSResolution__c} + BR() + 
&apos;Summary: &apos; +{!loop_on_get_VoiceCall.test_EWSSummary__c}+ BR()+ BR()</expression>
    </formulas>
