    <description>A Screen Flow to open related records from the WhatsApp Messaging Session</description>
    <environments>Default</environments>
    <formulas>
        <name>formCaseLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND( &apos;/services&apos;, {!$Api.Partner_Server_URL_260})) + {!Get_Case.Id}</expression>
    </formulas>
    <formulas>
        <description>Link to the Contact found</description>
        <name>formContactLink</name>
