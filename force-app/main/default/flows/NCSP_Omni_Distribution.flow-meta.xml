                <rightValue>
                    <stringValue>DMS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DRCMI</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NCSP_FIFO_DMS</targetReference>
            </connector>
            <label>DMS</label>
        </rules>
    </decisions>
