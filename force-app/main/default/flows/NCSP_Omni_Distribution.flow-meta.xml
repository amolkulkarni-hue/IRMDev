    <decisions>
        <description>Checking the service line to update the NCSP FIFO Team , which is used in skill based routing rule</description>
        <name>Service_Line_Check</name>
        <label>Service Line Check</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RM</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accutrac</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Geological Core</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RM/Shred</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RM Pathology</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Vault Climate Control</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NCSP_FIFO_RM</targetReference>
            </connector>
            <label>RM</label>
        </rules>
        <rules>
            <name>SHRED</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shred</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NCSP_FIFO_SHRED</targetReference>
            </connector>
            <label>SHRED</label>
        </rules>
        <rules>
            <name>OTS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>One Time Shred</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NCSP_FIFO_OTS</targetReference>
            </connector>
            <label>OTS</label>
        </rules>
        <rules>
            <name>ALM</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cloud Archive</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Center</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DB&amp;R</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SITAD</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NCSP_FIFO_ALM</targetReference>
            </connector>
            <label>ALM</label>
        </rules>
        <rules>
            <name>DMS</name>
            <conditionLogic>or</conditionLogic>
