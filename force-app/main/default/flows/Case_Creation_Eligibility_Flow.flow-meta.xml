<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>callCaseCreationEvaluator</name>
        <label>Evaluate Case Creation Rules</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <actionName>CaseCreationRuleEvaluatorAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>checkHasMatches</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>opportunityId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>CaseCreationRuleEvaluatorAction</nameSegment>
        <outputParameters>
            <assignToReference>varMatchedRulesJson</assignToReference>
            <name>matchedRulesJson</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varHasMatches</assignToReference>
            <name>hasMatches</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varMatchedRuleCount</assignToReference>
            <name>matchedRuleCount</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>checkHasMatches</name>
        <label>Has Matched Rules?</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>No Matches — Stop</defaultConnectorLabel>
        <rules>
            <name>hasMatchesRule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHasMatches</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Rules Matched — Create Checklists</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow on Opportunity (After Save). Fires when Touch_Level_Calculated__c changes (blank → value or value → value). Calls CaseCreationRuleEvaluatorAction to find matching Case Creation Rules. Results (matchedRulesJson) are used to create Document_Checklist__c records in Draft status for Phase 1 of the 2-phase Case creation process. Configure the loop and record create elements in Flow Builder after deployment.</description>
    <label>Case Creation Eligibility Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>callCaseCreationEvaluator</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Touch_Level_Calculated__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>varHasMatches</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>varMatchedRuleCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varMatchedRulesJson</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
