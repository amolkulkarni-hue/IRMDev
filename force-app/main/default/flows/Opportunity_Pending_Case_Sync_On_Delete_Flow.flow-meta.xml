<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Set_Opportunity_Id</name>
        <label>Set Opportunity Id</label>
        <locationX>176</locationX>
        <locationY>60</locationY>
        <assignmentItems>
            <assignToReference>varOpportunityToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Open_Cases_On_Opportunity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_Count</name>
        <label>Increment Count</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>varOpenCaseCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Open_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Opportunity_Count</name>
        <label>Set Opportunity Count</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>varOpportunityToUpdate.Open_Cases_Pending_Seller_Action__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varOpenCaseCount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_Count</targetReference>
        </connector>
    </assignments>
    <description>Companion to Opportunity_Pending_Case_Sync_Flow. That flow is Create/Update-triggered and can't also be Delete-triggered on the same definition, so Case deletion needs its own Record-Triggered Flow to keep Opportunity.Open_Cases_Pending_Seller_Action__c from going stale when a Case is removed.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Pending Case Sync On Delete Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Pending Case Sync On Delete Flow</label>
    <loops>
        <name>Loop_Open_Cases</name>
        <label>Loop Open Cases</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <collectionReference>Get_Open_Cases_On_Opportunity</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Count</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Opportunity_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Cases_On_Opportunity</name>
        <label>Get Open Cases On Opportunity</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Open_Cases</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Submitted_To_Support__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_Count</name>
        <label>Update Opportunity Count</label>
        <locationX>176</locationX>
        <locationY>540</locationY>
        <inputReference>varOpportunityToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Opportunity_Id</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varOpenCaseCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varOpportunityToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
</Flow>
