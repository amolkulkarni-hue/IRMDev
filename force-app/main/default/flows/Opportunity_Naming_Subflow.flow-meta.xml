<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>buildOppName</name>
        <label>Build Opportunity Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>IRM_OppNamingAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>checkNameChanged</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accountName</name>
            <value>
                <elementReference>varAccountName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>opportunity</name>
            <value>
                <elementReference>triggeringOpptyRecord</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>segments</name>
            <value>
                <elementReference>varNamingSegments</elementReference>
            </value>
        </inputParameters>
        <nameSegment>IRM_OppNamingAction</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>varBuiltName</assignToReference>
            <name>opportunityName</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Opportunity_Name</name>
        <label>Set Opportunity Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>triggeringOpptyRecord.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varBuiltName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>triggeringOpptyRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>checkNameChanged</name>
        <label>Built Name Different from Current?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Name Unchanged — End (loop guard)</defaultConnectorLabel>
        <rules>
            <name>nameChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varBuiltName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>triggeringOpptyRecord.Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opportunity_Name</targetReference>
            </connector>
            <label>Name Changed — Update</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkNameHasTBD</name>
        <label>Name Contains TBD?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No TBD — End</defaultConnectorLabel>
        <rules>
            <name>nameHasTBD</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>triggeringOpptyRecord.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>TBD</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getRecordTypeName</targetReference>
            </connector>
            <label>Name Has TBD</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkRecordType</name>
        <label>Is Target Record Type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Target RT — End</defaultConnectorLabel>
        <rules>
            <name>isTargetRT</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varRecordTypeDevName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varRecordTypeDevName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Framework_Parent_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getAccount</targetReference>
            </connector>
            <label>Standard or Framework RT</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkSegmentsExist</name>
        <label>Naming Segments Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Segments — End</defaultConnectorLabel>
        <rules>
            <name>segmentsFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNamingSegments</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>buildOppName</targetReference>
            </connector>
            <label>Segments Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Opportunity Naming Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Naming Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getAccount</name>
        <label>Get Account Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getNamingSegments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>triggeringOpptyRecord.AccountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputAssignments>
            <assignToReference>varAccountName</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>getNamingSegments</name>
        <label>Get Naming Segments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkSegmentsExist</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Record_Type_Dev_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>All</stringValue>
            </value>
        </filters>
        <filters>
            <field>Record_Type_Dev_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRecordTypeDevName</elementReference>
            </value>
        </filters>
        <object>Opp_Naming_Segment__c</object>
        <outputReference>varNamingSegments</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Order__c</queriedFields>
        <queriedFields>Field_API_Name__c</queriedFields>
        <queriedFields>Fallback_Value__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>getRecordTypeName</name>
        <label>Get RecordType Dev Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkRecordType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>triggeringOpptyRecord.RecordTypeId</elementReference>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>varRecordTypeDevName</assignToReference>
            <field>DeveloperName</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_Record</name>
        <label>Update Opportunity Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>OpportunityRecord</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>checkNameHasTBD</targetReference>
        </connector>
    </start>
    <status>Active</status>
