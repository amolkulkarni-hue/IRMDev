    <decisions>
        <name>Has_Existing_Revenue_Forecasting_Records</name>
        <label>Has Existing Revenue Forecasting Records</label>
        <locationX>604</locationX>
        <locationY>234</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Revenue_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sales_Revenue_Has_Records_Already</targetReference>
            </connector>
            <label>True</label>
        </rules>
        <rules>
            <name>False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Revenue_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity</targetReference>
            </connector>
            <label>False</label>
        </rules>
    </decisions>
    <decisions>
        <name>Have_We_Met_Term_Limit</name>
        <label>Have We Met Term Limit</label>
        <locationX>1143</locationX>
        <locationY>239</locationY>
        <defaultConnector>
            <targetReference>Create_Revenue_Forecast_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Term Count EQ Term</defaultConnectorLabel>
        <rules>
            <name>Term_Counter_LT_Term</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>termCounter</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>12.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Record_Forecast_Variable</targetReference>
            </connector>
            <label>Term Counter LT Term</label>
        </rules>
    </decisions>
    <decisions>
        <description>Total Annual revenue Check &gt; 25 or not</description>
        <name>Total_Annual_revenue_Check</name>
        <label>Total Annual revenue Check</label>
        <locationX>909</locationX>
        <locationY>237</locationY>
        <defaultConnector>
            <targetReference>Total_Annual_Revenue_is_25</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Total Annual revenue &lt; 25k</defaultConnectorLabel>
        <rules>
            <name>Total_Annual_revenue_25k</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OpportunityAnnualAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>24999.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Have_We_Met_Term_Limit</targetReference>
            </connector>
            <label>Total Annual revenue &gt; 25k</label>
        </rules>
    </decisions>
    <description>Create 12 revenue forecast records from Action if Total Annual Amount &gt;=25K</description>
    <formulas>
