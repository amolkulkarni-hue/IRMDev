        <expression>AND(  NOT(BEGINS(PRIORVALUE({!$Record.OwnerId}), &apos;00G&apos;) ) ,  BEGINS({!$Record.OwnerId}, &apos;00G&apos;) ,  
 OR(  CONTAINS($Label.OLO_Delete_Profiles  , $User.ProfileId ) ,  
 CONTAINS(  $Label.OLO_Delete_Profiles_User ,  $User.ProfileId ) &amp;&amp; 
 ( CONTAINS( $Label.OLO_Delete_Profiles , {!$Record.IM_Original_Lead_Owner__r.ProfileId} )
 || Contains(  $Label.OLO_Delete_Profiles_User , {!$Record.IM_Original_Lead_Owner__r.ProfileId}) ) ,   
 NOT(CONTAINS(  $Label.OLO_Delete_Profiles ,  $User.ProfileId )) 
 &amp;&amp; NOT(CONTAINS($Label.OLO_Delete_Profiles_User ,  $User.ProfileId ))
 &amp;&amp; CONTAINS( $Label.OLO_Delete_Profiles , {!$Record.IM_Original_Lead_Owner__r.ProfileId}) ) )</expression>
    </formulas>
