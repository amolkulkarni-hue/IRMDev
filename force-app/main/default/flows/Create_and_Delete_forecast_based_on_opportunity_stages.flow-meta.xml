    <description>#14831-CRM Platform | SPIKE Book to Bill: Update B2B to exclude only &quot;Renewal&quot; Deal Types in New Model VRs/Triggers/Automation</description>
    <environments>Default</environments>
    <formulas>
        <name>TotalAnnualAmountInUSD</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Amount}/{!Get_Currency_Conversion_Rate.ConversionRate}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Var_ForecastRevnueDate_Formula</name>
        <dataType>Date</dataType>
        <expression>IF(DAY( {!$Record.IM_Booked_Date__c} ) &lt; 16, 
        IF( (MONTH({!$Record.IM_Booked_Date__c} ) + {!termCounter}) &gt; 12,
              DATE( YEAR({!$Record.IM_Booked_Date__c} )  +1 ,((MONTH({!$Record.IM_Booked_Date__c} ) + {!termCounter}) - 12),1),
              IF((MONTH({!$Record.IM_Booked_Date__c} ) + {!termCounter}) &lt; 12, 
                      DATE( YEAR({!$Record.IM_Booked_Date__c} ),MONTH({!$Record.IM_Booked_Date__c} ) + {!termCounter},1) , 
                      DATE( YEAR({!$Record.IM_Booked_Date__c} ),12,1)) ), 
         IF( ((MONTH({!$Record.IM_Booked_Date__c} ) +1) + {!termCounter}) &gt; 12 , 
               DATE(YEAR({!$Record.IM_Booked_Date__c} )  +1,((MONTH({!$Record.IM_Booked_Date__c} ) +1) + {!termCounter}) - 12 ,1) , 
                IF(((MONTH({!$Record.IM_Booked_Date__c} ) +1) + {!termCounter}) &lt; 12,
					DATE(YEAR({!$Record.IM_Booked_Date__c}),(MONTH({!$Record.IM_Booked_Date__c})+1)+{!termCounter},1),
					DATE(YEAR({!$Record.IM_Booked_Date__c}),12,1)) )  
)</expression>
    </formulas>
    <formulas>
        <description>It will store the number of billing month records</description>
        <name>Var_NoOfBillingMonthCounter</name>
        <dataType>Number</dataType>
        <expression>VALUE(TEXT( {!$Record.No_of_Forecast_Billing_Month__c}  ) )</expression>
        <scale>0</scale>
    </formulas>
