    <decisions>
        <description>We check the conditions of stage, login profile, and amount</description>
        <name>check_conditions_on_stage_profile_and_amount</name>
        <label>check conditions on stage profile and amount</label>
        <locationX>576</locationX>
        <locationY>18</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>stage_profile_and_amount_condition_true</name>
            <conditionLogic>1 AND 2 AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>4 - Negotiate</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TotalAnnualAmountInUSD</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>25000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>5 - Signed/PO in</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_forecast_Records_at_stage_at_5</targetReference>
            </connector>
            <label>stage profile and amount condition true</label>
        </rules>
        <rules>
            <name>Stagechange_4</name>
            <conditionLogic>(1 OR 2 OR 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>3 - Solution Agreed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>2 - Solution Developed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>1 - Qualification</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>4 - Negotiate</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>5 - Signed/PO in</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Forecast_Records_at_stage_less_than_5</targetReference>
            </connector>
            <label>Stagechange&lt;4</label>
        </rules>
    </decisions>
