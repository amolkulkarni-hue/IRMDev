    <decisions>
        <description>Check For Existing Opportunity SplitOverlay And Opportunity Team Member Created  by the flow in opportunity</description>
        <name>Check_For_Existing_Opportunity_SplitOverlay_And_Opportunity_Team_Member</name>
        <label>Check For Existing Opportunity SplitOverlay And Opportunity Team Member</label>
        <locationX>270</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_OpportunitySplit_And_Opportunity_Team_Member_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Split</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity_Team_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SolutionExecutive</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Opportunity_Split.SplitOwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Opportunity_Split_Before_Creating_New_Opportunity_SplitOverlay</targetReference>
            </connector>
            <label>If OpportunitySplit And Opportunity Team Member Exist ?</label>
        </rules>
        <rules>
            <name>If_OpportunitySplit_And_Opportunity_Team_Member_Exist_for_the_first_time</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Split</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity_Team_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Opportunity_Split_Overlay</targetReference>
            </connector>
            <label>If OpportunitySplit And Opportunity Team Member Exist for the first time?</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check The conditions if the condition satisfies than Opportunity Split record &amp; Opportunity Team Member</description>
        <name>Check_The_Condition_To_Create_Opportunity_Split_Record_Opportunity_Team_Member_R</name>
        <label>Check The Condition To Create Opportunity Split Record &amp; Opportunity Team Member Record</label>
        <locationX>908</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Satisfies_The_Condition_Total_Annual_Amount_Cuft_Business_Unit_Of_Product</name>
            <conditionLogic>(((1 AND 2 AND 5) OR (3 AND 6) OR (((1 AND 2) OR 3) AND 4)) AND 7)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>25000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_OpportunityLineItem_With_Product_Business_Unit_RIM</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cubic_Feet__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cubic_Feet__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Solution_Executive_Formula__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_For_Existing_Opportunity_SplitOverlay_And_Opportunity_Team_Member</targetReference>
            </connector>
            <label>Satisfies The Condition Total Annual Amount, Cuft, Business Unit Of Product</label>
        </rules>
        <rules>
            <name>Delete_OpportunitySplitOverlay_When_Condition_Met</name>
            <conditionLogic>(1 AND 2 ) OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_OpportunityLineItem_With_Product_Business_Unit_RIM</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity_Split</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_OpportunitySplitOverlay_Created_By_Flow_for_Solution_Executive</targetReference>
            </connector>
            <label>Delete OpportunitySplitOverlay When Condition Met</label>
        </rules>
    </decisions>
