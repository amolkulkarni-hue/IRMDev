    <recordLookups>
        <description>Get OpportunityLineItem filters where Product Business Unit is equal to RIM</description>
        <name>Get_OpportunityLineItem_With_Product_Business_Unit_RIM</name>
        <label>Get OpportunityLineItem With Product Business Unit RIM</label>
        <locationX>908</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Opportunity_Split</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Product_Business_Unit__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>RIM</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>782</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_OpportunityLineItem_With_Product_Business_Unit_RIM</targetReference>
        </connector>
        <filterFormula>AND(
		OR(
		   ISPICKVAL({!$Record.Billing_Country__r.Region__c}, &apos;North America&apos;),
		   ISPICKVAL({!$Record.Billing_Country__r.Region__c}, &apos;Europe&apos;)
		),
		OR(
			ISPICKVAL({!$Record.StageName}, &apos;1 - Qualification&apos;),
			ISPICKVAL({!$Record.StageName}, &apos;2 - Solution Developed&apos;),
			ISPICKVAL({!$Record.StageName}, &apos;3 - Solution Agreed&apos;),
			ISPICKVAL({!$Record.StageName}, &apos;4 - Negotiate&apos;)
		),
               OR(  
                        ISCHANGED({!$Record.Amount}),
                        ISCHANGED({!$Record.AccountId})
                 )
)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
