        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Prior_Deal_Review_Status</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4 OR 5)</filterLogic>
        <filters>
            <field>Deal_Review_Expired__c</field>
