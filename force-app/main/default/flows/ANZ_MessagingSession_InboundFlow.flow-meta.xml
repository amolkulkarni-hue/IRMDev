    <decisions>
        <description>to check the no.of agents availability</description>
        <name>Check_Agent_Availability</name>
        <label>Check Agent Availability</label>
        <locationX>514</locationX>
        <locationY>1438</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>ifAgentsAvailable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Availability_for_Routing_Action.onlineAgentsCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_to_ANZ_Queue</targetReference>
            </connector>
            <label>ifAgentsAvailable</label>
        </rules>
        <rules>
            <name>noAgents</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Availability_for_Routing_Action.onlineAgentsCount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_to_ANZ_No_Agent_Bot</targetReference>
            </connector>
            <label>noAgents</label>
        </rules>
    </decisions>
