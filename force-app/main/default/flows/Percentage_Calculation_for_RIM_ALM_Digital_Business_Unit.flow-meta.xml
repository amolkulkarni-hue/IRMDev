    <description>Percent of “Total Annual Amount (Converted)” for given “Opportunity ID” for which “Business Unit” = RIM , ALM , Digital Presented as: % of total</description>
    <environments>Default</environments>
    <formulas>
        <name>PercentageCalculationALM</name>
        <dataType>Number</dataType>
        <expression>IF({!TotalAmountALM &gt; 0 }, (({!TotalAmountALM}/{!Get_Currency_Conversion_Rate.ConversionRate} )/({!$Record.Amount}/{!Get_Currency_Conversion_Rate.ConversionRate} )) * 100, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PercentageCalculationDigital</name>
        <dataType>Number</dataType>
        <expression>IF({!TotalAmountDigital &gt; 0 }, (({!TotalAmountDigital}/{!Get_Currency_Conversion_Rate.ConversionRate} )/({!$Record.Amount}/{!Get_Currency_Conversion_Rate.ConversionRate} )) * 100, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PercentageCalculationRIM</name>
        <dataType>Number</dataType>
        <expression>IF({!TotalAmountRIM &gt; 0 }, (({!TotalAmountRIM}/{!Get_Currency_Conversion_Rate.ConversionRate} )/({!$Record.Amount}/{!Get_Currency_Conversion_Rate.ConversionRate} )) * 100, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Percentage Calculation for RIM , ALM , Digital Business Unit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Percentage Calculation for RIM , ALM , Digital Business Unit</label>
