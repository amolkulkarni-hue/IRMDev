    <decisions>
        <description>Check Separate Project Invoice Flag at Account Level to Group the Order Products</description>
        <name>Is_Separate_Project_Invoice</name>
        <label>Is Separate Project Invoice</label>
        <locationX>971</locationX>
        <locationY>419</locationY>
        <defaultConnector>
            <targetReference>Update_Bill_To_Site_Number_for_Invoice_Group_ID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.blng__Account__r.QTB_Separate_Project_Invoice__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Number_for_Invoice_Group_ID</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
