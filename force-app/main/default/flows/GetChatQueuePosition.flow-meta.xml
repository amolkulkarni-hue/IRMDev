<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>waiting queue position</description>
        <name>queuePosition</name>
        <label>queuePosition</label>
        <locationX>818</locationX>
        <locationY>223</locationY>
        <assignmentItems>
            <assignToReference>queueCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>GetAwatiChatTranscript</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>This flow will get the users queue position</description>
    <environments>Default</environments>
    <interviewLabel>GetChatQueuePosition {!$Flow.CurrentDateTime}</interviewLabel>
    <label>GetChatQueuePosition</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all the awaiting chat transcript record.</description>
        <name>GetAwatiChatTranscript</name>
        <label>GetAwatiChatTranscript</label>
        <locationX>646</locationX>
        <locationY>224</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>queuePosition</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Waiting</stringValue>
            </value>
        </filters>
        <filters>
            <field>Language_Selector__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getChatTranscriptRecord.Language_Selector__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LiveChatButtonId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getChatTranscriptRecord.LiveChatButtonId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>LiveChatTranscript</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>get the current user chat transcript record.</description>
        <name>getChatTranscriptRecord</name>
        <label>getChatTranscriptRecord</label>
        <locationX>499</locationX>
        <locationY>225</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetAwatiChatTranscript</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>chatTranscriptID</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>LiveChatTranscript</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>373</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>getChatTranscriptRecord</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>chatTranscriptID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>queueCount</description>
        <name>queueCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
