        </faultConnector>
        <inputReference>OrderCollection</inputReference>
    </recordCreates>
    <screens>
        <description>Screen to capture the Order Number, Quantity, Order Type and manual Order Reason for the Order Details</description>
        <name>Orders</name>
        <label>Orders</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Loop_Repeater</targetReference>
        </connector>
        <fields>
            <name>OrdersRepeter</name>
            <fieldType>Repeater</fieldType>
            <fields>
                <name>Order_Number</name>
                <dataType>String</dataType>
                <fieldText>Order Number</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
            </fields>
            <fields>
                <name>Quantity</name>
                <dataType>Number</dataType>
                <defaultValue>
                    <numberValue>1.0</numberValue>
                </defaultValue>
                <fieldText>Quantity</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <scale>0</scale>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
                <validationRule>
                    <errorMessage>&lt;p&gt;Please enter a quantity that is greater than 0 and does not exceed 999&lt;/p&gt;</errorMessage>
                    <formulaExpression>AND({!OrdersRepeter.AllItems[$EachItem].Quantity} &gt;0 ,
LEN(TEXT({!OrdersRepeter.AllItems[$EachItem].Quantity})) &lt;= 3)</formulaExpression>
                </validationRule>
            </fields>
            <fields>
                <name>Order_Type</name>
                <choiceReferences>OrderTypeChoice</choiceReferences>
                <dataType>String</dataType>
                <fieldText>Order Type</fieldText>
                <fieldType>DropdownBox</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
            </fields>
            <fields>
                <name>Manual_Order_Reason</name>
                <choiceReferences>ManualOrderReasonChoice</choiceReferences>
                <dataType>String</dataType>
                <fieldText>Manual Order Reason</fieldText>
                <fieldType>DropdownBox</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
            </fields>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <helpText>&lt;p&gt;If you placed multiple order types, use the &quot;Add&quot; option to add them&lt;/p&gt;</helpText>
