    <assignments>
        <description>Adding single to collection</description>
        <name>Assignment_Collection</name>
        <label>Assignment Collection</label>
        <locationX>270</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>OrderCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>OrderSingle</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Repeater</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign caseRecordId, Order Number, Quantity , Order Type and Manual Order Reason from the screen inputs</description>
        <name>AssignSingleVar</name>
        <label>AssignSingleVar</label>
        <locationX>270</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>OrderSingle.Case__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OrderSingle.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Repeater.Order_Number</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OrderSingle.Order_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Repeater.Order_Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OrderSingle.Manual_Order_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Repeater.Manual_Order_Reason</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OrderSingle.Quantity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Repeater.Quantity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assignment_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>To Check Order Details are created or not</description>
        <name>To_check_order_details</name>
        <label>To check order details</label>
        <locationX>182</locationX>
        <locationY>758</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Orders_created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OrderCollection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SC_Success_Screen</targetReference>
            </connector>
            <label>Orders created</label>
        </rules>
    </decisions>
    <description>To capture the order number, order type, manual order reason and quantity for each order placed for customers
#24128, This screen flow is placed under the &apos;Order Details&apos; tab of the  Case Record Page and IME_Service_Case_Page (Global orders case).</description>
    <dynamicChoiceSets>
        <description>Manual order reason from the Order details</description>
        <name>ManualOrderReasonChoice</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Manual_Order_Reason__c</picklistField>
        <picklistObject>Order_Detail__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>OrderTypeChoice</name>
        <dataType>Picklist</dataType>
