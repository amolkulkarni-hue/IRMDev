    <recordLookups>
        <description>Querying cases to check if there is a secondary case associated with the customer profile - Secondary service line selection in NCSP wizard will generate two cases</description>
        <name>Get_Secondary_Case</name>
        <label>Get Secondary Case</label>
        <locationX>930</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Secondary_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Customer_Profile__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Customer_Profile__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>SecondaryServiceLineVar</assignToReference>
            <field>NCSP_Service_line__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>1024</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_for_IMC_customer</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>USA</stringValue>
            </value>
        </filters>
        <filters>
            <field>Country__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Canada</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
