    <decisions>
        <description>If the primary Case service line is RM or One Time Shred then RM app value is true
If the primary Case service line is Shred then Secure Shred app value is true</description>
        <name>Check_Primary_Case_Service_Line</name>
        <label>Check Primary Case Service Line</label>
        <locationX>578</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Check_Secondary_Case_Service_line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Primary_Case_RM_or_OTS</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>One Time Shred</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Multi_Case_RM_Assignment</targetReference>
            </connector>
            <label>Primary Case RM or OTS</label>
        </rules>
        <rules>
            <name>Primary_Case_Shred</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shred</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Multi_Case_Secure_Shred_Assignment</targetReference>
            </connector>
            <label>Primary Case Shred</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checking if a secondary case is present or not</description>
        <name>Check_Secondary_Case</name>
        <label>Check Secondary Case</label>
        <locationX>930</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Single_Case_RM_Secure_Shred_App_Config</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Secondary Case</defaultConnectorLabel>
        <rules>
            <name>Yes_Secondary_Case_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SecondaryServiceLineVar</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Primary_Case_Service_Line</targetReference>
            </connector>
            <label>Yes- Secondary Case Available</label>
        </rules>
    </decisions>
    <decisions>
        <description>If the secondary Case service line is RM or DMS or  One Time Shred then RM app value is true
If the secondary Case service line is Shred then Secure Shred app value is true</description>
        <name>Check_Secondary_Case_Service_line</name>
        <label>Check Secondary Case  Service line</label>
        <locationX>578</locationX>
        <locationY>1055</locationY>
        <defaultConnector>
            <targetReference>IMC_CUSTOMER_USER_MULESOFT</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Secondary_Case_RM_or_OTS_or_DMS</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>SecondaryServiceLineVar</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SecondaryServiceLineVar</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>One Time Shred</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SecondaryServiceLineVar</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DMS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Secondary_RM_Assignment</targetReference>
            </connector>
            <label>Secondary Case - RM or OTS or DMS</label>
        </rules>
        <rules>
            <name>Secondary_Case_Shred</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SecondaryServiceLineVar</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shred</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Secondary_Secure_shred_Assignment</targetReference>
            </connector>
            <label>Secondary Case - Shred</label>
        </rules>
    </decisions>
    <decisions>
        <description>DMS only has RM configuration irrespective of one case or multiple cases - If NCSP service line is DMS RM app value is true and Secure Shred app value is false. If Service line is not DMS need to check the secondary service line (two cases will be generated for secondary service line with same customer profile)</description>
        <name>Check_Service_line</name>
        <label>Check Service line</label>
        <locationX>490</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Get_Secondary_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>NOT DMS</defaultConnectorLabel>
        <rules>
            <name>DMS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DMS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DMS_Assign_Application_Configuration</targetReference>
            </connector>
            <label>DMS</label>
        </rules>
    </decisions>
    <decisions>
        <description>Entry Criteria for Calling IM Connect - When customer Id is updated on Case with record type NCSP SKP New Customer Set up</description>
        <name>Decision_for_IMC_customer</name>
        <label>Decision for IMC customer</label>
        <locationX>1150</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Call_IM_Connect</name>
            <conditionLogic>(1 OR 4) AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCSP_SKP_New_Customer_Setup</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_ID__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCSP_DMS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Service_line</targetReference>
            </connector>
            <label>Call IM Connect</label>
        </rules>
    </decisions>
    <decisions>
        <description>Logic to populate RM , and Secure Shred application configuration based on NCSP service line if there is no secondary case associated with the customer profile.</description>
        <name>Single_Case_RM_Secure_Shred_App_Config</name>
        <label>Single Case RM &amp; Secure Shred App Config</label>
        <locationX>1282</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RM_Single_Case</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RM_True_Single_Case</targetReference>
            </connector>
            <label>RM Single Case</label>
        </rules>
        <rules>
            <name>Secure_Shred_Single_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shred</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Secure_Shred_True_Single_Case</targetReference>
            </connector>
            <label>Secure Shred Single Case</label>
        </rules>
    </decisions>
