    <formulas>
        <description>based on language code we are updating the language</description>
        <name>LanguageFormula</name>
        <dataType>String</dataType>
        <expression>CASE({!SelectLanguage}, &quot;en-US&quot;, &quot;English (US)&quot;,
&quot;en-CA&quot;,&quot;English (Canada)&quot;,
&quot;en-GB&quot;,&quot;English (UK)&quot;,
&quot;en-IE&quot;,&quot;English (Ireland)&quot;,
&quot;cs-CZ&quot;,&quot;Czech (Czech Republic)&quot;,
&quot;nl-BE&quot;,&quot;Dutch (Belgium)&quot;,
&quot;nl-NL&quot;,&quot;Dutch (Netherlands)&quot;,
&quot;es-ES&quot;,&quot;Spanish (Spain)&quot;,
&quot;fr-CA&quot;,&quot;French (Canada)&quot;,
&quot;fr-FR&quot;,&quot;French (France)&quot;,
&quot;de-DE&quot;,&quot;German (Germany)&quot;,
&quot;el-GR&quot;,&quot;Greek (Greece)&quot;,
&quot;hu-HU&quot;,&quot;Hungarian (Hungary)&quot;,
&quot;ro-RO&quot;,&quot;Romanian (Romania)&quot;,
&quot;sk-SK&quot;,&quot;Slovak (Slovakia)&quot;,
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Used for updating the name of the messaging user object that is linked to the messaging session object.</description>
        <name>NameFormula</name>
        <dataType>String</dataType>
        <expression>{!FirstName} + &apos; &apos; + {!LastName}</expression>
    </formulas>
    <formulas>
        <description>Utilized for updating the fallback queue when routing is not connected to the enhanced bot.</description>
        <name>QueueFormula</name>
        <dataType>String</dataType>
        <expression>CASE({!LanguageFormula},
&quot;Dutch (Belgium)&quot;, &quot;BEL_IMConnect&quot;,
&quot;Czech (Czech Republic)&quot;,&quot;CZE_IMConnect&quot;,
