&quot;Hungarian (Hungary)&quot;,&quot;HUN_IMConnect&quot;,
&quot;English (US)&quot;,&quot;NAS_IMConnect&quot;,
&quot;English (Canada)&quot;,&quot;NAS_IMConnect&quot;,
&quot;Dutch (Netherlands)&quot;,&quot;NLD_IMConnect&quot;,
