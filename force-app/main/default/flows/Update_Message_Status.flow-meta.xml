<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the: Update Message Status workflow rule
Workflow rule description: Checks the &quot;Active&quot; box whenever dates are filled out on a newly created carousel message record.&quot;</description>
    <environments>Default</environments>
    <interviewLabel>Update Message Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Message Status</label>
    <migratedFromWorkflowRuleName>Update Message Status</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Checks the active checkbox on a carousel message if the Start Date is filled out and the message should be displayed.  If there is no Start Date, then the active checkbox is used at the user&apos;s discretion.</description>
        <name>Activate_Message</name>
        <label>Activate Message</label>
        <locationX>440</locationX>
        <locationY>276</locationY>
        <inputAssignments>
            <field>Active__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Unchecks the active checkbox on a carousel message if the End Date is filled out and the message should no longer be displayed.</description>
        <name>Deactivate_Message</name>
        <label>Deactivate Message</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <inputAssignments>
            <field>Active__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Start_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>End_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Announcement__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X0_Days_After_Carousel_Announcement_End_Date</name>
            <connector>
                <targetReference>Deactivate_Message</targetReference>
            </connector>
            <label>0 Days After Carousel Announcement: End Date</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>End_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>X0_Days_After_Carousel_Announcement_Start_Date</name>
            <connector>
                <targetReference>Activate_Message</targetReference>
            </connector>
            <label>0 Days After Carousel Announcement: Start Date</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Start_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
