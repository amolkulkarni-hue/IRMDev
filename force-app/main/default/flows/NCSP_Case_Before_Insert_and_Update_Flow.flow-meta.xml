    <decisions>
        <description>NCSP Shred Supplies Check (#13267)
Gitlab #27516, #27513- Added new condition so decision executes only in an update scenario as part of entry criteria optimization.</description>
        <name>Before_Update_Decision</name>
        <label>Before Update Decision</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NCSP_Shred_Supplies_Check</name>
            <conditionLogic>( 1 OR 2 OR 3 ) AND ( 4 OR 5 ) AND 6 AND 7 AND 8</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCSP_Upsell</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCSP_SKP_Department_Add_Only</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCSP_SKP_New_customer_setup</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shred</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NCSP_Service_line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>One Time Shred</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Shred_Quantity_Consoles_Ordered__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Shred_Quantity_65_Gallon_Ordered__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Supplies_Order_Required</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>NCSP Shred Supplies Check</label>
        </rules>
    </decisions>
    <decisions>
        <description>Added the decision along with the change Gitlab- #27516, #27513 as previously account queried for all records update</description>
        <name>Check_Bill_To_Site_Number</name>
        <label>Check Bill To Site Number</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>NCSP_Upsell_ALM</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not present</defaultConnectorLabel>
        <rules>
            <name>Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Bill_To_Site_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Data</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <decisions>
        <description>Gitlab #27531 - assign Bill To Site Number on case from Account - Customer Number field if Contract Status on the case is changed to Document Accepted and Account is a Billing Account.
Gitlab #27516 - For OTO, update Bill To Site Number and owner to NCSP FIFO queue on case creation.</description>
        <name>NCSP_Upsell_ALM</name>
        <label>NCSP Upsell ALM</label>
        <locationX>314</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>Before_Update_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OTO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_Profile__r.Deal_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Upsell</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_Profile__r.NCSP_Service_Line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DB&amp;R</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_Profile__r.SITAD_Product_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OTO</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCSP_Upsell</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>QTB_Billing_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OTO_Assignment</targetReference>
            </connector>
            <label>OTO</label>
        </rules>
        <rules>
            <name>Program</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_Profile__r.Deal_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Upsell</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_Profile__r.NCSP_Service_Line__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DB&amp;R</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Customer_Profile__r.SITAD_Product_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Program</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contract_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contract_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Document Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>QTB_Billing_Account</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NCSP_Upsell</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Bill_to_Site_Number</targetReference>
            </connector>
            <label>Program</label>
        </rules>
    </decisions>
    <description>Use this flow for all NCSP case before scenario. eg: Case Field Update
Gitlab - #27516, #27531. NCSP ALM OTO &amp; Program Bill to Site Number, Case Owner Update. Also optimized entry criteria to user formula to check record type.</description>
    <environments>Default</environments>
