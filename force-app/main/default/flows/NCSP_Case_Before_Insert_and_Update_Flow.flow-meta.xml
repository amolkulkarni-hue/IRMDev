        <name>Update_Supplies_Order_Required</name>
        <label>Update Supplies Order Required</label>
        <locationX>50</locationX>
        <locationY>611</locationY>
        <assignmentItems>
            <assignToReference>$Record.Supplies_Order_Required__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No</stringValue>
