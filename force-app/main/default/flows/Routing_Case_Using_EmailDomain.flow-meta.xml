        <label>Case Owner Check</label>
        <locationX>182</locationX>
        <locationY>575</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Assign_Case_Owner_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AssignCaseOwner</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Record_Update</targetReference>
            </connector>
            <label>Assign Case Owner Check True</label>
        </rules>
    </decisions>
    <formulas>
        <name>CaseEmailDomainFormula</name>
        <dataType>String</dataType>
        <expression>&apos;@&apos;+SUBSTITUTE( {!CaseEmailName}, LEFT({!CaseEmailName}, FIND(&quot;@&quot;, {!CaseEmailName})), NULL)</expression>
    </formulas>
    <interviewLabel>Routing Case Using EmailDomain {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Routing Case Using EmailDomain</label>
    <processMetadataValues>
        <name>BuilderType</name>
