<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Marks Country Parent Account Type as Active</description>
        <name>Type_is_Active</name>
        <label>Type is Active</label>
        <locationX>50</locationX>
        <locationY>1187</locationY>
        <assignmentItems>
            <assignToReference>Get_Country_Parent_Account.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Type_on_Country_Parent</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Marks Country Parent as Inactive</description>
        <name>Type_is_Inactive</name>
        <label>Type is Inactive</label>
        <locationX>578</locationX>
        <locationY>1187</locationY>
        <assignmentItems>
            <assignToReference>Get_Country_Parent_Account.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inactive</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Type_on_Country_Parent</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Marks Country Parent Account as Prospect</description>
        <name>Type_is_Prospect</name>
        <label>Type is Prospect</label>
        <locationX>314</locationX>
        <locationY>1187</locationY>
        <assignmentItems>
            <assignToReference>Get_Country_Parent_Account.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Prospect</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Type_on_Country_Parent</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <description>Filters all the Active Sales Site Accounts under the Country Parent</description>
        <name>FIlter_Active_Sales_Site_Accounts</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>FIlter Active Sales Site Accounts</label>
        <locationX>446</locationX>
        <locationY>755</locationY>
        <assignNextValueToReference>currentItem_FIlter_Active_Sales_Site_Accounts</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Sales_Site_Accounts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_FIlter_Active_Sales_Site_Accounts.Type</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Active</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Filter_Prospect_Sales_Site_Accounts</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Filter_Inactive_Sales_Site_Accounts</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Inactive Sales Site Accounts</label>
        <locationX>446</locationX>
        <locationY>971</locationY>
        <assignNextValueToReference>currentItem_Filter_Inactive_Sales_Site_Accounts</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Sales_Site_Accounts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Inactive_Sales_Site_Accounts.Type</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Inactive</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Are_there_any_Active_Accounts</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <description>Filters all the Prospect Sales Site Accounts</description>
        <name>Filter_Prospect_Sales_Site_Accounts</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Prospect Sales Site Accounts</label>
        <locationX>446</locationX>
        <locationY>863</locationY>
        <assignNextValueToReference>currentItem_Filter_Prospect_Sales_Site_Accounts</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Sales_Site_Accounts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Prospect_Sales_Site_Accounts.Type</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Prospect</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Filter_Inactive_Sales_Site_Accounts</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <description>If there is at least 1 Active child(Sales Site) Account , then Type is updated to Active, else if there is at least one Prospect Child(Sales Site) Account then Type is Updated to Prospect else update Type as Inactive</description>
        <name>Are_there_any_Active_Accounts</name>
        <label>Are there any Active Accounts?</label>
        <locationX>446</locationX>
        <locationY>1079</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FIlter_Active_Sales_Site_Accounts</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Country_Parent_Account.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Type_is_Active</targetReference>
            </connector>
            <label>Yes_Active</label>
        </rules>
        <rules>
            <name>All_Prospect</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_Prospect_Sales_Site_Accounts</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Country_Parent_Account.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Prospect</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>FIlter_Active_Sales_Site_Accounts</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Filter_Inactive_Sales_Site_Accounts</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Type_is_Prospect</targetReference>
            </connector>
            <label>All Prospect</label>
        </rules>
        <rules>
            <name>No_Active_and_Prospect_Child_Accounts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FIlter_Active_Sales_Site_Accounts</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Country_Parent_Account.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Filter_Inactive_Sales_Site_Accounts</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Type_is_Inactive</targetReference>
            </connector>
            <label>No Active and Prospect Child Accounts</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if there are child Accounts under the Country Parent or not.
If yes runs path Yes else runs default Outcome</description>
        <name>Are_there_any_Child_Accounts_under_Country_Parent</name>
        <label>Are there any Child Accounts under Country Parent?</label>
        <locationX>776</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sales_Site_Accounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FIlter_Active_Sales_Site_Accounts</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks for Country parent&apos;s type. If its Sanctioned or Partner end the flow.</description>
        <name>Is_Country_Parent_Sanctioned_Partner</name>
        <label>Is Country Parent Sanctioned/Partner</label>
        <locationX>1073</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Sanctioned_or_Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Country_Parent_Account.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Sanctioned (Do Not Contact)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Country_Parent_Account.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Partner</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Country_Parent_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sales_Site_Accounts</targetReference>
            </connector>
            <label>Not Sanctioned or Partner</label>
        </rules>
    </decisions>
    <description>#Gitlab Story: 26453
This flow Updates Type on Country Parent Account
If there is at least one Active Sales Site Account then Country Parent  Type is marked as Active,  else
If there is at least one Prospect Sales Site Account, then Country Parent Type is marked as Prospect else
Country Parent Type is marked as Inactive.
Note: Flow is excluded to run for Sanctioned and Partner Country Parent Accounts
Gitlab Story #36371
Updated Country parent and imga Type</description>
    <environments>Default</environments>
    <interviewLabel>Populate Type on Country Parent Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Populate Type on Country Parent Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Fetches the Country Parent  Account details of the Triggered Sales Site Account</description>
        <name>Get_Country_Parent_Account</name>
        <label>Get Country Parent Account</label>
        <locationX>1073</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Country_Parent_Sanctioned_Partner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IM_Hierarchy_Level__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Country Parent</stringValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get all the Sales Site Accounts Under the Country Parent</description>
        <name>Get_Sales_Site_Accounts</name>
        <label>Get Sales Site Accounts</label>
        <locationX>776</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Are_there_any_Child_Accounts_under_Country_Parent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IM_Hierarchy_Level__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sales (Site)</stringValue>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update Type on Country Parent
- If there are any Active Sales Site Accounts update Type on Country Parent to Active else
- If there are any Prospect Accounts update Type of Country Parent to Prospect else
- Update Account Type to Inactive</description>
        <name>Update_Type_on_Country_Parent</name>
        <label>Update Type on Country Parent</label>
        <locationX>446</locationX>
        <locationY>1379</locationY>
        <inputReference>Get_Country_Parent_Account</inputReference>
    </recordUpdates>
    <start>
        <locationX>947</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Country_Parent_Account</targetReference>
        </connector>
        <filterFormula>AND(
ISCHANGED({!$Record.Type}),
ISPICKVAL({!$Record.IM_Hierarchy_Level__c}, &apos;Sales (Site)&apos;),
NOT(ISPICKVAL({!$Record.Parent.Type},&apos;Sanctioned (Do Not Contact)&apos;)),
NOT(ISPICKVAL({!$Record.Parent.Type},&apos;Partner&apos;)),
NOT(ISBLANK({!$Record.ParentId}))
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>CountryParentID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>currentItem_Active_Sales_Site_accounts_of_Country_Parent</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>currentItem_FIlter_Active_Sales_Site_Accounts</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>currentItem_Filter_Inactive_Sales_Site_Accounts</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>currentItem_Filter_Prospect_Sales_Site_Accounts</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
