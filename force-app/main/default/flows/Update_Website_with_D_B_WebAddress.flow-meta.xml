<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>#23797  : The &quot;Website&quot; field should be automatically populated with the &quot;D&amp;B web Address&quot; if the Website field is empty.</description>
    <environments>Default</environments>
    <formulas>
        <name>GetDBWebaddress</name>
        <dataType>String</dataType>
        <expression>{!$Record.DnB_Web_Address__c}</expression>
    </formulas>
