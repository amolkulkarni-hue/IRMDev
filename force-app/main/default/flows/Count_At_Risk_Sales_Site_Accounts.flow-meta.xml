            </conditions>
            <connector>
                <targetReference>Get_Sales_Site_Accounts_under_IMGA</targetReference>
            </connector>
            <label>Has Account</label>
        </rules>
    </decisions>
    <description>#29594 - Updates an &apos;At Risk&apos; counter on the IMGA Account that updates when the monthly risk model identifies a customer/Sales Site Accounts as &apos;At-Risk&apos;</description>
    <environments>Default</environments>
    <formulas>
        <description>Converts the Account ID from 18 to 15 digits</description>
        <name>ID</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Account_Details.Id}, 15)</expression>
    </formulas>
