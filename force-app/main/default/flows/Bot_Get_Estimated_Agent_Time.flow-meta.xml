<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Agent_EWT_in_Min</name>
        <label>Agent EWT in Min</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>waitTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>agentEWTinMin</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Agent_EWT_less_than_0</name>
        <label>Agent EWT less than 0</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>waitTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Agent_Avaialble</name>
        <label>Check Agent Avaialble</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Agent_EWT_less_than_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Agent Not Available</defaultConnectorLabel>
        <rules>
            <name>Agent_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isAgentAvailable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Agent_EWT_in_Min</targetReference>
            </connector>
            <label>Agent Available</label>
        </rules>
    </decisions>
    <description>V2: Check if agent available or not.</description>
    <environments>Default</environments>
    <formulas>
        <name>agentEWTinMin</name>
        <dataType>Number</dataType>
        <expression>IF({!varEWTinSec} &lt; 0,0,{!varEWTinSec}/60)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Bot Get Estimated Agent Time {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bot Get Estimated Agent Time</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Agent_EWT</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Get_Agent_EWT</name>
        <label>Get Agent EWT</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Check_Agent_Avaialble</targetReference>
        </connector>
        <flowName>Agent_Estimated_Wait_Time_Queue</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>isAgentAvailable</assignToReference>
            <name>isAgentAvailable</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varEWTinSec</assignToReference>
            <name>varEWT</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>isAgentAvailable</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>messagingSessionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varEWTinSec</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>waitTime</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
