    <textTemplates>
        <name>NCSP_ALM_Upsell_OTO_Chatter_Post</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Deal Type on the Customer Profile should be Upsell. NCSP Service Line on the Customer Profile should be DB&amp;R. SITAD Product Type on the Customer Profile should be OTO. Account associated to the case should be a billing account. Please ensure all these conditions are met and update Bill To Site Number on the case and move the case to NCSP FIFO queue. Case number - #{!$Record.CaseNumber}</text>
    </textTemplates>
    <textTemplates>
