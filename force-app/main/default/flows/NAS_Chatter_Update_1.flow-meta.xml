<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Post to Chatter</description>
        <name>Chatter_Post</name>
        <label>Chatter Post</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>NAS_PostToChatterAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>message</name>
            <value>
                <elementReference>Messagebody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>subjectId</name>
            <value>
                <elementReference>$Record.Parent:Case.Owner:User.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>NAS_PostToChatterAction</nameSegment>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Migrated from the NAS Chatter Update process using NAS Case criteria.
@mention case owner when case they own received a chatter post
(Gitlab user story #20428 for reference)</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula defines the message the case owner will see</description>
        <name>Messagebody</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;p&gt; {&apos; &amp; {!$Record.Parent:Case.ownerId} &amp; &apos;}, you have a case update to view: {&apos; &amp; {!$Record.Parent:Case.Id} &amp; &apos;} &lt;/p&gt;&apos;</expression>
    </formulas>
    <interviewLabel>NAS Chatter Update_1 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NAS Chatter Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Chatter_Post</targetReference>
        </connector>
        <filterFormula>{!$Record.Parent:Case.RecordType.DeveloperName} == &apos;NAS_General_Support_Case&apos; &amp;&amp; BEGINS({!$Record.Parent:Case.OwnerId}, &apos;005&apos;)  &amp;&amp;  {!$Record.CreatedBy:User.Id} != {!$Record.Parent:Case.OwnerId}</filterFormula>
        <object>FeedItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
