<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>For each path the flow can take, create an outcome. For each outcome, specify the conditions that must be met for the flow to take that path</description>
        <name>Are_there_any_existing_plan_to_win_records</name>
        <label>Are there any existing plan to win records?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Found Records</defaultConnectorLabel>
        <rules>
            <name>No_Records_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ListOfPlantoWinRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_PlanToWin_Record</targetReference>
            </connector>
            <label>No Records Found</label>
        </rules>
    </decisions>
    <description>Evaluates if a Plan to Win exists on the Oppty record, if not if creates one,</description>
    <environments>Default</environments>
    <interviewLabel>Deal_Review_Plan_to_Win_Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Deal_Review_Plan_to_Win_Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create a new Plan To Win record on the Oppty</description>
        <name>Create_PlanToWin_Record</name>
        <label>Create PlanToWin Record</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <inputAssignments>
            <field>Brief_Account_History__c</field>
            <value>
                <elementReference>input_Deal_Review.Account__r.Brief_Account_History__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity_Overview__c</field>
            <value>
                <elementReference>input_Deal_Review.Opportunity__r.Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>input_Deal_Review.Opportunity__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Proposed_Solution__c</field>
            <value>
                <elementReference>input_Deal_Review.Opportunity__r.IM_Technical_Summary__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_PlanToWin_RecordTypeId.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sales_Play__c</field>
            <value>
                <elementReference>input_Deal_Review.Opportunity__r.IM_Sales_Event__c</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity_Plan__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Fetch the existing Plan to Win records tied to the Opportunity parent from the triggering Deal Review</description>
        <name>Get_Existing_Plan_to_Win_records</name>
        <label>Get Existing Plan to Win records</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Are_there_any_existing_plan_to_win_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>input_Deal_Review.Opportunity__r.Id</elementReference>
            </value>
        </filters>
        <object>Opportunity_Plan__c</object>
        <outputReference>ListOfPlantoWinRecords</outputReference>
        <queriedFields>Id</queriedFields>
        <sortField>Id</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <description>to fetch the Plan to Win record type Id</description>
        <name>Get_PlanToWin_RecordTypeId</name>
        <label>Get PlanToWin RecordTypeId</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Existing_Plan_to_Win_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>PlanToWinRecordTypeName</elementReference>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity_Plan__c</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <sortField>Id</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_PlanToWin_RecordTypeId</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>accepts the triggering Deal Review record from the parent flow</description>
        <name>input_Deal_Review</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Deal_Review__c</objectType>
    </variables>
    <variables>
        <name>ListOfPlantoWinRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity_Plan__c</objectType>
    </variables>
    <variables>
        <name>PlanToWinRecordTypeName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Plan_to_Win</stringValue>
        </value>
    </variables>
</Flow>
