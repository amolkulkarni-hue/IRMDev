<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Agent_Phone</name>
        <label>Assign Agent Phone</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.nfvoice__Agent_Phone__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Phone</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Gitlab #27480 - check if Phone field has changed on the User record, so that it&apos;s value can be copied into the Agent Phone field on User. Agent Phone is a field from the managed package &quot;Voice Essentials&apos;.</description>
        <name>Phone_has_changed</name>
        <label>Phone has changed ?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Agent_Phone</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Gitlab #27480 - Copy Phone from User record to Agent Phone field on User if Phone field&apos;s value has changed. &quot;Agent Phone&quot; is a field from the managed package &quot;Voice Essentials&quot;.</description>
    <environments>Default</environments>
    <interviewLabel>Assign Agent Phone Voice Essentials {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Assign Agent Phone Voice Essentials</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
