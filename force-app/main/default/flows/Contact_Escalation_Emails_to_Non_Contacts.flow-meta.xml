    <description>This flow has been created to show warning notification if a case email is being sent to someone other than 1) the case contact 2) someone with the same email domain as the contact or 3) a contact with an ironmountain.com domain. For reference, check user story #26421 on Gitlab
updated the flow to include NCSP, Orders &amp; CLAS Record types #26446 on Gitlab
updated the flow to include CAC Executive Escalations Record Type #27572 on Gitlab</description>
    <environments>Default</environments>
    <formulas>
        <name>checkValid</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!ToAddressDomain}, &quot;ironmountain&quot;) || CONTAINS({!ToAddressDomain}, {!ContactDomain})</expression>
    </formulas>
    <formulas>
        <name>ContactDomain</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!$Record.Parent.ContactEmail}, LEFT({!$Record.Parent.ContactEmail}, FIND(&quot;@&quot;, {!$Record.Parent.ContactEmail})), NULL)</expression>
    </formulas>
    <formulas>
        <name>ToAddressDomain</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!$Record.ToAddress}, LEFT({!$Record.ToAddress}, FIND(&quot;@&quot;, {!$Record.ToAddress})), NULL)</expression>
    </formulas>
    <interviewLabel>Contact Escalation Emails to Non Contacts {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Escalation Emails to Non Contacts</label>
