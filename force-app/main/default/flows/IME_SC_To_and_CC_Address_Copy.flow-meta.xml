        </rules>
    </decisions>
    <description>Converted from &apos;IME_SC_To_and_CC_Address_Copy&apos; workflow</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailReceivedonClosedCases</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.Parent.NAS_Email_Received_on_Closed_Cases__c}), 
			1,
			{!$Record.Parent.NAS_Email_Received_on_Closed_Cases__c} + 1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>GetCcAddress</name>
        <dataType>String</dataType>
        <expression>{!$Record.CcAddress}</expression>
    </formulas>
    <formulas>
        <name>GetFromAddress</name>
        <dataType>String</dataType>
        <expression>{!$Record.FromAddress}</expression>
    </formulas>
    <formulas>
        <name>GetToAddress</name>
        <dataType>String</dataType>
        <expression>{!$Record.ToAddress}</expression>
    </formulas>
    <interviewLabel>IME_SC_To_and_CC_Address_Copy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IME_SC_To_and_CC_Address_Copy</label>
    <processMetadataValues>
