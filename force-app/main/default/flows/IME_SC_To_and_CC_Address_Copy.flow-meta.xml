            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>IME_SC_CC_Address2__c</field>
            <value>
                <elementReference>GetCcAddress</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IME_SC_To_Address2__c</field>
            <value>
                <elementReference>GetToAddress</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>449</locationX>
        <locationY>48</locationY>
