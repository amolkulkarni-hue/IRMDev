    <formulas>
        <name>CustomerIDAppendwithDesc</name>
        <dataType>String</dataType>
        <expression>{!strdescription} + &quot;. Customer ID : &quot; + {!strcustomerid}</expression>
    </formulas>
    <formulas>
        <name>CustomerIDWithDesc</name>
        <dataType>String</dataType>
        <expression>&quot;Preferred Contact : &quot; +  {!StrPreferredcontact} + &quot; Phone Number : &quot; + {!strphonenumber} + &quot; Customer Id : &quot; + {!strcustomerid} +&quot; Company Name : &quot; + {!strcompanyname} + &quot; Description : &quot; + {!strdescription}</expression>
    </formulas>
    <formulas>
        <description>To store order inquiry details</description>
        <name>varOrderDetailsDesc</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISNULL({!StrPreferredcontact})), {!StrPreferredcontact} &lt;&gt; &apos;&apos;), &apos;Preferred Contact :&apos;+ {!StrPreferredcontact},&apos;&apos;)+
IF(AND(NOT(ISNULL({!strphonenumber})), {!strphonenumber} &lt;&gt; &apos;&apos;), &apos; Phone Number :&apos;+ {!strphonenumber},&apos;&apos;)+
IF(AND(NOT(ISNULL({!strcustomerid})), {!strcustomerid} &lt;&gt; &apos;&apos;), &apos; Customer Id :&apos;+ {!strcustomerid},&apos;&apos;)+
IF(AND(NOT(ISNULL({!varSKPOrderIdFromBot})), {!varSKPOrderIdFromBot} &lt;&gt; &apos;&apos;), &apos; Order ID:&apos;+ {!varSKPOrderIdFromBot},&apos;&apos;)</expression>
    </formulas>
