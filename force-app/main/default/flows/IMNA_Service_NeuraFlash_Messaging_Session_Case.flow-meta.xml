    <environments>Default</environments>
    <formulas>
        <name>CaseOrigin</name>
        <dataType>String</dataType>
        <expression>IF ( CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;WhatsApp_Philippines&apos;), &apos;PHI_WhatsApp&apos;,
    IF( CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;India&apos;), &apos;IND_WhatsApp&apos;,
       IF( CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;WhatsApp_Singapore&apos;), &apos;SGP_WhatsApp&apos;,
           IF(CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;WhatsApp_Malaysia&apos;), &apos;MYS_WhatsApp&apos;, &apos;&apos;
           )
       )
    )
)</expression>
    </formulas>
    <formulas>
        <name>Country</name>
        <dataType>String</dataType>
        <expression>IF ( CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;WhatsApp_Philippines&apos;), &apos;Philippines&apos;,
    IF( CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;India&apos;), &apos;India&apos;,
       IF( CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;WhatsApp_Singapore&apos;), &apos;Singapore&apos;,
           IF(CONTAINS({!Get_Messaging_Session.ChannelName}, &apos;WhatsApp_Malaysia&apos;), &apos;Malaysia&apos;, &apos;&apos;
           )
       )
    )
)</expression>
    </formulas>
    <formulas>
        <name>FormCountry</name>
        <dataType>String</dataType>
        <expression>MID({!Get_Messaging_Session.PreviewDetails}, FIND(&quot;|&quot;, {!Get_Messaging_Session.PreviewDetails})+11, LEN({!Get_Messaging_Session.PreviewDetails}))</expression>
    </formulas>
    <formulas>
        <description>Calculates the language to display in the Screen Flow</description>
        <name>FormFlowLanguage</name>
        <dataType>String</dataType>
        <expression>CASE({!FormCountry}, &quot;Argentina | WhatsApp&quot;, &quot;Spanish&quot;, &quot;Brazil | WhatsApp&quot;, &quot;Portuguese&quot;, &quot;Chile | WhatsApp&quot;, &quot;Spanish&quot;, &quot;Colombia | WhatsApp&quot;, &quot;Spanish&quot;, &quot;Mexico | WhatsApp&quot;, &quot;Spanish&quot;, &quot;Peru | WhatsApp&quot;, &quot;Spanish&quot;, &quot;English&quot;)</expression>
    </formulas>
