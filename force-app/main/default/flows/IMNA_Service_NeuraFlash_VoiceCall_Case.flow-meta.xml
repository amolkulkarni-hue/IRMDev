    <formulas>
        <name>originFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Voice_Call.QueueName} = &quot;IMLA_ARG_Orders&quot;, &quot;ARG_PHONE&quot;, 
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_ARG_Care&quot;, &quot;ARG_PHONE&quot;, 
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_PER_Orders&quot;, &quot;PER_PHONE&quot;, 
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_PER_Care&quot;, &quot;PER_PHONE&quot;, 
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_CHL_Orders&quot;, &quot;CHL_PHONE&quot;,
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_CHL_Care&quot;,  &quot;CHL_PHONE&quot;,
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_MEX_Orders&quot;, &quot;MEX_PHONE&quot;, 
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_MEX_Care&quot;, &quot;MEX_PHONE&quot;, 
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_COL_Orders&quot;,&quot;COL_PHONE&quot;, 
IF({!Get_Voice_Call.QueueName} = &quot;IMLA_COL_Care&quot;,&quot;COL_PHONE&quot;,  
&quot;Null&quot;))))))))))</expression>
    </formulas>
