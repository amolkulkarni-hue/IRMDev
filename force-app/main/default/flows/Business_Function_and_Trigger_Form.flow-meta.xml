    <description>Prompts user to select &apos;Business Function&apos; and &apos;Trigger&apos; and outputs variables. At Risk Status choice is &apos;Accept&apos;.</description>
    <dynamicChoiceSets>
        <name>dynAtRiskStatus</name>
        <dataType>String</dataType>
        <displayField>Label__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Accept</stringValue>
            </value>
        </filters>
        <object>AtRiskStatusList__c</object>
        <outputAssignments>
            <assignToReference>vAtRiskBool</assignToReference>
            <field>Boolean_Value__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>vAtRiskScore</assignToReference>
