<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Update the field or sends out an email notification based on the appeal stage</description>
        <name>Appeal_Stage_Change</name>
        <label>Appeal Stage Change</label>
        <locationX>1436</locationX>
        <locationY>611</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Acknowledge_Receipt_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Acknowledge receipt</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Acknowledge_Date_Stamp</targetReference>
            </connector>
            <label>Acknowledge Receipt Update</label>
        </rules>
        <rules>
            <name>Request_More_Info_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Request more information</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Request_More_Info_Stamp</targetReference>
            </connector>
            <label>Request More Info Update</label>
        </rules>
        <rules>
            <name>Under_Review_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Under review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Under_Review_Stamp</targetReference>
            </connector>
            <label>Under Review Update</label>
        </rules>
        <rules>
            <name>Already_Being_Processed_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Already being processed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Already_Being_Processed_Stamp</targetReference>
            </connector>
            <label>Already Being Processed Update</label>
        </rules>
        <rules>
            <name>Accepted_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Accept_Stamp</targetReference>
            </connector>
            <label>Accepted Update</label>
        </rules>
        <rules>
            <name>Denied_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Denied</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Denied_Stamp</targetReference>
            </connector>
            <label>Denied Update</label>
        </rules>
        <rules>
            <name>Appeal_Submission_Counter</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resubmitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Appeal_Submission_1</targetReference>
            </connector>
            <label>Appeal Submission Counter</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if the record is new or the appeal stage is updated. If the appeal stage = acknowledge, checks if the commision rep of finance rep has been assigned</description>
        <name>Created_or_Updated</name>
        <label>Created or Updated</label>
        <locationX>1502</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Created</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>New</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Acknowledge_Date_Stamp_1</targetReference>
            </connector>
            <label>Created</label>
        </rules>
        <rules>
            <name>Current_Stage_Entered_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Current_Stage_Stamp</targetReference>
            </connector>
            <label>Current Stage Entered Date</label>
        </rules>
        <rules>
            <name>Acknowledge_receipt</name>
            <conditionLogic>1 AND ((2 AND 3) OR (4 AND 5))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appeal_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Acknowledge receipt</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Assigned_Commission_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Assigned_Commission_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Assigned_Finance_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Assigned_Finance_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Appeal_Stage_Update</targetReference>
            </connector>
            <label>Acknowledge receipt</label>
        </rules>
    </decisions>
    <decisions>
        <description>update the stage value when a user is assigned to the appeal</description>
        <name>Stage_Update_when_Assigned</name>
        <label>Stage Update when Assigned</label>
        <locationX>446</locationX>
        <locationY>827</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Stage</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Assigned_Commission_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Assigned_Commission_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Assigned_Finance_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Assigned_Finance_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Under_Review</targetReference>
            </connector>
            <label>Update Stage</label>
        </rules>
    </decisions>
    <description>Based on the Appeal Stage the corresponding fields will get updated.
(we have merged 10 different workflow rules from Commission Appeal object in this Flow. For reference use the gitlab story #21002)</description>
    <environments>Default</environments>
    <formulas>
        <name>New</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Fetches the current time</description>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>Now()</expression>
    </formulas>
    <formulas>
        <name>SubmissionCounter</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Appeal_Submission_Attempts__c} + 1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Commission Appeals Stage Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Commission Appeals Stage Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the &quot;Locked Layout&quot; record type for Commission Appeals</description>
        <name>Record_Type</name>
        <label>Record Type</label>
        <locationX>1436</locationX>
        <locationY>503</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Appeal_Stage_Change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Appeal__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Locked_Layout</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
