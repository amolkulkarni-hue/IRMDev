                <rightValue>
                    <stringValue>Billing Order</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QTB_DM_Source_System_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>SITAD</stringValue>
                </rightValue>
