<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>checkAllDocsFinal</name>
        <label>All Required-For-Case Docs Final?</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnector>
            <targetReference>updateCaseIndicatorFalse</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non-Final Docs Exist — Set False</defaultConnectorLabel>
        <rules>
            <name>noNonFinalDocs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNonFinalDocChecklists</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateCaseIndicatorTrue</targetReference>
            </connector>
            <label>No Non-Final Docs — Set True</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow on Document_Checklist__c (After Update). Fires when a Document Checklist&apos;s Status changes to Final and it&apos;s linked to a Case via the Case-first engine (Case__c and Case_Creation_Rule__c both populated — CaseCreationRuleEvaluatorAction sets Case__c at creation time). Maintains Case.All_Start_Docs_Final__c as a status indicator only. Case creation itself is no longer gated here — CaseCreationRuleEvaluatorAction creates the Case (Status=&apos;New&apos;) and every Document_Checklist__c together the moment the Opportunity qualifies (Case-first). This flow previously created the Case only once all &quot;required for case&quot; docs were Final; that gate was removed so the Case and its team are engaged immediately, while this indicator still shows document-collection progress.</description>
    <label>Case Creation Trigger Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getNonFinalDocChecklists</name>
        <label>Get Non-Final Required-For-Case Checklists</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkAllDocsFinal</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Case_Creation_Rule__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case_Creation_Rule__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Final</stringValue>
            </value>
        </filters>
        <object>Document_Checklist__c</object>
        <outputReference>varNonFinalDocChecklists</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>updateCaseIndicatorFalse</name>
        <label>Set All Start Docs Final = false</label>
        <locationX>308</locationX>
        <locationY>408</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>All_Start_Docs_Final__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>updateCaseIndicatorTrue</name>
        <label>Set All Start Docs Final = true</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>All_Start_Docs_Final__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>getNonFinalDocChecklists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Final</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Case__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Case_Creation_Rule__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Document_Checklist__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varNonFinalDocChecklists</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Document_Checklist__c</objectType>
    </variables>
</Flow>
