<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_New_Line</name>
        <label>Assign New Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNewLine.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewLine.Business_Unit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Input_New_BU</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewLine.EAA__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Input_New_EAA</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewLine.Product_Family__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Input_New_Product_Family</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewLine.Product_Line__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Input_New_Product_Line</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewLine.Is_Active__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Opportunity_Recheck</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Is_Qualification</name>
        <label>Is Opportunity in Qualification?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Not_Editable_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Editable</defaultConnectorLabel>
        <rules>
            <name>Is_Qualification</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Add_Line</targetReference>
            </connector>
            <label>Editable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_BU_Already_Active</name>
        <label>Is This Business Unit Already Active?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_New_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Yet Active</defaultConnectorLabel>
        <rules>
            <name>BU_Already_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Line_For_BU.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_BU_Already_Exists_Error</targetReference>
            </connector>
            <label>Already Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Stage_Still_Qualification</name>
        <label>Is Opportunity Still in Qualification?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_New_Line</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Still Qualification</defaultConnectorLabel>
        <rules>
            <name>Stage_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Recheck.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Qualification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Stage_Changed_Error</targetReference>
            </connector>
            <label>Stage Changed — Stop</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>ChoiceSet_BU</name>
        <dataType>Picklist</dataType>
        <picklistField>Business_Unit__c</picklistField>
        <picklistObject>Opportunity_Product_Line__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ChoiceSet_Product_Family</name>
        <dataType>Picklist</dataType>
        <picklistField>Product_Family__c</picklistField>
        <picklistObject>Opportunity_Product_Line__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ChoiceSet_Product_Line</name>
        <dataType>Picklist</dataType>
        <picklistField>Product_Line__c</picklistField>
        <picklistObject>Opportunity_Product_Line__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Add Business Unit Line {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Business Unit Line Add</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_New_Line</name>
        <label>Create New Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Confirmation</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_DML_Error</targetReference>
        </faultConnector>
        <inputReference>varNewLine</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Is_Qualification</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Line_For_BU</name>
        <label>Get Existing Line For BU</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_BU_Already_Active</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Business_Unit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Input_New_BU</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity_Product_Line__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opportunity_Recheck</name>
        <label>Get Opportunity (Re-check Stage)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Stage_Still_Qualification</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Screen_Add_Line</name>
        <label>Add a Business Unit Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Existing_Line_For_BU</targetReference>
        </connector>
        <fields>
            <name>Input_New_BU</name>
            <choiceReferences>ChoiceSet_BU</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Business Unit</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_New_EAA</name>
            <dataType>Currency</dataType>
            <fieldText>Eligible Annual Amount</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <validationRule>
                <formulaExpression>{!Input_New_EAA} &gt;= 0</formulaExpression>
                <errorMessage>Eligible Annual Amount cannot be negative.</errorMessage>
            </validationRule>
        </fields>
        <fields>
            <name>Input_New_Product_Family</name>
            <choiceReferences>ChoiceSet_Product_Family</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Product Family (optional)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Input_New_Product_Line</name>
            <choiceReferences>ChoiceSet_Product_Line</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Product Line (optional)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Not_Editable_Error</name>
        <label>Not Editable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Text_Not_Editable_Error</name>
            <fieldText>&lt;p&gt;This Opportunity is past Qualification stage. Business Unit lines can no longer be added here — they are now driven by CPQ.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_BU_Already_Exists_Error</name>
        <label>Business Unit Already Active</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Text_BU_Already_Exists_Error</name>
            <fieldText>&lt;p&gt;This Business Unit already has an active line on this Opportunity. Use &quot;Edit Business Unit Line&quot; instead to update it.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Stage_Changed_Error</name>
        <label>Stage Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Text_Stage_Changed_Error</name>
            <fieldText>&lt;p&gt;This Opportunity's stage changed while you were editing. Your changes were not saved — please reopen this action to try again.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirmation</name>
        <label>Line Added</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Text_Confirmation</name>
            <fieldText>&lt;p&gt;The new Business Unit line has been added.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_DML_Error</name>
        <label>Error Saving Changes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Text_DML_Error</name>
            <fieldText>&lt;p&gt;An error occurred while saving: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNewLine</name>
        <dataType>SObject</dataType>
        <objectType>Opportunity_Product_Line__c</objectType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
