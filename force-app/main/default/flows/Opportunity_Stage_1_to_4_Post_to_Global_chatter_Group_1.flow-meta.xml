    <description>Migrated from the Opportunity Stage 1 to 4 - Post to Global chatter Group process using multiple criteria.
Case# 06830598- The Chatter post should be posted only when the Opportunity is created and it should not trigger when someone edits the Opportunity later.
#35882 : CRM: Merge Opportunity Stage 1 to 4 and Stage 5 Chatter Post Flows</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	NOT($Setup.Metadata_Activation_Settings__c.Disable_PB__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Opportunity&apos;))), 
	NOT(ISBLANK({!$Record.AccountId} ) ),
	NOT(ISBLANK({!$Record.Account.IM_IMGA_Indexed__c} ) ),
	OR(
	AND(OR(
		ISPICKVAL({!$Record.Type} , &apos;New Deal&apos;),
		ISPICKVAL({!$Record.Type} , &apos;Up-Sell/Lift&apos;) 
	),
	OR(
		ISPICKVAL({!$Record.StageName} , &apos;1 - Qualification&apos;),
		ISPICKVAL({!$Record.StageName} , &apos;2 - Solution Developed&apos;), 
		ISPICKVAL({!$Record.StageName} , &apos;3 - Solution Agreed&apos;),
		ISPICKVAL({!$Record.StageName} , &apos;4 - Negotiate&apos;)
	), 
	
	{!$Record.Amount&gt;=30000}, 
	{!$Record.Global_Chatter__c} =True),
	
	ISPICKVAL({!$Record.StageName},&apos;5 - Signed/PO in&apos;)))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
	NOT($Setup.Metadata_Activation_Settings__c.Disable_PB__c &amp;&amp; OR(ISBLANK($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c), CONTAINS($Setup.Metadata_Activation_Settings__c.SObject_API_Name__c, &apos;Opportunity&apos;))), 
	{!$Record.Global_Chatter__c} = True ,
	NOT(ISBLANK({!$Record.Amount} )) 
)</expression>
    </formulas>
    <formulas>
        <description>Set True if Stage is in 1 - 4</description>
        <name>MarkTrueStage1_4</name>
        <dataType>Boolean</dataType>
        <expression>OR(
		ISPICKVAL({!$Record.StageName} , &apos;1 - Qualification&apos;),
		ISPICKVAL({!$Record.StageName} , &apos;2 - Solution Developed&apos;), 
		ISPICKVAL({!$Record.StageName} , &apos;3 - Solution Agreed&apos;),
		ISPICKVAL({!$Record.StageName} , &apos;4 - Negotiate&apos;)
)</expression>
    </formulas>
    <interviewLabel>Opportunity Stage 1 to 4 - Post to Global chatter Group {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Stage 1 to 4 and Stage 5 - Post to Global chatter Group</label>
