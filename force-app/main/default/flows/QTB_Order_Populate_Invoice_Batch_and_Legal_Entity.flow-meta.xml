<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>if_Billing_account_is_created</name>
        <label>if Billing account is created</label>
        <locationX>567</locationX>
        <locationY>147</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_AD_HOC</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.QTB_OrderCategory__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ad-Hoc</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QTB_OrderCategory__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Legacy</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QTB_DM_Source_System_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SITAD</stringValue>
                </rightValue>
            </conditions>
            <label>If AD-HOC</label>
        </rules>
        <rules>
            <name>if_created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>QTB_Billing_Order</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.QTB_Contract_Entity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.QTB_Bill_Cycle_Day__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QTB_OrderCategory__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Rebill</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_the_invoice_of_the_order</targetReference>
            </connector>
            <label>if created</label>
        </rules>
        <rules>
            <name>Legal_Entity_Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.QTB_Contract_Entity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.QTB_IM_Legal_Entity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_legal_entity_on_order</targetReference>
            </connector>
            <label>Legal Entity Not Null</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>QTB Order Populate Invoice Batch and Legal Entity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QTB Order Populate Invoice Batch and Legal Entity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_legal_entity_on_order</name>
        <label>Update legal entity on order</label>
        <locationX>575</locationX>
        <locationY>383</locationY>
        <inputAssignments>
            <field>bling_Legal_Entity__c</field>
            <value>
                <elementReference>$Record.SBQQ__Quote__r.QTB_IM_Legal_Entity__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>update_the_invoice_of_the_order</name>
        <label>update the invoice  of the order</label>
        <locationX>852</locationX>
        <locationY>147</locationY>
        <inputAssignments>
            <field>bling_Legal_Entity__c</field>
            <value>
                <elementReference>$Record.Account.QTB_Contract_Entity__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>blng__InvoiceBatch__c</field>
            <value>
                <elementReference>$Record.Account.QTB_Bill_Cycle_Day__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>if_Billing_account_is_created</targetReference>
        </connector>
        <object>Order</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
