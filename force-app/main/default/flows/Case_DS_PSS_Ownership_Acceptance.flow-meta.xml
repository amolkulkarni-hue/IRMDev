<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Assigned_Date</name>
        <label>Capture Assigned Date</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>$Record.NF_Assigned_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Status_Accepted</name>
        <label>Set Status = Accepted</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Accepted</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Assigned_Date_Null</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Assigned_Date_Null</name>
        <label>Is Assigned Date empty?</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel
    >Already set — do not overwrite</defaultConnectorLabel>
        <rules>
            <name>Assigned_Date_Is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >fml_Assigned_Date_Is_Null</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Assigned_Date</targetReference>
            </connector>
            <label>Yes — set it</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Owner_Change</name>
        <label>Owner changed to a User?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel
    >No change or Queue owner — skip</defaultConnectorLabel>
        <rules>
            <name>Owner_Changed_to_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >fml_Owner_Changed_to_User</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Accepted</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Record_Type</name>
        <label>Is Deal Support or Post Sale Support?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Other RT — skip</defaultConnectorLabel>
        <rules>
            <name>RT_Is_DS_or_PSS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fml_Is_DS_or_PSS</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Owner_Change</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Before Save — Deal Support and Post Sale Support Cases only.
When a Case is assigned/reassigned to a User (not a Queue), sets Status = Accepted.
Captures NF_Assigned_Date__c on first ownership only (never overwritten).
IMICC9S-2215.</description>
    <environments>Default</environments>
    <formulas>
        <name>fml_Assigned_Date_Is_Null</name>
        <dataType>Boolean</dataType>
        <expression>ISNULL({!$Record.NF_Assigned_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fml_Is_DS_or_PSS</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  {!$Record.RecordType.DeveloperName} = &quot;Deal_Support&quot;,
  {!$Record.RecordType.DeveloperName} = &quot;Post_Sale_Support&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fml_Owner_Changed_to_User</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  BEGINS({!$Record.OwnerId}, &quot;005&quot;),
  OR(
    ISNULL({!$Record__Prior.OwnerId}),
    NOT({!$Record.OwnerId} = {!$Record__Prior.OwnerId})
  )
)</expression>
    </formulas>
    <interviewLabel
  >Case DS/PSS - Ownership Acceptance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case DS/PSS - Ownership Acceptance</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Record_Type</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
