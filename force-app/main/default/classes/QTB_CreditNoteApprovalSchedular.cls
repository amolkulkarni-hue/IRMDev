*******************************************************************************************************/
public class QTB_CreditNoteApprovalSchedular implements System.Schedulable{
    public blng__CreditNote__c eachCreditNote;
    
    // this is the class constructor
    public QTB_CreditNoteApprovalSchedular(blng__CreditNote__c creditNoteParam) {
        eachCreditNote = new blng__CreditNote__c();
        this.eachCreditNote = creditNoteParam;
    }
    
    public void execute(System.SchedulableContext SC){ 
        List<CronTrigger> CronTrigger_objs;
        try{
            //Fetching the CreditNote record
            blng__CreditNote__c  credNote = [SELECT id,blng__TaxAmount__c,QTB_Country__c,QTB_ReBill_Credit_Amount__c,blng__TaxErrorMessage__c,//Gitlab US#24809 
                                             blng__Account__r.QTB_Contract_Entity__r.QTB_Legal_Entity_Number__c,  //Gitlab US#22511--added field in query
                                             blng__RelatedInvoice__c,blng__RelatedInvoice__r.blng__TaxAmount__c,QTB_IsReBill__c,blng__Status__c //Gitlab US#24523
                                             FROM blng__CreditNote__c
                                             WHERE id =: eachCreditNote.id][0];     
            
            //Using Custom Setting named  Credit_ReBill_InvoiceSchedulerValidation__c to get the instance that creditNote if for respective country
            //Gitlab US#22511 -- creating the combination of LegalEntityCountry-LegalEntityNumber and the passing to the method
            string countryWithLegalEntityNumber = credNote.QTB_Country__c +'-' +credNote.blng__Account__r.QTB_Contract_Entity__r.QTB_Legal_Entity_Number__c;
            Credit_ReBill_InvoiceSchedulerValidation__c creditAutoApprovalCondCheck = Credit_ReBill_InvoiceSchedulerValidation__c.getInstance(countryWithLegalEntityNumber);
            // Gitlab US#24176 (Credit/Rebill Billnow)
            String creditnote_TaxCountry = 'ReBillCreditNoteApproval_QTB_CreditNoteApprovalSchedular'+'_'+credNote.QTB_Country__c +'_'+credNote.Id;  
            
            //Fetching CronTrigger_objs based on creditnote_TaxCountry
            CronTrigger_objs = [SELECT Id, CronJobDetail.Name, CronJobDetail.Id,State FROM CronTrigger where CronJobDetail.Name =:creditnote_TaxCountry];    
            
            if(CronTrigger_objs != null && CronTrigger_objs.size() > 0 && !CronTrigger_objs.isEmpty()){
                //Aborting the instance of CronTrigger so that it will not run repeatedly
                System.abortJob(CronTrigger_objs[0].Id);
            }

            // Defect #10736 added condition before submission of approval: for Credit note blng__TaxAmount__c Field Value must not be null
            //Gitlab US#24809 -- added blng__TaxErrorMessage__c check, if no taxError msg then only submit for approval
            //Gitlab US#24523 -- addec check to compare CreditNote.Tax with RelatedInvoice.Tax
            if(creditAutoApprovalCondCheck !=null &&  credNote.QTB_ReBill_Credit_Amount__c > creditAutoApprovalCondCheck.QTB_Threshold_Approval_Amount__c 
               && credNote.blng__TaxAmount__c!=null && credNote.blng__TaxErrorMessage__c == null && credNote.blng__RelatedInvoice__r.blng__TaxAmount__c.setscale(4) == credNote.blng__TaxAmount__c.setscale(4))
            {
                //Calling the Submit for Approval API
                sbaa.ApprovalAPI.submit(credNote.id, sbaa__Approval__c.QTB_Credit_Note__c);            
            }
            //Gitlab US#24523 -- updating the TaxErrorMsg when Tax is not matched between Parent Invoice with Credit Note in Rebill
            else if(Test.isRunningTest() || (credNote.blng__RelatedInvoice__r.blng__TaxAmount__c != credNote.blng__TaxAmount__c && credNote.blng__TaxErrorMessage__c == null &&
                                             credNote.QTB_IsReBill__c == true)){
                blng__CreditNote__c credNoteObj = new blng__CreditNote__c();
                credNoteObj.Id = credNote.Id;
                credNoteObj.blng__Status__c = 'Cancelled';
                credNoteObj.blng__TaxErrorMessage__c = System.Label.QTB_CreditRebillTaxDiffParentInvoiceCreditNote;
                update credNoteObj;
            }
        }
        //catch
        catch (Exception e){
            if(!Test.isRunningTest()){
                System.debug('CronTrigger_objs'+CronTrigger_objs[0].CronJobDetail.Name);
                //Aborting the instance of CronTrigger so that it will not run repeatedly
                if(CronTrigger_objs != null && CronTrigger_objs.size() > 0 && !CronTrigger_objs.isEmpty()){
                    //Aborting the instance of CronTrigger so that it will not run repeatedly
                    System.abortJob(CronTrigger_objs[0].Id);
                }
            }
            QTB_ExceptionLogger.enable();
            QTB_ExceptionLogger.createLog(e.getLineNumber(),e.getStackTraceString(), e.getMessage(), e.getTypeName(), 'QTB_CreditNoteApprovalSchedular_execute');
        }   
    }
    
