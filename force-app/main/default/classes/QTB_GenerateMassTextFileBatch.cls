/*****************************************************************************************************
* Class: QTB_GenerateMassTextFileBatch
* Purpose: This Batch class containing logic for generating only Text file for invoice scheduler.
* Developer     Date           Description
* ------------------------------------------------------------------------------------------- 
*  Gopinandan      03/24/2021       Created initial class
*  
*******************************************************************************************************/
global without sharing class QTB_GenerateMassTextFileBatch implements Queueable,Database.AllowsCallouts {
    string invSchID;
    string invZipId;
    Integer exceptionCount;
    Integer processedCount;
    string invStatus;
    string fileVersionName;
    Set<id> invIds;
    Map<id,string> skipBigInvoiceMap;
    integer invBatchNumber;
    boolean IsLastinvoiceChunk;
    integer totalInvoice;
    string invSchName;
    List<id> allInvList;
    public List<blng__Invoice__c> finalValidatedInvoices;
    integer jobCount = 0;
    integer totalJobCountFinal = 0;
    Map<integer, List<blng__Invoice__c>> finalMap;
    //Call Construtor
    global QTB_GenerateMassTextFileBatch(Map<integer, List<blng__Invoice__c>> finalMaps, string invSch,string invScheName, string InvZip,string invStatusToGen, string fileName, Map<id,string> skipInvoiceMap, integer totalInvoices, List<id> allInvLists,integer currentCount, integer totalCount)
    {
        finalMap = new Map<integer, List<blng__Invoice__c>>();
        finalMap = finalMaps;
        jobCount = currentCount + 1;
        totalJobCountFinal = totalCount;
        invSchID = invSch;
        invSchName = invScheName;
        invZipId = InvZip;
        invStatus = invStatusToGen;
        fileVersionName = fileName;
        //invBatchNumber = invBatchNumbers;
        invBatchNumber = jobCount - 1;
        //IsLastinvoiceChunk = LastinvoiceChunk;
        totalInvoice = totalInvoices;
        invIds = new Set<id>();
        skipBigInvoiceMap = new Map<id,string>();
        if(skipInvoiceMap != null && skipInvoiceMap.size() > 0){
            skipBigInvoiceMap = skipInvoiceMap;
        }
        allInvList = new List<id>();
        allInvList.addAll(allInvLists); 
        exceptionCount = 0;
        processedCount = 0;
        try{
            finalValidatedInvoices = new List<blng__Invoice__c>();
            finalValidatedInvoices.addAll(finalMap.get(jobCount-1));
        //Throw exception and create 'QTB_Exception_Log__c' record by using Platform Event
        }catch(Exception e) {
            QTB_ExceptionLogger.enable(); //Gitlab US#24744
            QTB_ExceptionLogger.createLog(e.getLineNumber(), e.getStackTraceString(), e.getMessage(), e.getTypeName(), 'QTB_GenerateMassTextFileBatch.Constructor');
        }
    }
    /*global Iterable<sObject> start(Database.BatchableContext bc){ 
        system.debug('##########@@@@@@'+finalValidatedInvoices);
        return finalValidatedInvoices;
    }*/
    global void execute(QueueableContext qc) {
        system.debug('@@invoiceList'+finalValidatedInvoices.size());
        if(!finalValidatedInvoices.isEmpty()){
            try{
                for(blng__Invoice__c invoice : finalValidatedInvoices){
                    invIds.add(invoice.id);
                }
                if(Test.isRunningTest()){
                   processedCount = invIds.size(); 
                   jobCount = 1;
                   totalJobCountFinal = 1;
                }
                //Call generateTxt() method to generate text file at a single time
                if(invIds.size() > 0 ){
                    QTB_GenerateMassExtractCTRL.generateTxt(invSchID,invIds,invZipId,invStatus,fileVersionName,invBatchNumber);
                    processedCount = invIds.size();
                }
                ///
                //Check the count and proceed
                if(processedCount > 0){
                    //Send Email for the confirmation
                    //THis email only send for the last batch only 
                    if(jobCount == totalJobCountFinal){
                        //If posted then only update all the Invoice's QTB_Last_Invoice_Sent__c 
                        if(invStatus == 'Posted'){
                            List<blng__Invoice__c> invLstUpdate = new List<blng__Invoice__c>();
                            for(id invId : allInvList){
                                blng__Invoice__c inv = new blng__Invoice__c();
                                inv.id = invId;
                                inv.QTB_Last_Invoice_Sent__c = datetime.now();
                                invLstUpdate.add(inv);
                            }
                            if(invLstUpdate.size() > 0){
                                update invLstUpdate;
                            }
                        }
                        Messaging.SingleEmailMessage mail = new Messaging.SingleEmailMessage();
                        List<String> ToAddresses = new List<String>();
                        string emailIds = UserInfo.getUserEmail();
                        ToAddresses.add(emailIds);       
                        mail.setToAddresses(ToAddresses);
                        mail.setSubject('Mass APIX Extract Status in Org : '+UserInfo.getOrganizationId());
                        String body = 'Dear User' + ', <br/><br/>';
                        body += 'Mass Apix extract for <b>'+invSchName+'</b> is successfully generated for total :<b>'+totalInvoice+'</b> invoices <br/>';
                        if(skipBigInvoiceMap.size() > 0){
                            body += 'The following Invoices were skiped due to the high volume of usages. Please generate the Text file from the individual Invoices.<br/><br/>';
                            string baseURL = URL.getOrgDomainUrl().toExternalForm();
                            for(string recId : skipBigInvoiceMap.keySet()){
                                body += '<b>'+skipBigInvoiceMap.get(recId)+ '</b> : '+baseURL+'/'+recId+'<br/>';
                            }
                        }
                        
                        body += '<br/><br/>'+'Thanks & Regards,<br/> Admin.';
                        system.debug('Email Body:'+body);
                        mail.setHtmlBody(body);
                        Messaging.sendEmail(new Messaging.SingleEmailMessage[] { mail });
                    }
                }
                // Chain this job to next job by submitting the next job
                if(jobCount < totalJobCountFinal && !Test.IsRunningTest()){
                    ID jobID = System.enqueueJob(new QTB_GenerateMassTextFileBatch(finalMap,invSchID,invSchName,invZipId,invStatus,'_'+string.valueOf(jobCount+1)+'_'+finalMap.size(), skipBigInvoiceMap , totalInvoice,allInvList, jobCount, totalJobCountFinal));
                }               
            }
            catch(Exception e) {
                ++exceptionCount;
                //Throw exception and create 'QTB_Exception_Log__c' record by using Platform Event
                QTB_ExceptionLogger.enable();//Gitlab US#24744
                QTB_ExceptionLogger.createLog(e.getLineNumber(), e.getStackTraceString(), e.getMessage(), e.getTypeName(), 'QTB_GenerateMassTextFileBatch.execute');
            }
        }
    }
	
