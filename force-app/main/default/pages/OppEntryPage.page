<script>
        function calcEmptyAmt(sprice)
        {
            var priceId = sprice.id;
            var idTemp = priceId.slice(0,-5);
            var amtId=idTemp.concat("amt");
            var recurId=idTemp.concat("recur");
            var p = document.getElementById(priceId).value;
            var recurring = document.getElementById(recurId).value;

            if(recurring=='Recurring')
                {
                 document.getElementById(amtId).value=p*12;
                }
            else if (recurring =='Non-recurring')
                {
                 document.getElementById(amtId).value=p;
                }
            
        }
    </script>
    <script language="javascript" type="text/javascript"> 
        function getQueryVariable(variable) {
          var query = window.location.search.substring(1);
          var vars = query.split("&");
          for (var i=0;i<vars.length;i++) {
            var pair = vars[i].split("=");
            if (pair[0] == variable) {
              return pair[1];
            }
          } 
        
        }
             
        function openWindow(hiddenAccountElementId, textAccountNumberId)
        {
            var opId = "{!Opportunity.Id}";
            var accId;
            if (!document.getElementById("{!$Component.frm.pb.pbs.oppAccId}_lkid")) {
                accId = getQueryVariable("straccname");
            }
            else
            accId = document.getElementById("{!$Component.frm.pb.pbs.oppAccId}_lkid").value;
            if(/^0*$/.test(accId))
                accId = '';   
            var scrWidth = screen.width - 100;
            var scrHeight = screen.height - 100;
            if(accId)
                window.open("/apex/FilteredAccountLookup?hiddenId="+hiddenAccountElementId+"&opId="+opId+"&accId="+accId+"&textId="+textAccountNumberId, '', 'fullscreen=yes, scrollbars=1, height='+ scrHeight +', width='+scrWidth);
            else
                window.open("/apex/FilteredAccountLookup?hiddenId="+hiddenAccountElementId+"&opId="+opId+"&textId="+textAccountNumberId, '', 'fullscreen=yes, scrollbars=1, height='+ scrHeight +', width='+scrWidth);
         }
        function calcAmt(qty)
        {
            var qtyId = qty.id;
            var idTemp = qtyId.slice(0,-3);
            var priceId = idTemp.concat("price");
            var amtId=idTemp.concat("amt");
            var recurId=idTemp.concat("recur");
            var p = document.getElementById(priceId).value;
            var q = document.getElementById(qtyId).value;
            var recurring = document.getElementById(recurId).value;
            if(recurring=='Recurring')
                {
                 document.getElementById(amtId).value=p*q*12;
                }
            else if (recurring =='Non-recurring')
                {
                 document.getElementById(amtId).value=p*q;
                }
        
        }


function GetVenUnVenIds(){
    var x = document.getElementsByClassName("labelCol vfLabelColTextWrap");    
    var i;
    var item,PickLst,OppVen,OppVenID,OppUnVen,OppUnVenID,PickListID,tempVen;
    var ids;
    
    for (i = 0; i < x.length; i++) {
        item = x[i].innerHTML; 
        OppVen = item.search("% Vended"); 
        OppUnVen = item.search("% Unvended"); 
        PickLst = item.search("Competitively Vended"); 
        if(OppVen >= 0){            
            tempVen =item.replace("<label for=\"","");
            OppVenID = tempVen.replace("\">% Vended</label>","");
            console.log(OppVenID);    
            }
        if(OppUnVen >= 0){            
            tempVen =item.replace("<label for=\"","");
            OppUnVenID = tempVen.replace("\">% Unvended</label>","");
            console.log(OppUnVenID);    
            } 
        if(PickLst >=0){
            tempVen =item.replace("<label for=\"","");
             PickListID = tempVen.replace("\">Competitively Vended</label>","");
            //  PickListID = tempVen.replace("\"><span class=\"assistiveText\">*</span>Competitively Vended</label>","");
            console.log(PickListID);  
        }
    }
    
    ids = OppVenID +',,' +OppUnVenID + ',,' +PickListID;
    return ids;
}

function onVendedChange(vendedVal){
    
    var OppVenID,OppUnVenID;
    var ids;
    ids = GetVenUnVenIds();
    OppVenID = ids.split(",,")[0];
    OppUnVenID = ids.split(",,")[1];
    var venField = document.getElementById(OppVenID); //document.getElementById('j_id0:frm:j_id396:j_id397:OppVen');
    var UnvenField = document.getElementById(OppUnVenID);
   
    venField.value = '';
    UnvenField.value = '';
    venField.disabled = false;
    UnvenField.disabled = false;
    
    if(vendedVal.value== 'Vended'){
            venField.value = 100;
            UnvenField.value = 0;
            venField.disabled = true;
            UnvenField.disabled = true;
      }
     
     if(vendedVal.value== 'Unvended'){
            venField.value = 0;
            UnvenField.value = 100;
            venField.disabled = true;
            UnvenField.disabled = true;
      }
    }

function onLoadVended(){
    
    var OppVenID,OppUnVenID,PickListID;
    var ids;
    ids = GetVenUnVenIds();
    // console.log('IDs:'+ids);
    OppVenID = ids.split(",,")[0];
    OppUnVenID = ids.split(",,")[1];
    PickListID = ids.split(",,")[2];
    var PickList = document.getElementById(PickListID);
    var venField = document.getElementById(OppVenID); //document.getElementById('j_id0:frm:j_id396:j_id397:OppVen');
    var UnvenField = document.getElementById(OppUnVenID);
   
    
    // console.log('Competitively Vended:'+PickListID.value);
    if((PickList.value== 'Vended') ||(PickList.value== 'Unvended') ){
        venField.disabled = true;
        UnvenField.disabled = true;
    }
    else{
         venField.disabled = false;
        UnvenField.disabled = false;
    }
    
    
}

