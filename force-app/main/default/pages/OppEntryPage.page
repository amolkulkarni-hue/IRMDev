                if(i == 0 && x[i].value == 'Yes'){
                    c = 0;
                }else if(i == 0 && x[i].value == 'No')
                    c = 1;
                else if(c == 0 ){
                    x[i].value = 'No';
                    x[i].disabled = true;
                    x[i].style.background ="#ddd";
                    x[i].style.color = "gray";
                }else{
                    x[i].disabled = false;
                    x[i].style.removeProperty("background");
