<apex:page standardController="Opportunity" extensions="OppEntryClass" action="{!autorun}">
    
    <apex:form id="frm">
        <apex:outputPanel id="hiddenblock">
        <apex:pagemessages />
    </apex:outputPanel>
        <apex:actionStatus id="searchStatus" stopText="">
                <apex:facet name="start">
                <div>
                    <div class="popupBackground" />
                    <div class="PopupPanel">
                        <table border="0" width="100%" height="100%">
                            <tr>
                                <td align="center"><b>Please Wait</b></td>
                            </tr>
                           <tr>
                                <td align="center"><img src="{!$Resource.Transparent_Loading_GIF}"/></td>
                          </tr> 
                        </table>
                    </div>
                </div>
            </apex:facet>
         </apex:actionStatus>
        <apex:sectionHeader title="Opportunity Edit"
            subtitle="New Opportunity" rendered="{!oppdetails}" />
        <apex:sectionHeader title="Opportunity Edit"
            subtitle="New Opportunity" rendered="{!roleselectblock}" />
        <apex:sectionHeader title="Primary Contact" subtitle="Contact Roles"
            rendered="{!contactdisplay}" />
        <apex:sectionHeader title="Primary Contact" subtitle="Contact Role"
            rendered="{!conroleselectblock}" />
        <apex:sectionHeader title="Primary Contact" subtitle="New Contact"
            rendered="{!newcontactdisplay}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Other Description" rendered="{!otherinformationdisplay}" />
        <apex:sectionHeader title="Product Selection" subtitle="Product Class"
            rendered="{!highleveldisplay}" />
        <apex:sectionHeader title="Product Selection" subtitle="Product Line"
            rendered="{!granularleveldisplay}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Primary Products" rendered="{!pricebookdisplay}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Primary Products" rendered="{!addprods}" />
        <apex:sectionHeader title="Product Selection" subtitle="Product Line"
            rendered="{!addprodline}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Solution Selection" rendered="{!bundlequestiondisplay}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Solution Selection" rendered="{!bundlelistdisplay}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Bundle Products" rendered="{!bundleproductlistdisplay}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Secondary Product Selection"
            rendered="{!secproselectdisplay}" />
        <apex:sectionHeader title="Product Selection"
            subtitle="Secondary Products" rendered="{!secprodisplay}" />
        <apex:sectionHeader subtitle="GSA & Product Questions"
            rendered="{!questiondisplay}" />
        <apex:sectionHeader subtitle="Price and Quantity Values"
            rendered="{!addproductsdisplay}" />
        <apex:sectionHeader subtitle="Competitively Vended" rendered="{!FinalDispBackVended}" />
        <apex:sectionHeader subtitle="Competitively Vended" rendered="{!FinalDispBackLeadVended}" />
        <!--<apex:sectionHeader title="Provided Information" rendered="{!finaldetailsdiplay}"/>-->

        <apex:pageblock title="Opportunity Edit" rendered="{!oppdetails}"
            mode="edit" id="pb">
            <apex:pageblockButtons >
                <apex:commandButton action="{!saveOpp}" value="NEXT"
                    rendered="{!oppnextdisplay}" reRender="frm" status="searchStatus" />
                <apex:commandButton value="CANCEL" action="{!cancel}"
                    rendered="{!oppcanceldisplay}" reRender="frm" status="searchStatus" />
                <apex:commandButton value="SAVE" action="{!oppsavebutton}"
                    rendered="{!oppsavedisplay}" reRender="frm" status="searchStatus" />
            </apex:pageblockButtons>
            <apex:pageblockSection title="Opportunity Information" collapsible="false" id="pbs">
                <apex:pageblockSectionItem >
                    <apex:outputLabel >Opportunity Owner</apex:outputLabel>
                    <apex:outputLabel value="{!oppowner}" />
                </apex:pageblockSectionItem>
                <apex:inputField value="{!opportunity.StageName}" required="true"
                    onchange="probablity()" styleClass="stageFld"/>
                <apex:inputField value="{!opportunity.Name}" required="true" />
                <apex:inputField value="{!opportunity.CampaignId}"  />
                <apex:inputField value="{!opportunity.Probability}"  styleClass="ProbabilityFld"/>
                <apex:inputField value="{!opportunity.AccountId}" required="true" id="oppAccId" onchange="gposet()">
                </apex:inputField>
              <!--  <apex:inputField value="{!opportunity.IM_Competitor__c}" /> -->
                <apex:inputField value="{!opportunity.IM_Category__c}" />
                <apex:inputField value="{!opportunity.Type}" required="true" /><br></br>
                <apex:inputField value="{!opportunity.Primary_Product_Line__c}" required="true" /><br></br>
                <apex:inputField value="{!opportunity.IM_Sales_Event__c}" />
                <apex:inputField value="{!opportunity.Group_Purchasing_Organization_GPO__c}" id="gpo" />
                <!-- <apex:inputField value="{!opportunity.Account_Plan__c}"  />  -->
            </apex:pageblockSection>
            <apex:pageblockSection title="Forecast Detail" collapsible="false">
                <apex:inputField value="{!opportunity.IM_Booked_Date__c}"
                    required="true" />
                <apex:inputField value="{!opportunity.CloseDate}" required="true" />
            </apex:pageblockSection>
            <apex:pageblockSection collapsible="false"
                title="Description Information">
                <apex:inputField value="{!opportunity.Description}" />
            </apex:pageblockSection>
            <apex:pageblockSection title="Up-Sell Information"
                collapsible="false">
                <apex:inputField value="{!opportunity.IM_Up_Sell_Quantity__c}" />
         <!--   <apex:inputField value="{!opportunity.IM_Up_Sell_Sold_To__c}" /> 
         
                <apex:inputField value="{!opportunity.Upsell_Customer_ID__c}" /> -->
                <apex:pageBlockSectionItem id="accountLookupInput">
                <apex:outputText >{!$ObjectType.Opportunity.fields.Upsell_Customer_ID__c.label}</apex:outputText>
                <apex:outputPanel > 
                     <apex:panelGrid columns="3" id="theGrid">
                        <apex:inputText id="accountNumber">{!Opportunity.Upsell_Customer_ID__r.Name}</apex:inputText>
                        <span id="filteredLookup" onclick="openWindow('{!$Component.IdHiddenInput}','{!$Component.accountNumber}')" ></span>
                    </apex:panelGrid> 
                    <apex:inputHidden value="{!opportunity.Upsell_Customer_ID__c}" id="IdHiddenInput"/> 
                 </apex:outputPanel>
                 </apex:pageBlockSectionItem>                
                <apex:inputField value="{!opportunity.IM_Up_Sell_Detail__c}" />
                <apex:inputField value="{!opportunity.IM_Unit_of_Measure__c }" />
            </apex:pageblockSection>
            <!-- pratap, Added rendered=false -->
            <apex:pageblockSection title="Competitively Vended"
                collapsible="false" rendered="false">
                <apex:inputField label="Competitively Vended" value="{!opportunity.IME_Vended_Unvended__c}" />
                <apex:outputLabel ></apex:outputLabel>
                <!-- #16915 <apex:inputField label="% Vended" value="{!opportunity.Vended__c}" /> -->
               <!-- <apex:outputLabel ></apex:outputLabel> -->
               <!-- #16915 <apex:inputField label="% Unvended" value="{!opportunity.Unvended__c}" /> -->

            </apex:pageblockSection> 
            <!--
             <apex:pageBlockSection title="Opportunity Competitor" >
                    <apex:inputField id="first" value="{!oppcomp.Competitor__c}" required="false"/>
                    <apex:inputField id="second" value="{!oppcomp.Expiration_Notification_Date__c}" />
                    <apex:inputField id="Third" value="{!oppcomp.Competitor_Expiration_Date__c}" />
            </apex:pageBlockSection>   --> 
        </apex:pageblock>
        
        
        <style>
.HeaderStyle {
    background-color: black;}
    
    #filteredLookup {
    margin: 0;
    padding: 0;
    text-align: right;
    background: url('/img/func_icons/util/lookup20.gif') no-repeat transparent;
    background-size: 45px 20px;
    background-position: 0px -1px;
    cursor: pointer;
    height: 18px;
    width: 20px;
    float: right;
}
</style>
        <apex:pageBlock title="Contact Role" rendered="{!conroleselectblock}" id="LeadRole">
            <apex:pageBlockSection rendered="{!conrolerror}">
                <apex:outputLabel >
                    <p style="font-family: verdana; color: red;">Error: Please
                        select a role.</p>
                </apex:outputLabel>
            </apex:pageBlockSection>
            <apex:pageblockButtons >
                <apex:commandButton value="NEXT" action="{!conleadnext}" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="BACK" action="{!conleadback}" reRender="frm" status="searchStatus"/>
            </apex:pageblockButtons>
            <apex:pageblockTable value="{!leadcontacts}" var="a">
                <apex:column headerValue="Contact">
                    <apex:outputLabel >{!leadname}</apex:outputLabel>
                </apex:column>
                <apex:column headerValue="Title">
                </apex:column>
                <apex:column headerValue="Contact Role">
                    <apex:inputfield value="{!ocr.Role}" />
                </apex:column>
            </apex:pageblockTable>
        </apex:pageBlock>

        <apex:pageblock title="Opportunity Edit" rendered="{!roleselectblock}"
            mode="edit" id="LeadRoleblock">
            <apex:pageblockButtons >
                <apex:commandButton value="NEXT" action="{!leadoppnext}"
                    rendered="{!leadoppnextdisplay}" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="BACK" action="{!backtolead}"
                  rendered="{!conleadbackdisplay}" immediate="true" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="SAVE" action="{!leadoppsave}"
                    rendered="{!leadoppsavedisplay}" reRender="frm" status="searchStatus"/>
            </apex:pageblockButtons>
            <apex:pageblockSection title="Opportunity Information"
                collapsible="false">
                <apex:pageblockSectionItem >
                    <apex:outputLabel >Opportunity Owner</apex:outputLabel>
                    <apex:outputLabel value="{!oppowner}" />
                </apex:pageblockSectionItem>
                <apex:inputField value="{!leadopportunity.StageName}"
                    required="true" onchange="probablity()" styleClass="stageFld"  id="leadStageName"  />
                <apex:outputField value="{!leadopportunity.Name}" />
                <apex:inputField value="{!leadopportunity.Probability}" styleClass="ProbabilityFld"/>
                <apex:pageBlockSectionItem >
                    <apex:outputText >Account Name</apex:outputText>
                    <apex:outputLabel >{!leadaccountname}</apex:outputLabel>
                </apex:pageBlockSectionItem>
               <!-- <apex:inputField value="{!leadopportunity.IM_Competitor__c}" /> -->
                <apex:inputField value="{!leadopportunity.IM_Category__c}" />
                <apex:inputField value="{!leadopportunity.Type}" required="true" /><br></br>
                <apex:inputField value="{!leadopportunity.Primary_Product_Line__c}" required="true" /><br></br>
                <apex:inputField value="{!leadopportunity.IM_Sales_Event__c}" />
                <apex:inputField value="{!leadopportunity.Group_Purchasing_Organization_GPO__c}"  />   
                <!-- <apex:inputField value="{!leadopportunity.Account_Plan__c}"  />   -->
                <apex:inputField value="{!leadopportunity.InSight_Opportunities__c}"  /> 
            </apex:pageblockSection>
            <apex:pageblockSection title="Forecast Detail" collapsible="false">
                <apex:inputField value="{!leadopportunity.IM_Booked_Date__c}"
                    required="true" />
                <apex:inputField value="{!leadopportunity.CloseDate}"
                    required="true" />
            </apex:pageblockSection>
            <apex:pageblockSection collapsible="false"
                title="Description Information">
                <apex:inputField value="{!leadopportunity.Description}" />
            </apex:pageblockSection>
            <apex:pageblockSection title="Up-Sell Information"
                collapsible="false">
                <apex:inputField value="{!leadopportunity.IM_Up_Sell_Quantity__c}" />
<!--                <apex:inputField value="{!leadopportunity.Upsell_Customer_ID__c}"/> -->
                <apex:pageBlockSectionItem id="accountLookupInput">
                <apex:outputText >{!$ObjectType.Opportunity.fields.Upsell_Customer_ID__c.label}</apex:outputText>
                <apex:outputPanel > 
                     <apex:panelGrid columns="3" id="theGrid">
                        <apex:inputText id="accountNumber">{!Opportunity.Upsell_Customer_ID__r.Name}</apex:inputText>
                        <span id="filteredLookup" onclick="openWindow('{!$Component.IdHiddenInput}','{!$Component.accountNumber}')" ></span>
                    </apex:panelGrid> 
                    <apex:inputHidden value="{!leadopportunity.Upsell_Customer_ID__c}" id="IdHiddenInput"/> 
                 </apex:outputPanel>
                 </apex:pageBlockSectionItem>
                <apex:inputField value="{!leadopportunity.IM_Up_Sell_Detail__c}" />
                <apex:inputField value="{!leadopportunity.IM_Unit_of_Measure__c }" />
            </apex:pageblockSection>
          
            <apex:pageblockSection title="Competitively Vended"
                collapsible="false" rendered="false">
                <apex:inputField label="Competitively Vended" value="{!sObjLead.Competitively_Vended__c}" />
                <apex:outputLabel ></apex:outputLabel>
              <!-- #16915 <apex:inputField label="% Vended" value="{!sObjLead.Vended__c}"  />
                <apex:outputLabel ></apex:outputLabel>
                <apex:inputField label="% Unvended" value="{!sObjLead.Unvended__c}"  /> -->

            </apex:pageblockSection>    
         
        </apex:pageblock>
        
         
     <!--------------------- New screen for competitor ------------->  
     
     <!---  Developer: Sandhya Ramesh
            Case     : 03474925
            -->    
        <apex:pageBlock title="Opportunity Competitor" rendered="{!oppcompblock}">
        <apex:pageBlockSection columns="1" >
      <!--  <div style="background-color: white; color: blue; box-sizing: border-box; padding: 5px; border: 1px solid blue;">  -->
            <div style="box-shadow: 3px 3px 3px 1px grey; height: 75px; width:1250px; align:center; padding: 5px; box-sizing: border-box;">
                <div style="text-align: center; font-size: 130%;  padding: 5px;">
                Your opportunity is competitively vended. Please consider adding an Opportunity Competitor at this time.
                </div>
            
                <div style="text-align: center; font-size: 120%; padding: 5px;"> 
                Hit SKIP to proceed if unknown or to add at a later time. 
                </div>
          </div>  
          </apex:pageBlockSection>
 <!--           <apex:pageBlockTable value="{!oppcompetitors}" var="x">
                <apex:column headerValue="Col1">
                    <apex:outputLabel >XX</apex:outputLabel>
                </apex:column>
                <apex:column headerValue="Col2">
                </apex:column>
                <apex:column headerValue="Exp date">
                    <apex:inputfield value="{!oc.Competitor_Expiration_Date__c }" />
                </apex:column>
            </apex:pageBlockTable> -->
            <apex:pageBlockSection title="Information">
                <apex:inputField value="{!oc.Competitor__c }"/>
                <apex:inputField value="{!oc.Competitor_Expiration_Date__c }"/>
                <apex:outputLabel value=""></apex:outputLabel>
                <apex:inputField value="{!oc.Expiration_Notification_Date__c}"/>
            </apex:pageBlockSection>
            <apex:pageblockSection title="Competitive Pricing">
                <apex:inputField value="{!oc.Unknown_Pricing__c}"/>
                <apex:outputLabel value=""></apex:outputLabel>
                <apex:inputField value="{!oc.Storage_Price_per_Unit__c}"/>
                <apex:inputField value="{!oc.Retrieval_File__c}"/>
                <apex:inputField value="{!oc.Minimum_Storage_Charge__c}"/>
                <apex:inputField value="{!oc.Retrieval_Box__c}"/>
                <apex:inputField value="{!oc.Admin_Fee__c }"/>
                <apex:inputField value="{!oc.Handling_Charge__c}"/>
                <apex:inputField value="{!oc.Permanent_Withdrawal__c}"/>
                <apex:inputField value="{!oc.Rush_Transport__c}"/>
            </apex:pageblockSection>  
            <apex:pageBlockSection columns="1">
            <p>
            <div style="text-align: center; font-size: 120%; padding: 20px; box-shadow: 0px 0px 0.05px 1px grey; height: 20px;"> 
                Competitive pricing should be considered a target price our customers indicate as a price to meet or beat, we should 
                not accept confidential documents that identify competitor pricing.
            </div>    
            </p>
            </apex:pageBlockSection> 
            <apex:pageBlockButtons >
                <apex:commandButton value="NEXT" action="{!oppcompnext}" rendered="{!leadoppnextconbutton}" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="NEXT" action="{!oppcompsaverole}" rendered="{!oppnextconbutton}" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="SKIP" action="{!leadcompskip}" rendered="{!leadskipbutton}" immediate="true" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="SKIP" action="{!compskip}" rendered="{!skipbutton}" immediate="true" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="BACK" action="{!leadoppcompback}" immediate="true" rendered="{!leadoppbackbutton}" reRender="frm" status="searchStatus"/>
                <apex:commandButton value="BACK" action="{!oppcompback}" immediate="true" rendered="{!oppbackbutton}" reRender="frm" status="searchStatus"/>
            </apex:pageBlockButtons>    
        </apex:pageBlock>
  
        
        <!-- 
            Added Page Block for Contact Search 
             Case Number: 01654528  
        -->        
        <apex:pageBlock title="Search Contact" rendered="{!contactdisplay}">
                  <!-- 
                  <apex:pageMessage title="Special characters are not allowed in the search criteria, please refine the search criteria without these characters and search again." severity="warning" strength="3" rendered="{!ContactSearchErrorDisplay}"/>
                  <apex:pageMessages /> 
                  -->
                  <p>Please enter any one of the following First Name, Last Name or Email of the contact you would like to search for.</p><br></br>
                  <apex:inputText value="{!ContactSearchString}"/> 
                  <apex:CommandButton action="{!doSearchOncontactRole}" Value="Find Contact" reRender="frm" status="searchStatus"/>
                  <apex:CommandButton action="{!ClearSearchOnContactRole}" Value="Clear Search" reRender="frm" status="searchStatus"/>
        </apex:pageBlock>
    
        <apex:pageBlock title="Contact Roles for {!opportunity.Name}"
            rendered="{!contactdisplay}" mode="Edit">
            <apex:pageblockButtons >
                <apex:commandButton action="{!savePrimarycontact}" value="NEXT"
                    rendered="{!consavedisplay}" styleClass="nextBtn" reRender="frm" status="searchStatus"/>
                <apex:commandButton action="{!cancelprimarycontact}" value="BACK"
                    rendered="{!conbackdisplay}" reRender="frm" status="searchStatus"/>    
                    
                <apex:commandButton action="{!primarycontactnotfound}"
                    value="NOT FOUND" rendered="{!conbackdisplay}" reRender="frm" status="searchStatus" />
                <apex:commandButton action="{!oldconsavebutton}" value="SAVE"
                    rendered="{!conchangedisplay}" reRender="frm" status="searchStatus" />
            </apex:pageblockButtons>
            
            <apex:pageBlockSection rendered="{!location}">
                <apex:outputLabel >
                    <p style="font-family: verdana; color: red;">Error: Please
                        select a primary contact and its role.</p>
                </apex:outputLabel>
            </apex:pageBlockSection>
            <apex:pageblockTable value="{!primarycontacts}" var="a"
                headerClass="HeaderStyle">
                <apex:column headerValue="Primary" style="header color=black">
                    <apex:facet name="header">
                    </apex:facet>
                    <apex:inputCheckbox value="{!a.selected}" id="checkedone">
                        <apex:actionSupport event="onclick" action="{!GetSelected}"
                            onsubmit="deselectOther(this)" reRender="Accounts"
                            status="testing" />
                        <apex:actionstatus id="testing" startText="selecting.." onstart="hideNextBtn();" onstop="showNextBtn();"/>
                    </apex:inputCheckbox>
                </apex:column>
                <apex:column headerValue="Contact" value="{!a.acc.Name}" />
                <apex:column headerValue="Account" value="{!a.acc.AccountId}" />
                <apex:column headerValue="Title" value="{!a.acc.Title}" />
                <apex:column headerValue="Email" value="{!a.acc.Email}" />
                <apex:column headerValue="Role">
                    <apex:inputField value="{!a.oppcont.Role}" />
                </apex:column>
            </apex:pageblockTable>
        </apex:pageBlock>


        <apex:pageBlock rendered="{!newcontactdisplay}"
            title="PLEASE PROVIDE A NEW PRIMARY CONTACT" mode="Edit">
            <apex:pageBlockButtons >
                <apex:commandButton action="{!newcontactsave}" value="SAVE"
                    rendered="{!consavedisplay}" reRender="frm" status="searchStatus"/>
                <apex:commandButton action="{!newcontactback}" value="BACK"
                     rendered="{!conbackdisplay}" immediate="true"/>
                <apex:commandButton value="SAVE" action="{!consavebutton}"
                    rendered="{!conchangedisplay}" reRender="frm" status="searchStatus"/>
            </apex:pageBlockButtons>
            <apex:pageBlockSection rendered="{!contacterror}" collapsible="false">
                <apex:outputLabel >
                    <p style="font-family: verdana; color: red;">Error: Please
                        provide a Contact Role.</p>
                </apex:outputLabel>
            </apex:pageBlockSection>
            <apex:pageBlockSection title=" Contact Information" columns="2"
                collapsible="false">
                <apex:inputField value="{!contact.FirstName}" />
                <apex:inputField value="{!contact.LastName}" />
                <apex:inputField value="{!contact.IM_Functional_Area__c}" />
                <apex:inputField value="{!contact.IM_Job_Level__c}" />
                <apex:inputField value="{!contact.IM_Academic_Title__c}" />
                <!--<apex:inputField value="{!contact.IM_Role__c}" />-->
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Opportunity Contact Role</apex:outputLabel>
                    <apex:inputfield value="{!ocr.Role}" />
                </apex:pageBlockSectionItem>
                <apex:inputField value="{!contact.Title}" />
                <apex:inputField value="{!contact.Email}" required="true" />
                <apex:inputField value="{!contact.IM_Language_Preference__c}" />
                <apex:inputField value="{!contact.IM_Responsible_For__c}" />
                <apex:inputField value="{!contact.Phone}" required="true" />
                <apex:inputField value="{!contact.MobilePhone}" />
                <apex:inputField value="{!contact.Fax}" />
                <apex:inputField value="{!contact.IM_Timezone__c}" />
            </apex:pageBlockSection>
        </apex:pageBlock>


        <apex:pageBlock rendered="{!bundlequestiondisplay}">
            <apex:pageblockButtons location="bottom">
                <apex:commandButton value="NEXT" action="{!bundleYes}" reRender="frm" status="searchStatus"/>
                <!--<apex:commandButton value="NO" action="{!bundleno}"/>-->
                <apex:commandButton value="BACK" action="{!bundleback}" reRender="frm" status="searchStatus"/>
            </apex:pageblockButtons>
            <apex:outputLabel rendered="{!bundlemsg}">
                <p style="font-family: verdana; color: red;">Error: Please
                    provide at least one solution type.</p>
            </apex:outputLabel>
            <apex:outputLabel style="font-size:12px">
                <b>Please select the solution
                    type:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b>
            </apex:outputLabel>
            <apex:selectList value="{!selectedbundletype}" size="1" id="CommonBundle">
                <apex:selectOptions value="{!bundletypelist}" />
            </apex:selectList>
        </apex:pageBlock>

        <apex:pageBlock rendered="{!bundlelistdisplay}">
            <apex:outputLabel rendered="{!emptybundles}">
                <p style="font-family: verdana; color: red;">There are no
                    Bundles available for selection for {!selectedbundletype} Bundle
                    Type. Please select "BACK" to select another Bundle Type</p>
            </apex:outputLabel>
            <apex:outputLabel style="font-size:12px"
                rendered="{!NOT(emptybundles)}">
                <b>Please select the {!selectedbundletype} Application
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b>
            </apex:outputLabel>
            <apex:pageBlockButtons >
                <apex:commandButton action="{!nextbundle}" value="NEXT"
                    rendered="{!NOT(emptybundles)}" reRender="frm" status="searchStatus"/>
                <apex:commandButton action="{!cancelbundle}" value="BACK" reRender="frm" status="searchStatus"/>
            </apex:pageBlockButtons>
            <apex:selectList value="{!selectedbundle}" size="1"
                rendered="{!NOT(emptybundles)}">
                <apex:selectOptions value="{!bundleslist}" />
            </apex:selectList>
        </apex:pageBlock>

        <apex:pageBlock rendered="{!otherinformationdisplay}">
            <apex:outputLabel rendered="{!othererror}">
                <p style="font-family: verdana; color: red;">Error: Please enter
                    a description.</p>
            </apex:outputLabel>
            <apex:outputLabel style="font-size:12px">
                <b>Please enter a description for
                    'Other'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b>
            </apex:outputLabel>
            <apex:pageblockButtons >
                <apex:commandButton action="{!otherinformationnext}" value="NEXT" reRender="frm" status="searchStatus"/>
                <apex:commandButton action="{!otherinformationback}" value="BACK" reRender="frm" status="searchStatus"/>
            </apex:pageblockButtons>
            <apex:inputtext value="{!otherinformation}" />
        </apex:pageBlock>

        <apex:pageBlock rendered="{!highleveldisplay}">
            <apex:outputLabel style="font-size:12px">
                <b>Please select a Product
                    Class&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b>
            </apex:outputLabel>
            <apex:pageblockButtons >
