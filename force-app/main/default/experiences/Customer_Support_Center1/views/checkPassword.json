      "componentAttributes" : {
        "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">Check Your Email</h5>\n<p style=\"text-align:center;\">We’ve sent you an email with a link to finish\nresetting your password. Can’t find the email? Try checking your spam\nfolder.<br><br>\nIf you still can’t log in, have us <a\nhref=\"https://customersupport.ironmountain.com/s/login/ForgotPassword\">resend the email</a> or contact your Salesforce\nadministrator.</p>"
