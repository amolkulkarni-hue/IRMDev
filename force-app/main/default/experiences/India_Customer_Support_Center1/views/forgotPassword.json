    }, {
      "componentAttributes" : {
        "richTextValue" : "<p style=\"text-align:center;\">To reset your password, we'll need your username.\nWe'll send password reset instructions to the email address associated with your account.</p>"
      },
      "componentName" : "forceCommunity:htmlBlock",
      "id" : "841a4e02-95bd-431e-b350-f50a41cd615c",
