  "id" : "5904c251-7701-43e2-9c2c-b10a67c5508e",
  "label" : "Check Password",
  "regions" : [ {
    "components" : [ {
      "componentAttributes" : {
        "richTextValue" : "<div class=\"logoPlaceholderForLogin\" style=\"padding: 10px 0px 10px 0px;\"><a href=\"/irmapac/s\" style=\"text-decoration: none;\">\n    <div><img src=\"/sfsites/c/resource/CSC_LoginLogo\" style=\"width: 80%; display: block; margin-left: auto; margin-right: auto;\"></div>\n</a></div>"
      },
      "componentName" : "forceCommunity:htmlBlock",
      "id" : "fd58f24c-1806-4525-bb59-89045b1526d6",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : { },
      "type" : "component"
    }, {
      "componentAttributes" : {
        "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">Check Your Email</h5>\n<p style=\"text-align:center;\">We’ve sent you an email with a link to finish\nresetting your password. Can’t find the email? Try checking your spam\nfolder.<br><br>\nIf you still can’t log in, have us <a\nhref=\"/irmapac/s/login/ForgotPassword\">resend the email</a> or contact your Salesforce\nadministrator.</p>"
      },
      "componentName" : "forceCommunity:htmlBlock",
      "id" : "1ab158de-9d37-4f32-99a3-b6bab364a8b7",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : {
        "in" : "ae6c7b98-54c1-4746-b385-6c79ff7bc62c",
        "ko" : "72642358-ec7c-4831-b393-df29b6230427",
        "th" : "7b0ea8fb-6ceb-42a4-9a20-7ccb0fd11425",
        "zh_tw" : "f892d2f8-3055-4f53-95c7-18b878ffbdd5"
      },
      "renditions" : [ {
        "id" : "ae6c7b98-54c1-4746-b385-6c79ff7bc62c",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">Periksa Email Anda</h5>\n<p style=\"text-align:center;\">Kami telah mengirimkan email berisi tautan untuk menyelesaikan pengaturan ulang kata sandi Anda. Tidak dapat menemukan email tersebut? Coba periksa folder spam Anda.<br><br>\nJika Anda masih tidak dapat masuk, minta kami <a\nhref=\"/irmapac/s/login/ForgotPassword\">mengirimkan ulang email</a> tersebut atau hubungi administrator Salesforce Anda.</p>"
          }
        },
        "type" : "renditionComponent"
      }, {
        "id" : "7b0ea8fb-6ceb-42a4-9a20-7ccb0fd11425",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">กรุณาตรวจสอบอีเมลลของคุณ</h5>\n<p style=\"text-align:center;\">เราได้ส่งอีเมลลพร้อมลิงค์สำหรับรีเซ็ตรหัสผ่านไปให้แล้ว หากไม่พบอีเมลล กรุณาตรวจสอบในโฟลเดอร์ \"จดหมายขยะ\"<br><br>\nหากไม่สามารถเข้าสู่ระบบได้ คุณสามารถขอให้เร <a\nhref=\"/irmapac/s/login/ForgotPassword\">าส่งอีเมลลอีกครั้ง</a> หรือ ติดต่อผู้ดูแลระบบ Salesforce ของคุณ</p>"
          }
        },
        "type" : "renditionComponent"
      }, {
        "id" : "f892d2f8-3055-4f53-95c7-18b878ffbdd5",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">請檢查您的電子郵件</h5>\n<p style=\"text-align:center;\">我們已向您發送一封電子郵件，其中包含完成密碼重設的連結。找不到郵件嗎？請嘗試檢查您的垃圾郵件資料夾。<br><br>\n如果您仍然無法登入，請讓我們<a\nhref=\"/irmapac/s/login/ForgotPassword\">重新發送電子郵件</a> 或聯絡您的 Salesforce 管理員。</p>"
          }
        },
        "type" : "renditionComponent"
      }, {
        "id" : "72642358-ec7c-4831-b393-df29b6230427",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">이메일을 확인하세요.</h5>\n<p style=\"text-align:center;\">비밀번호 재설정 링크를 이메일로 보내드렸습니다. 이메일을 찾을 수 없나요? 스팸 폴더를 확인해 보세요.<br><br>\n그래도 로그인할 수 없는 경우, <a\nhref=\"/irmapac/s/login/ForgotPassword\">이메일 재발송을 요청하시거나</a> Salesforce 관리자에게 문의하세요.</p>"
          }
        },
        "type" : "renditionComponent"
      } ],
      "type" : "component"
    } ],
