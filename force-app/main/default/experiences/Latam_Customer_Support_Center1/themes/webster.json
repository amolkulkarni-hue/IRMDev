  "customCSS" : "/* To hideField label from Article Detail Page*/\n\n/* To hide TITLE / URL / QUESTION from Article Detail Page*/\n.selfServiceArticleLayout .test-id__section:nth-child(1) {display: none;}\n.selfServiceArticleLayout .test-id__section:nth-child(2) {display: none;}\n.selfServiceArticleLayout .test-id__section:nth-child(4) {display: none;}\n\n\n/*.slds-has-dividers_right>.slds-list__item, .slds-has-dividers--right>.slds-list__item, .slds-has-dividers_right>.slds-item, .slds-has-dividers--right>.slds-item, .forcePageBlockSectionRow ~ .forcePageBlockSectionRow div{\n         align-items: center;\n       display: inline;\n    position:relative;\n}*/\n.slds-has-dividers_right>.slds-list__item:after, .slds-has-dividers--right>.slds-list__item:after, .slds-has-dividers_right>.slds-item:after, .slds-has-dividers--right>.slds-item:after , .forcePageBlockSectionRow ~ .forcePageBlockSectionRow div{\n  \n  margin-left: 0;\n  margin-right: 0;\n  }\n\n\n\n.slds-tile__detail slds-text-body--small slds-var-p-bottom_xxx-small {display: none;}\n\n\n.forceCommunitySearch .uiAbstractList .listContent {\n    font-size: 16px !important;\n}\n\n.siteforceThemeLayoutStarter {\n    position: relative;\n}\n\n.sidebarHeader .minimizedContainer .helpButton .embeddedServiceSidebarMinimizedDefaultUI{\nbackground-color: #1b75bc ;\nborder-color: #1b75bc;\n}\n\n.forceCommunityContactSupportForm .slds-page-header__title {    \n    margin-bottom : 30px;    \n}\n\n/* to hide the Profile and Login button*/\n.themeProfileMenu {\n    display : none !important;\n}\n\n/*To hide the Search icon on the Topics Page*/\n.forceCommunityThemeSearchSection{\n     display : none\n}\n\n/* make the body take the full width of the view port to fix the footer at bottom */\n.body {\n    min-height: calc(100vh - 200px);\n}",
