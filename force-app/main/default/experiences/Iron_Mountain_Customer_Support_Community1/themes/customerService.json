  "customCSS" : "/* To hide TITLE and URL from Article Detail Page*/\n.selfServiceArticleLayout .test-id__section:nth-child(1) {display: none;}\n.selfServiceArticleLayout .test-id__section:nth-child(2) {display: none;}\n.selfServiceArticleLayout .test-id__section:nth-child(4) {display: none;}\n.selfServiceArticleLayout .test-id__section:nth-child(5) {display: none;}\n\n/* To hide Post/Poll chatter*/\n.userProfileTabs{  \n    display:none;\n}\n/*To hide the list view actions in the mobile mode in the community*/\n.forceCommunityActionButtonMobile {\n\tdisplay:none;\n}\n/*To Make Search Button text White*/\n.forceCommunitySearchBox .search-button {\n    width: 128px;\n    height: 100%;\n    color: white;\n}\n/* To make user name in white - User profile menu*/\n.siteforceServiceBody .cProfileCon .trigger-link .profileName {\n    text-decoration: inherit;\n    color: white;\n}\n/* To hide the filter text under list view*/\n.countSortedByFilteredBy{\n    display:none;\n}\n\n/*To make login pag - login button label white*/\n.salesforceIdentityLoginForm2 .uiButton{\n\tcolor:white !important;\n}\n\n.uiOutputText, .forcePageBlockSectionRow ~ .forcePageBlockSectionRow div{\n   display:none;\n}\n.slds-has-dividers_right>.slds-list__item, .slds-has-dividers--right>.slds-list__item, .slds-has-dividers_right>.slds-item, .slds-has-dividers--right>.slds-item, .forcePageBlockSectionRow ~ .forcePageBlockSectionRow div{\n\talign-items: center;\n\tdisplay: inline;\n\tposition:relative;\n}\n.slds-has-dividers_right>.slds-list__item:after, .slds-has-dividers--right>.slds-list__item:after, .slds-has-dividers_right>.slds-item:after, .slds-has-dividers--right>.slds-item:after , .forcePageBlockSectionRow ~ .forcePageBlockSectionRow div{\n  margin-left: 0;\n  margin-right: 0;\n}",
