      "type" : "component"
    }, {
      "componentAttributes" : {
        "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">Check Your Email</h5>\n<p style=\"text-align:center;\">We’ve sent you an email with a link to finish\nresetting your password. Can’t find the email? Try checking your spam\nfolder.<br><br>\nIf you still can’t log in, have us <a\nhref=\"/irmesa/s/login/ForgotPassword\">resend the email</a> or contact your Salesforce\nadministrator.</p>"
      },
      "componentName" : "forceCommunity:htmlBlock",
      "id" : "a5ae3382-9e65-485d-b548-49cf34e41faa",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : {
        "de" : "8535ef46-aada-46fb-8eec-0ebc0b7c596a",
        "es" : "1e644eb2-d90f-47c2-9240-e94282c6ca9a",
        "fr" : "06f00f11-5993-42dd-9b37-6c5019f77202"
      },
      "renditions" : [ {
        "id" : "06f00f11-5993-42dd-9b37-6c5019f77202",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">Vérifiez votre courrier électronique</h5>\n<p style=\"text-align:center;\">Nous vous avons envoyé un e-mail avec un lien pour terminer\nréinitialiser votre mot de passe. Vous ne trouvez pas l'e-mail ? Essayez de vérifier vos spams\ndossier.<br><br>\nSi vous ne parvenez toujours pas à vous connecter, demandez-nous <a\nhref=\"/irmesa/s/login/ForgotPassword\">renvoyer l'e-mail</a> ou contactez votre Salesforce\nadministrateur.</p>"
          }
        },
        "type" : "renditionComponent"
      }, {
        "id" : "8535ef46-aada-46fb-8eec-0ebc0b7c596a",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">Überprüfen Sie Ihre E-Mail</h5>\n<p style=\"text-align:center;\">Wir haben Ihnen eine E-Mail mit einem Link zum Fertigstellen gesendet\nZurücksetzen Ihres Passworts. Können Sie die E-Mail nicht finden? Versuchen Sie, Ihren Spam zu überprüfen\nOrdner.<br><br>\nWenn Sie sich immer noch nicht anmelden können, wenden Sie sich an uns <a\nhref=\"/irmesa/s/login/ForgotPassword\">Senden Sie die E-Mail erneut</a> oder kontaktieren Sie Ihren Salesforce\nAdministrator.</p>"
          }
        },
        "type" : "renditionComponent"
      }, {
        "id" : "1e644eb2-d90f-47c2-9240-e94282c6ca9a",
        "renditionValue" : {
          "componentAttributes" : {
            "richTextValue" : "<h5 style=\"color:#58595B; text-align: center; font-family: 'Interstate';\nfont-size: 18px; font-style: normal; font-weight: 400; line-height:\nnormal;\">Revisa tu correo electrónico</h5>\n<p style=\"text-align:center;\">Te hemos enviado un correo electrónico con un enlace para finalizar.\nrestablecer su contraseña. ¿No encuentras el correo electrónico? Prueba a revisar tu spam\ncarpeta.<br><br>\nSi aún no puedes iniciar sesión, contáctanos <a\nhref=\"/irmesa/s/login/ForgotPassword\">reenviar el correo electrónico</a> o contacta a tu Salesforce\nadministrador.</p>"
          }
        },
