            "renditionValue" : {
              "componentAttributes" : {
                "richTextValue" : "<p style=\"text-align:center; font-family: Interstate; font-weight: regular; color:#58595B;\">Zum Zurücksetzen Ihres Passworts benötigen wir Ihren Benutzernamen. Wir senden Anweisungen zum Zurücksetzen des Passworts an die mit Ihrem Konto verknüpfte E-Mail-Adresse.</p>"
