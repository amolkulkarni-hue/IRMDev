          }, {
            "id" : "a0c6aed8-6cb0-4f62-83c3-df298dd6766d",
            "renditionValue" : {
              "componentAttributes" : {
                "richTextValue" : "<p style=\"text-align:center; font-family: Interstate; font-weight: regular; color:#58595B;\">Para restablecer su contraseña, necesitaremos su nombre de usuario. Le enviaremos instrucciones para restablecer la contraseña a la dirección de correo electrónico asociada a su cuenta.</p>"
              }
            },
