  }, {
    "components" : [ {
      "componentAttributes" : {
        "richTextValue" : "<h2>News &amp; Events</h2><p><a href=\"/s/news-events\" target=\"_self\">View All</a></p>"
      },
      "componentName" : "forceCommunity:richTextInline",
      "id" : "d443cd19-f86f-4990-a12c-7068e61b44cf",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : { },
      "type" : "component"
    }, {
      "componentAttributes" : {
        "news_events_date" : "OCTOBER 21, 2020",
        "news_events_desc" : "STOCKHOLM--(BUSINESS WIRE)-- Telia Carrier and Iron Mountain Data Centers, a division of Iron Mountain Incorporated (NYSE: IRM), the storage and information management services company enabling digital transformation, announced today an expanded data center partnership with new IP Transit Services in Manassas, VA, Pittsburgh, PA, Edison, NJ and Phoenix, AZ in the US; and London, Amsterdam and Singapore internationally. The partnership provides Iron Mountain’s data center customers new options for high performance diverse connectivity in the US to global hubs in APAC and EMEA.",
        "news_events_link" : "https://www.ironmountain.com/about-us/news-events/news-categories/press-releases/2020/october/iron-mountain-data-centers-and-telia-carrier-expand-partnership-to-extend-global-connectivity",
        "news_events_title" : "IRON MOUNTAIN DATA CENTERS AND TELIA CARRIER EXPAND PARTNERSHIP TO EXTEND GLOBAL CONNECTIVITY"
      },
      "componentName" : "c:PRM_Community_News_Events",
      "id" : "10d4b859-98c4-48fc-8b7d-3be6f79cf103",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : { },
      "type" : "component"
    }, {
      "componentAttributes" : {
        "news_events_date" : "OCTOBER 6, 2020",
        "news_events_desc" : "BOSTON--(BUSINESS WIRE)-- Iron Mountain Incorporated (NYSE: IRM), the storage and information management services company, today announced the formation of a 300 million+ Euro joint venture (the “Venture”) with an affiliate of AGC Equity Partners (\"AGC\"), a London-based global alternative asset manager to design and develop a 280,000 square foot, or 27 megawatt, hyperscale data center currently under development in Frankfurt, Germany (the “Frankfurt Data Center”).",
        "news_events_link" : "https://www.ironmountain.com/about-us/news-events/news-categories/press-releases/2020/october/iron-mountain-and-agc-equity-partners-announce-formation-of-300-million-euro-joint-venture-to-develop-and-manage-frankfurt-data-center",
        "news_events_title" : "IRON MOUNTAIN AND AGC EQUITY PARTNERS ANNOUNCE FORMATION OF 300 MILLION+ EURO JOINT VENTURE TO DEVELOP AND MANAGE FRANKFURT DATA CENTER"
      },
      "componentName" : "c:PRM_Community_News_Events",
      "id" : "7d33a182-3e8c-48d9-962d-675165863b32",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : { },
      "type" : "component"
    }, {
      "componentAttributes" : {
        "news_events_date" : "SEPTEMBER 15, 2020",
        "news_events_desc" : "TORONTO--(BUSINESS WIRE)-- Iron Mountain Incorporated (NYSE: IRM), a global leader in storage and information management services, and FutureVault, an industry leader in enterprise digital vault solutions, today announced a strategic partnership and the launch of their Digitization-as-a-Service offering with Aligned Capital Partners Inc. as the first client.",
        "news_events_link" : "https://www.businesswire.com/news/home/20200915006078/en/",
        "news_events_title" : "IRON MOUNTAIN AND FUTUREVAULT LAUNCH TRANSFORMATIONAL DIGITAL VAULT PLATFORM"
      },
      "componentName" : "c:PRM_Community_News_Events",
      "id" : "000df7dd-2d8f-44e7-91c1-4dc05f08ff7d",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : { },
      "type" : "component"
    }, {
      "componentAttributes" : {
        "news_events_date" : "SEPTEMBER 1, 2020",
        "news_events_desc" : "BOSTON--(BUSINESS WIRE)-- Iron Mountain Incorporated (NYSE: IRM), the storage and information management services company, today announced that a large U.S. Federal government civilian agency that is at the forefront of the nation's technological progress and achievement, is expanding its existing footprint to Iron Mountain data centers in Manassas, Virginia and Denver, Colorado. Iron Mountain is providing a colocation data center solution in support of the agency’s IT transformation initiatives.",
        "news_events_link" : "https://www.ironmountain.com/about-us/news-events/news-categories/press-releases/2020/september/u-s-federal-agency-expands-with-iron-mountain-with-five-megawatts-across-multiple-data-center-sites",
        "news_events_title" : "U.S. FEDERAL AGENCY EXPANDS WITH IRON MOUNTAIN WITH FIVE MEGAWATTS ACROSS MULTIPLE DATA CENTER SITES"
      },
      "componentName" : "c:PRM_Community_News_Events",
      "id" : "a44b7941-3857-46f0-85fa-e24e22673358",
      "renderPriority" : "NEUTRAL",
      "renditionMap" : { },
      "type" : "component"
    }, {
      "componentAttributes" : {
        "news_events_date" : "JUNE 22, 2020",
        "news_events_desc" : "Company Deepens Partnership with Google; Introduces the First Artificial Intelligence and Machine Learning Powered Content Services Platform with Full Visual User Interface on Google Cloud Marketplace BOSTON, June 22, 2020 /PRNewswire/ -- Iron Mountain Incorporated (NYSE: IRM), the storage and information management services company enabling digital transformation, today announced its Iron Mountain InSight artificial intelligence (AI) and machine learning (ML) content services platform is now available on the Google Cloud Marketplace. As the first AI and ML powered content services platform accessible to Google Cloud's millions of customers with a full visual user interface (UI) and compatibility with the majority of asset types, Iron Mountain InSight enables customers to easily ingest a wide array of structured and unstructured assets, from documents and spreadsheets to videos and images, and automatically classify, extract and enrich value from them.",
        "news_events_link" : "https://www.ironmountain.com/about-us/news-events/news-categories/press-releases/2020/june/iron-mountain-insight-launches-on-google-cloud-marketplace",
        "news_events_title" : "IRON MOUNTAIN INSIGHT® LAUNCHES ON GOOGLE CLOUD MARKETPLACE"
      },
      "componentName" : "c:PRM_Community_News_Events",
      "id" : "00f5b9b1-30a5-45b8-a5bc-5fea1d7f4157",
      "renderPriority" : "NEUTRAL",
