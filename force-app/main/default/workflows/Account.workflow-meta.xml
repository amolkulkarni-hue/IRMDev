    <rules>
        <fullName>AccountStatusUpdateRule1</fullName>
        <actions>
            <name>AccountTypeCustomer</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Account.CustomerAcctCounter__c</field>
            <operation>greaterOrEqual</operation>
            <value>1</value>
        </criteriaItems>
        <description>Account Status Update Rule 1 for Customer</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>AccountStatusUpdateRule2</fullName>
        <actions>
            <name>AccountTypeProspect</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <booleanFilter>1 AND 2 AND 3</booleanFilter>
        <criteriaItems>
            <field>Account.CustomerAcctCounter__c</field>
            <operation>lessOrEqual</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.OpportunityCounter__c</field>
            <operation>greaterOrEqual</operation>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.Type</field>
            <operation>notEqual</operation>
            <value>Recall Active Customer</value>
        </criteriaItems>
        <description>Account Status Update Rule 2 for Prospect</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
